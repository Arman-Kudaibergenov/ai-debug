
#Область ПрограммныйИнтерфейс

Функция ОбработкаЗапросаHealth(Запрос) Экспорт
	Возврат ОбработатьHealthCheck(Запрос);
КонецФункции

Функция ОбработкаЗапросаTools(Запрос) Экспорт
	Возврат ОбработатьToolsЗапрос(Запрос);
КонецФункции

Функция ОбработкаЗапросаResources(Запрос) Экспорт
	Возврат ОбработатьResourcesЗапрос(Запрос);
КонецФункции

Функция ОбработкаЗапросаSupport(Запрос) Экспорт
	Возврат ОбработатьSupportЗапрос(Запрос);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбработатьHealthCheck(Запрос)

	Статус = Новый Структура;
	Статус.Вставить("status", "healthy");
	Статус.Вставить("version", "1.3.1");
	Статус.Вставить("timestamp", ТекущаяУниверсальнаяДатаВМиллисекундах());

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(Статус), "UTF-8");
	Возврат Ответ;

КонецФункции

Функция ОбработатьToolsЗапрос(Запрос)

	Метод = Запрос.HTTPМетод;

	Если Метод = "GET" Тогда
		Возврат ВернутьСписокИнструментов();
	ИначеЕсли Метод = "POST" Тогда
		Возврат ВыполнитьИнструмент(Запрос);
	Иначе
		Возврат ВернутьОшибку405();
	КонецЕсли;

КонецФункции

Функция ОбработатьResourcesЗапрос(Запрос)

	Если Запрос.HTTPМетод <> "GET" Тогда
		Возврат ВернутьОшибку405();
	КонецЕсли;

	Если Запрос.ПараметрыURL.Получить("action") = "read" Тогда
		Возврат ПрочитатьРесурс(Запрос);
	Иначе
		Возврат ВернутьСписокРесурсов();
	КонецЕсли;

КонецФункции

Функция ВернутьСписокИнструментов()

	Попытка
		Результат = Новый Структура;
		Результат.Вставить("tools", AI_Core.ПолучитьСписокИнструментов());
		КодОтвета = 200;
	Исключение
		ОшибкаИнфо = ИнформацияОбОшибке();
		ДетальОшибки = ОшибкаИнфо.Описание
			+ " (" + ОшибкаИнфо.ИмяМодуля + ":" + Формат(ОшибкаИнфо.НомерСтроки, "ЧГ=0") + ")";
		Результат = Новый Структура;
		Результат.Вставить("error", ОшибкаИнфо.Описание);
		Результат.Вставить("detail", ДетальОшибки);
		КодОтвета = 500;
	КонецПопытки;

	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(Результат), "UTF-8");
	Возврат Ответ;

КонецФункции

Функция ВыполнитьИнструмент(Запрос)

	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат ВернутьОшибку400("Некорректный JSON в теле запроса");
	КонецПопытки;

	Если НЕ ДанныеЗапроса.Свойство("name") Тогда
		Возврат ВернутьОшибку400("Отсутствует обязательное поле 'name'");
	КонецЕсли;

	ИмяИнструмента = ДанныеЗапроса.name;
	Параметры = Новый Структура;
	Если ДанныеЗапроса.Свойство("arguments") Тогда
		Параметры = ДанныеЗапроса.arguments;
	КонецЕсли;

	Результат = AI_Core.ВыполнитьИнструмент(ИмяИнструмента, Параметры);

	КодОтвета = 200;
	Если Результат.Свойство("isError") И Результат.isError = Истина Тогда
		КодОтвета = 500;
	КонецЕсли;

	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(Результат), "UTF-8");
	Возврат Ответ;

КонецФункции

Функция ВернутьСписокРесурсов()

	Результат = Новый Структура;
	Результат.Вставить("resources", AI_Core.ПолучитьСписокРесурсов());

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(Результат), "UTF-8");
	Возврат Ответ;

КонецФункции

Функция ПрочитатьРесурс(Запрос)

	URI = Запрос.ПараметрыЗапроса.Получить("uri");
	Результат = AI_Core.ПрочитатьРесурс(URI);

	КодОтвета = ?(Результат.Свойство("isError") И Результат.isError = Истина, 404, 200);

	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(Результат), "UTF-8");
	Возврат Ответ;

КонецФункции

Функция ВернутьОшибку404()
	Ошибка = Новый Структура("error,message", "Not Found", "Endpoint not found");
	Ответ = Новый HTTPСервисОтвет(404);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(Ошибка), "UTF-8");
	Возврат Ответ;
КонецФункции

Функция ВернутьОшибку400(Сообщение)
	Ошибка = Новый Структура("error,message", "Bad Request", Сообщение);
	Ответ = Новый HTTPСервисОтвет(400);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(Ошибка), "UTF-8");
	Возврат Ответ;
КонецФункции

Функция ВернутьОшибку405()
	Ошибка = Новый Структура("error,message", "Method Not Allowed", "HTTP method not allowed");
	Ответ = Новый HTTPСервисОтвет(405);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(Ошибка), "UTF-8");
	Возврат Ответ;
КонецФункции

Функция ОбработатьSupportЗапрос(Запрос)

	Действие = Запрос.ПараметрыURL.Получить("action");
	Метод = Запрос.HTTPМетод;

	Попытка
		Если Метод = "GET" И Действие = "pending" Тогда
			Результат = Новый Структура;
			Результат.Вставить("tickets", AI_Support.ОжидающиеОбращения());
			Возврат ВернутьJSON(Результат, 200);

		ИначеЕсли Метод = "GET" И Действие = "ticket" Тогда
			Идентификатор = Запрос.ПараметрыЗапроса.Получить("id");
			Если Идентификатор = Неопределено Тогда
				Возврат ВернутьОшибку400("Отсутствует обязательный параметр 'id'");
			КонецЕсли;
			ДанныеОбращения = AI_Support.ПолучитьОбращение(Идентификатор);
			Если ДанныеОбращения = Неопределено Тогда
				Возврат ВернутьОшибку404();
			КонецЕсли;
			Возврат ВернутьJSON(ДанныеОбращения, 200);

		ИначеЕсли Метод = "GET" И Действие = "attachment" Тогда
			Идентификатор = Запрос.ПараметрыЗапроса.Получить("id");
			ИндексСтрокой = Запрос.ПараметрыЗапроса.Получить("index");
			Если Идентификатор = Неопределено ИЛИ ИндексСтрокой = Неопределено Тогда
				Возврат ВернутьОшибку400("Отсутствуют обязательные параметры 'id' и 'index'");
			КонецЕсли;
			Вложение = AI_Support.ПолучитьВложение(Идентификатор, Число(ИндексСтрокой));
			Если Вложение = Неопределено Тогда
				Возврат ВернутьОшибку404();
			КонецЕсли;
			Ответ = Новый HTTPСервисОтвет(200);
			Ответ.Заголовки.Вставить("Content-Type", Вложение.mime);
			Ответ.Заголовки.Вставить("Content-Disposition",
				"attachment; filename*=UTF-8''" + Вложение.name);
			Ответ.УстановитьТелоИзДвоичныхДанных(Вложение.data);
			Возврат Ответ;

		ИначеЕсли Метод = "POST" И Действие = "create" Тогда
			ДанныеЗапроса = ПрочитатьТелоJSON(Запрос);
			Если ДанныеЗапроса = Неопределено Тогда
				Возврат ВернутьОшибку400("Некорректный JSON в теле запроса");
			КонецЕсли;

			Тема = "";
			ТекстСообщения = "";
			СтрокаСсылки = "";
			Если ДанныеЗапроса.Свойство("subject") Тогда
				Тема = ДанныеЗапроса.subject;
			КонецЕсли;
			Если ДанныеЗапроса.Свойство("text") Тогда
				ТекстСообщения = ДанныеЗапроса.text;
			КонецЕсли;
			Если ДанныеЗапроса.Свойство("contextLink") Тогда
				СтрокаСсылки = ДанныеЗапроса.contextLink;
			КонецЕсли;

			Идентификатор = AI_Support.СоздатьОбращение(Тема, ТекстСообщения,
				AI_Support.КонтекстИзСсылки(СтрокаСсылки));
			Результат = Новый Структура;
			Результат.Вставить("id", Идентификатор);
			Возврат ВернутьJSON(Результат, 200);

		ИначеЕсли Метод = "POST" И Действие = "reply" Тогда
			ДанныеЗапроса = ПрочитатьТелоJSON(Запрос);
			Если ДанныеЗапроса = Неопределено Тогда
				Возврат ВернутьОшибку400("Некорректный JSON в теле запроса");
			КонецЕсли;
			Если НЕ ДанныеЗапроса.Свойство("id") ИЛИ НЕ ДанныеЗапроса.Свойство("text") Тогда
				Возврат ВернутьОшибку400("Отсутствуют обязательные поля 'id' и 'text'");
			КонецЕсли;

			AI_Support.ЗаписатьОтвет(ДанныеЗапроса.id, ДанныеЗапроса.text);
			Результат = Новый Структура;
			Результат.Вставить("ok", Истина);
			Результат.Вставить("status", "Отвечено");
			Возврат ВернутьJSON(Результат, 200);

		ИначеЕсли Метод <> "GET" И Метод <> "POST" Тогда
			Возврат ВернутьОшибку405();
		Иначе
			Возврат ВернутьОшибку404();
		КонецЕсли;
	Исключение
		ОшибкаИнфо = ИнформацияОбОшибке();
		Результат = Новый Структура;
		Результат.Вставить("error", ОшибкаИнфо.Описание);
		Результат.Вставить("detail", ПодробноеПредставлениеОшибки(ОшибкаИнфо));
		Возврат ВернутьJSON(Результат, 500);
	КонецПопытки;

КонецФункции

Функция ПрочитатьТелоJSON(Запрос)

	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат ДанныеЗапроса;

КонецФункции

Функция ВернутьJSON(Данные, КодОтвета)

	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(Данные), "UTF-8");
	Возврат Ответ;

КонецФункции

Функция СериализоватьJSON(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

#КонецОбласти
