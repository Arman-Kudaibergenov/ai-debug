
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("КонтекстСсылка") И ЗначениеЗаполнено(Параметры.КонтекстСсылка) Тогда
		СсылкаНаОбъект = ПолучитьНавигационнуюСсылку(Параметры.КонтекстСсылка);
		Тема = "Проблема: " + Строка(Параметры.КонтекстСсылка);
	КонецЕсли;

	Если ПустаяСтрока(Тема) Тогда
		Тема = "Обращение от " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
	КонецЕсли;

	HTMLВложения = СтраницаВложений();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("ОпроситьОтветы", 15);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)

	Если ПустаяСтрока(СокрЛП(ТекстСообщения)) Тогда
		Возврат;
	КонецЕсли;

	ОтправитьНаСервере();
	ТекстСообщения = "";

КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайл(Команда)

	НачатьПомещениеФайла(
		Новый ОписаниеОповещения("ПрикрепитьФайлЗавершение", ЭтотОбъект),
		, , Истина);

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьИсторию();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОтправитьНаСервере()

	Если ПустаяСтрока(ОбращениеИд) Тогда
		ОбращениеИд = AI_Support.СоздатьОбращение(Тема, ТекстСообщения,
			AI_Support.КонтекстИзСсылки(СсылкаНаОбъект));
	Иначе
		AI_Support.ДобавитьСообщение(ОбращениеИд, "user", ТекстСообщения);
	КонецЕсли;

	ОбновитьИсторию();

КонецПроцедуры

&НаКлиенте
Процедура ОпроситьОтветы()

	Если ПустаяСтрока(ОбращениеИд) Тогда
		Возврат;
	КонецЕсли;

	ОбновитьИсторию();

КонецПроцедуры

&НаСервере
Процедура ОбновитьИсторию()

	Если ПустаяСтрока(ОбращениеИд) Тогда
		Возврат;
	КонецЕсли;

	ДанныеОбращения = AI_Support.ПолучитьОбращение(ОбращениеИд);
	Если ДанныеОбращения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИсторияЧат = AI_Support.ИсторияHTML(ДанныеОбращения.messages);

КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайлЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		Возврат;
	КонецЕсли;

	ПрикрепитьФайлНаСервере(Адрес, ВыбранноеИмяФайла);
	ПоказатьОповещениеПользователя("Файл прикреплен: " + ВыбранноеИмяФайла);

КонецПроцедуры

&НаСервере
Процедура ПрикрепитьФайлНаСервере(Адрес, ИмяФайла)

	Если ПустаяСтрока(ОбращениеИд) Тогда
		ОбращениеИд = AI_Support.СоздатьОбращение(Тема, "",
			AI_Support.КонтекстИзСсылки(СсылкаНаОбъект));
	КонецЕсли;

	AI_Support.СохранитьВложение(ОбращениеИд, ИмяФайла, Адрес);

КонецПроцедуры

#КонецОбласти

#Область ВложенияЧерезHTML

&НаКлиенте
Процедура ВложенияПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	АдресСобытия = ДанныеСобытия.Href;
	Если АдресСобытия = Неопределено ИЛИ СтрНайти(АдресСобытия, "ai://att") = 0 Тогда
		Возврат;
	КонецЕсли;

	ПараметрыСобытия = РазобратьПараметрыСсылки(АдресСобытия);
	КомандаСобытия = ПараметрыСобытия["cmd"];

	Если КомандаСобытия = "start" Тогда
		ВложениеБуфер = "";
		ВложениеИмя = ПараметрыСобытия["name"];
		ВложениеТип = СтрЗаменить(ПараметрыСобытия["mime"], "%2F", "/");
	ИначеЕсли КомандаСобытия = "chunk" Тогда
		ВложениеБуфер = ВложениеБуфер + ПараметрыСобытия["data"];
	ИначеЕсли КомандаСобытия = "done" Тогда
		СохранитьВложениеИзФормы();
	ИначеЕсли КомандаСобытия = "link" Тогда
		СсылкаНаОбъект = ПараметрыСобытия["data"];
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция РазобратьПараметрыСсылки(АдресСобытия)

	Результат = Новый Соответствие;
	ПозицияВопроса = СтрНайти(АдресСобытия, "?");
	Если ПозицияВопроса = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Части = СтрРазделить(Сред(АдресСобытия, ПозицияВопроса + 1), "&");
	Для Каждого Часть Из Части Цикл
		ПозицияРавно = СтрНайти(Часть, "=");
		Если ПозицияРавно > 0 Тогда
			Результат.Вставить(Лев(Часть, ПозицияРавно - 1), Сред(Часть, ПозицияРавно + 1));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура СохранитьВложениеИзФормы()

	Если ПустаяСтрока(ВложениеБуфер) Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ОбращениеИд) Тогда
		ОбращениеИд = AI_Support.СоздатьОбращение(Тема, "",
			AI_Support.КонтекстИзСсылки(СсылкаНаОбъект));
	КонецЕсли;

	AI_Support.СохранитьВложениеДвоичные(ОбращениеИд, ВложениеИмя, ВложениеТип,
		Base64Значение(ВложениеБуфер));
	ВложениеБуфер = "";

КонецПроцедуры

&НаСервере
Функция СтраницаВложений()

	Возврат
	"<!DOCTYPE html><html><head><meta charset=""utf-8""></head>
	|<body style=""font-family:Segoe UI,Arial,sans-serif;font-size:12px;margin:4px"">
	|<div id=""zone"" style=""border:1px dashed #999;border-radius:6px;padding:8px;text-align:center;color:#666"">
	|Перетащите файл сюда или вставьте скриншот (Ctrl+V)
	|</div>
	|<div style=""margin-top:4px"">
	|<button id=""rec"">Запись голоса</button><span id=""st"" style=""margin-left:6px;color:#666""></span>
	|</div>
	|<script>
	|var CHUNK=6000;
	|function sendAll(name,mime,b64){
	|  var total=Math.ceil(b64.length/CHUNK);
	|  fire('cmd=start&name='+encodeURIComponent(name)+'&mime='+encodeURIComponent(mime)+'&total='+total);
	|  var i=0;
	|  function step(){
	|    if(i>=total){ fire('cmd=done'); return; }
	|    fire('cmd=chunk&i='+i+'&data='+b64.substr(i*CHUNK,CHUNK));
	|    i++; setTimeout(step,25);
	|  }
	|  setTimeout(step,25);
	|}
	|function fire(q){ var a=document.createElement('a'); a.href='ai://att?'+q; document.body.appendChild(a); a.click(); a.remove(); }
	|document.addEventListener('paste',function(e){
	|  var cd=(e.clipboardData||window.clipboardData);
	|  var txt=cd.getData('text');
	|  if(txt && txt.indexOf('e1cib/data')>=0){ sendLink(txt); return; }
	|  var items=cd.items;
	|  for(var i=0;i<items.length;i++){ if(items[i].kind==='file'){ readFile(items[i].getAsFile()); } }
	|});
	|function sendLink(t){ var a=document.createElement('a'); a.href='ai://att?cmd=link&data='+t; document.body.appendChild(a); a.click(); a.remove(); }
	|var zone=document.getElementById('zone');
	|zone.addEventListener('dragover',function(e){e.preventDefault();});
	|zone.addEventListener('drop',function(e){e.preventDefault(); for(var i=0;i<e.dataTransfer.files.length;i++){readFile(e.dataTransfer.files[i]);}});
	|function readFile(f){ var r=new FileReader(); r.onload=function(){ sendAll(f.name||'screenshot.png', f.type||'image/png', r.result.split(',')[1]); }; r.readAsDataURL(f); }
	|var rec=null,chunks=[];
	|var btn=document.getElementById('rec'),st=document.getElementById('st');
	|btn.onclick=function(){
	|  if(rec && rec.state==='recording'){ rec.stop(); return; }
	|  navigator.mediaDevices.getUserMedia({audio:true}).then(function(s){
	|    chunks=[]; rec=new MediaRecorder(s);
	|    rec.ondataavailable=function(e){chunks.push(e.data);};
	|    rec.onstop=function(){
	|      s.getTracks().forEach(function(t){t.stop();});
	|      var blob=new Blob(chunks,{type:'audio/webm'});
	|      var r=new FileReader();
	|      r.onload=function(){ sendAll('voice.webm','audio/webm', r.result.split(',')[1]); };
	|      r.readAsDataURL(blob);
	|      btn.textContent='Запись голоса'; st.textContent='';
	|    };
	|    rec.start(); btn.textContent='Остановить запись'; st.textContent='идёт запись...';
	|  }).catch(function(){ st.textContent='нет доступа к микрофону'; });
	|};
	|</script></body></html>";

КонецФункции

#КонецОбласти
