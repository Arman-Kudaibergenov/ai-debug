// AI_Utils — shared helper functions for all AI_Debug domain modules

Функция ФорматироватьЗначение(Значение) Экспорт
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy HH:mm:ss");
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

Функция ПолучитьМассив(Знач Элемент1, Знач Элемент2 = Неопределено, Знач Элемент3 = Неопределено) Экспорт
	Массив = Новый Массив;
	Массив.Добавить(Элемент1);
	Если Элемент2 <> Неопределено Тогда
		Массив.Добавить(Элемент2);
	КонецЕсли;
	Если Элемент3 <> Неопределено Тогда
		Массив.Добавить(Элемент3);
	КонецЕсли;
	Возврат Массив;
КонецФункции

Функция КонвертироватьЗначение(ОписаниеТипов, Значение) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение; // Число, Булево уже правильного типа
	КонецЕсли;

	// Fallback: MCParqa string formats
	Если СтрНачинаетсяС(Значение, "Перечисление.") Тогда
		РезультатПеречисления = ПреобразоватьСтрокуВПеречислениеЕслиВозможно(Значение);
		Если РезультатПеречисления <> Неопределено Тогда
			Возврат РезультатПеречисления;
		КонецЕсли;
	КонецЕсли;

	Если СтрНайти(Значение, ":") > 0 И СтрНайти(Значение, ".") > 0 И СтрНайти(Значение, ".") < СтрНайти(Значение, ":") Тогда
		РезультатСсылки = ПреобразоватьСтрокуВСсылкуЕслиВозможно(Значение);
		Если РезультатСсылки <> Неопределено Тогда
			Возврат РезультатСсылки;
		КонецЕсли;
	КонецЕсли;

	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() = 0 Тогда
		Возврат Значение;
	КонецЕсли;

	ПервыйТип = Типы[0];

	Если ПервыйТип = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ПервыйТип = Тип("Число") Тогда
		Возврат Число(Значение);
	ИначеЕсли ПервыйТип = Тип("Дата") Тогда
		Попытка
			Возврат Дата(Значение);
		Исключение
			Возврат '00010101';
		КонецПопытки;
	ИначеЕсли ПервыйТип = Тип("Булево") Тогда
		ВерхРег = ВРег(Значение);
		Возврат (ВерхРег = "TRUE" ИЛИ ВерхРег = "ДА" ИЛИ ВерхРег = "1" ИЛИ ВерхРег = "ИСТИНА");
	Иначе
		// Составной тип: на поле с несколькими ссылочными типами голый GUID неоднозначен —
		// требуем явный тип ("Справочник.Имя:GUID" и т.п.), он разрешен выше.
		ТиповСсылок = 0;
		Для Каждого ТекТип Из Типы Цикл
			Если ТекТип <> Тип("Строка") И ТекТип <> Тип("Число") И ТекТип <> Тип("Дата") И ТекТип <> Тип("Булево") Тогда
				ТиповСсылок = ТиповСсылок + 1;
			КонецЕсли;
		КонецЦикла;
		Если ТиповСсылок > 1 Тогда
			ВызватьИсключение "Поле составного типа: передай значение как ""Справочник.Имя:GUID"" (или Документ.Имя:GUID, Перечисление.Имя.Значение). Голый GUID недопустим — по нему нельзя однозначно выбрать тип ссылки.";
		КонецЕсли;
		// Ссылочный тип — конвертируем GUID-строку через XMLValue
		Попытка
			Возврат XMLValue(ПервыйТип, Значение);
		Исключение
			Возврат Значение;
		КонецПопытки;
	КонецЕсли;

КонецФункции

Процедура УстановитьРеквизиты(Объект, МетаОбъект, Данные, ОшибкиПолей = Неопределено) Экспорт

	Для Каждого КЗ Из Данные Цикл
		// Запись табличных частей через create/update: ключ совпадает с именем ТЧ —
		// массив = полная замена строк, {match, set} = точечное обновление.
		МетаТабЧасть = МетаОбъект.ТабличныеЧасти.Найти(КЗ.Ключ);
		Если МетаТабЧасть <> Неопределено Тогда
			ЗаполнитьТабличнуюЧасть(Объект, МетаТабЧасть, КЗ.Ключ, КЗ.Значение, ОшибкиПолей);
			Продолжить;
		КонецЕсли;
		МетаРеквизит = МетаОбъект.Реквизиты.Найти(КЗ.Ключ);
		Если МетаРеквизит = Неопределено Тогда
			// Стандартный реквизит (Владелец, Родитель и т.п.). Ссылочные передаются строкой
			// формата "Справочник.Имя:GUID" — резолвим в ссылку; иначе присваиваем напрямую.
			Попытка
				ВозможнаяСсылка = Неопределено;
				Если ТипЗнч(КЗ.Значение) = Тип("Строка") Тогда
					ВозможнаяСсылка = ПреобразоватьСтрокуВСсылкуЕслиВозможно(КЗ.Значение);
				КонецЕсли;
				Если ВозможнаяСсылка <> Неопределено Тогда
					Объект[КЗ.Ключ] = ВозможнаяСсылка;
				Иначе
					Объект[КЗ.Ключ] = КЗ.Значение;
				КонецЕсли;
			Исключение
				// Не глотать ошибку установки поля — накапливать в ОшибкиПолей
				Если ТипЗнч(ОшибкиПолей) = Тип("Массив") Тогда
					ОшибкиПолей.Добавить("Поле '" + КЗ.Ключ + "': " + ОписаниеОшибки());
				КонецЕсли;
			КонецПопытки;
		Иначе
			Попытка
				Объект[КЗ.Ключ] = КонвертироватьЗначение(МетаРеквизит.Тип, КЗ.Значение);
			Исключение
				// Не глотать ошибку установки поля — накапливать в ОшибкиПолей
				Если ТипЗнч(ОшибкиПолей) = Тип("Массив") Тогда
					ОшибкиПолей.Добавить("Поле '" + КЗ.Ключ + "': " + ОписаниеОшибки());
				КонецЕсли;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Запись табличных частей через create/update_catalog_item/create_document.
// Форматы значения для ключа-имени ТЧ в data:
//   Массив структур        - полная замена строк ТЧ;
//   Структура {match, set} - обновить колонки set у строк, совпавших по всем колонкам match
//                            (без match - у всех строк). Неизвестные колонки игнорируются.
//
// Параметры:
//   Объект       - СправочникОбъект, ДокументОбъект - изменяемый объект;
//   МетаТабЧасть - ОбъектМетаданных - табличная часть объекта;
//   ИмяТабЧасти  - Строка - имя табличной части;
//   Значение     - Массив, Структура - описание строк (форматы выше);
//   ОшибкиПолей  - Массив - накапливает "ИмяПоля: причина" ошибок установки (необязательно).
//
Процедура ЗаполнитьТабличнуюЧасть(Объект, МетаТабЧасть, ИмяТабЧасти, Значение, ОшибкиПолей = Неопределено) Экспорт

	ТабЧасть = Объект[ИмяТабЧасти];

	Если ТипЗнч(Значение) = Тип("Массив") Тогда

		ТабЧасть.Очистить();
		Для Каждого ОписаниеСтроки Из Значение Цикл
			Если ТипЗнч(ОписаниеСтроки) = Тип("Структура") Тогда
				ЗаполнитьКолонкиСтрокиТабЧасти(ТабЧасть.Добавить(), МетаТабЧасть, ОписаниеСтроки, ОшибкиПолей);
			КонецЕсли;
		КонецЦикла;

	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("set") Тогда

		Отбор = Неопределено;
		Значение.Свойство("match", Отбор);
		Для Каждого СтрокаТабЧасти Из ТабЧасть Цикл
			Если Отбор <> Неопределено И НЕ СтрокаСоответствуетОтбору(СтрокаТабЧасти, МетаТабЧасть, Отбор) Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьКолонкиСтрокиТабЧасти(СтрокаТабЧасти, МетаТабЧасть, Значение.set, ОшибкиПолей);
		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьКолонкиСтрокиТабЧасти(СтрокаТабЧасти, МетаТабЧасть, ОписаниеКолонок, ОшибкиПолей = Неопределено)

	Для Каждого Колонка Из ОписаниеКолонок Цикл
		МетаКолонка = МетаТабЧасть.Реквизиты.Найти(Колонка.Ключ);
		Если МетаКолонка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			СтрокаТабЧасти[Колонка.Ключ] = КонвертироватьЗначение(МетаКолонка.Тип, Колонка.Значение);
		Исключение
			// Не глотать ошибку установки поля — накапливать в ОшибкиПолей
			Если ТипЗнч(ОшибкиПолей) = Тип("Массив") Тогда
				ОшибкиПолей.Добавить("Поле '" + Колонка.Ключ + "': " + ОписаниеОшибки());
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция СтрокаСоответствуетОтбору(СтрокаТабЧасти, МетаТабЧасть, Отбор)

	Для Каждого Условие Из Отбор Цикл
		МетаКолонка = МетаТабЧасть.Реквизиты.Найти(Условие.Ключ);
		Если МетаКолонка = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		ЗначениеОтбора = КонвертироватьЗначение(МетаКолонка.Тип, Условие.Значение);
		Если СтрокаТабЧасти[Условие.Ключ] <> ЗначениеОтбора
			И Строка(СтрокаТабЧасти[Условие.Ключ]) <> Строка(ЗначениеОтбора) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ПолучитьИмяТипаРегистраДляЗапроса(ТипРегистра) Экспорт

	Если ТипРегистра = "InformationRegisters" Тогда
		Возврат "РегистрСведений";
	ИначеЕсли ТипРегистра = "AccumulationRegisters" Тогда
		Возврат "РегистрНакопления";
	Иначе
		ВызватьИсключение "Неподдерживаемый тип регистра: " + ТипРегистра + ". Используй InformationRegisters или AccumulationRegisters";
	КонецЕсли;

КонецФункции

Функция ПреобразоватьСтрокуВСсылкуЕслиВозможно(Значение) Экспорт

	// Парсить формат "ТипКоллекции.ИмяОбъекта:GUID"
	ПозицияДвоеточия = СтрНайти(Значение, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипСтрока = Лев(Значение, ПозицияДвоеточия - 1);
	ГУИДСтрока = Сред(Значение, ПозицияДвоеточия + 1);

	Если СтрДлина(ГУИДСтрока) <> 36 ИЛИ СтрНайти(ГУИДСтрока, "-") = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастиТипа = СтрРазделить(ТипСтрока, ".");
	Если ЧастиТипа.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипКоллекции = ЧастиТипа[0];
	ИмяОбъекта = ЧастиТипа[1];

	Попытка
		УИД = Новый УникальныйИдентификатор(ГУИДСтрока);
		Если ТипКоллекции = "Справочник" Тогда
			Возврат Справочники[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "Документ" Тогда
			Возврат Документы[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "ПланСчетов" Тогда
			Возврат ПланыСчетов[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "ПланВидовРасчета" Тогда
			Возврат ПланыВидовРасчета[ИмяОбъекта].ПолучитьСсылку(УИД);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ПреобразоватьСтрокуВПеречислениеЕслиВозможно(Значение) Экспорт

	// Парсить формат "Перечисление.ИмяПеречисления.ЗначениеПеречисления"
	Части = СтрРазделить(Значение, ".");
	Если Части.Количество() <> 3 ИЛИ Части[0] <> "Перечисление" Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяПеречисления = Части[1];
	ИмяЗначения = Части[2];

	Попытка
		Возврат Перечисления[ИмяПеречисления][ИмяЗначения];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции
