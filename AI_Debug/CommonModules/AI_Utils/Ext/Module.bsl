// AI_Utils — shared helper functions for all AI_Debug domain modules

Функция ФорматироватьЗначение(Значение) Экспорт
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy HH:mm:ss");
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

Функция ПолучитьМассив(Знач Элемент1, Знач Элемент2 = Неопределено, Знач Элемент3 = Неопределено) Экспорт
	Массив = Новый Массив;
	Массив.Добавить(Элемент1);
	Если Элемент2 <> Неопределено Тогда
		Массив.Добавить(Элемент2);
	КонецЕсли;
	Если Элемент3 <> Неопределено Тогда
		Массив.Добавить(Элемент3);
	КонецЕсли;
	Возврат Массив;
КонецФункции

Функция КонвертироватьЗначение(ОписаниеТипов, Значение) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение; // Число, Булево уже правильного типа
	КонецЕсли;

	// Fallback: MCParqa string formats
	Если СтрНачинаетсяС(Значение, "Перечисление.") Тогда
		РезультатПеречисления = ПреобразоватьСтрокуВПеречислениеЕслиВозможно(Значение);
		Если РезультатПеречисления <> Неопределено Тогда
			Возврат РезультатПеречисления;
		КонецЕсли;
	КонецЕсли;

	Если СтрНайти(Значение, ":") > 0 И СтрНайти(Значение, ".") > 0 И СтрНайти(Значение, ".") < СтрНайти(Значение, ":") Тогда
		РезультатСсылки = ПреобразоватьСтрокуВСсылкуЕслиВозможно(Значение);
		Если РезультатСсылки <> Неопределено Тогда
			Возврат РезультатСсылки;
		КонецЕсли;
	КонецЕсли;

	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() = 0 Тогда
		Возврат Значение;
	КонецЕсли;

	ПервыйТип = Типы[0];

	Если ПервыйТип = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ПервыйТип = Тип("Число") Тогда
		Возврат Число(Значение);
	ИначеЕсли ПервыйТип = Тип("Дата") Тогда
		Попытка
			Возврат Дата(Значение);
		Исключение
			Возврат '00010101';
		КонецПопытки;
	ИначеЕсли ПервыйТип = Тип("Булево") Тогда
		ВерхРег = ВРег(Значение);
		Возврат (ВерхРег = "TRUE" ИЛИ ВерхРег = "ДА" ИЛИ ВерхРег = "1" ИЛИ ВерхРег = "ИСТИНА");
	Иначе
		// Ссылочный тип — конвертируем GUID-строку через XMLValue
		Попытка
			Возврат XMLValue(ПервыйТип, Значение);
		Исключение
			Возврат Значение;
		КонецПопытки;
	КонецЕсли;

КонецФункции

Процедура УстановитьРеквизиты(Объект, МетаОбъект, Данные) Экспорт

	Для Каждого КЗ Из Данные Цикл
		МетаРеквизит = МетаОбъект.Реквизиты.Найти(КЗ.Ключ);
		Если МетаРеквизит = Неопределено Тогда
			// Стандартный реквизит (Владелец, Родитель и т.п.). Ссылочные передаются строкой
			// формата "Справочник.Имя:GUID" — резолвим в ссылку; иначе присваиваем напрямую.
			Попытка
				ВозможнаяСсылка = Неопределено;
				Если ТипЗнч(КЗ.Значение) = Тип("Строка") Тогда
					ВозможнаяСсылка = ПреобразоватьСтрокуВСсылкуЕслиВозможно(КЗ.Значение);
				КонецЕсли;
				Если ВозможнаяСсылка <> Неопределено Тогда
					Объект[КЗ.Ключ] = ВозможнаяСсылка;
				Иначе
					Объект[КЗ.Ключ] = КЗ.Значение;
				КонецЕсли;
			Исключение
			КонецПопытки;
		Иначе
			Попытка
				Объект[КЗ.Ключ] = КонвертироватьЗначение(МетаРеквизит.Тип, КЗ.Значение);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьИмяТипаРегистраДляЗапроса(ТипРегистра) Экспорт

	Если ТипРегистра = "InformationRegisters" Тогда
		Возврат "РегистрСведений";
	ИначеЕсли ТипРегистра = "AccumulationRegisters" Тогда
		Возврат "РегистрНакопления";
	Иначе
		ВызватьИсключение "Неподдерживаемый тип регистра: " + ТипРегистра + ". Используй InformationRegisters или AccumulationRegisters";
	КонецЕсли;

КонецФункции

Функция ПреобразоватьСтрокуВСсылкуЕслиВозможно(Значение) Экспорт

	// Парсить формат "ТипКоллекции.ИмяОбъекта:GUID"
	ПозицияДвоеточия = СтрНайти(Значение, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипСтрока = Лев(Значение, ПозицияДвоеточия - 1);
	ГУИДСтрока = Сред(Значение, ПозицияДвоеточия + 1);

	Если СтрДлина(ГУИДСтрока) <> 36 ИЛИ СтрНайти(ГУИДСтрока, "-") = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастиТипа = СтрРазделить(ТипСтрока, ".");
	Если ЧастиТипа.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипКоллекции = ЧастиТипа[0];
	ИмяОбъекта = ЧастиТипа[1];

	Попытка
		УИД = Новый УникальныйИдентификатор(ГУИДСтрока);
		Если ТипКоллекции = "Справочник" Тогда
			Возврат Справочники[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "Документ" Тогда
			Возврат Документы[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "ПланСчетов" Тогда
			Возврат ПланыСчетов[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "ПланВидовРасчета" Тогда
			Возврат ПланыВидовРасчета[ИмяОбъекта].ПолучитьСсылку(УИД);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ПреобразоватьСтрокуВПеречислениеЕслиВозможно(Значение) Экспорт

	// Парсить формат "Перечисление.ИмяПеречисления.ЗначениеПеречисления"
	Части = СтрРазделить(Значение, ".");
	Если Части.Количество() <> 3 ИЛИ Части[0] <> "Перечисление" Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяПеречисления = Части[1];
	ИмяЗначения = Части[2];

	Попытка
		Возврат Перечисления[ИмяПеречисления][ИмяЗначения];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции
