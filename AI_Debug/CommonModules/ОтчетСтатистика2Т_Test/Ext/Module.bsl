// Тест отчёта 2-Т (статистика оплаты труда)
// Покрывает: алгоритм выборки (чистая логика) + наличие данных в базе
//           + cell-by-cell сравнение с эталонами Excel (docs/2T/)
//
// Эталоны Excel: Абай=10/3, Жетысу=11/5, Карагандинский=13/3 (апрель 2025)
// Алгоритм выборки реплицирован из:
//   Reports/РегламентированныйОтчетСтатистика2ТОплатаТруда/
//   Forms/ФормаОтчета2Т2025Кв1/Ext/Form/Module.bsl :: ПрименитьВыборкуСотрудников

#Область СлужебныйПрограммныйИнтерфейс

Функция ИсполняемыеСценарии() Экспорт
	Тесты = ЮТТесты.СписокТестов(
		"АлгоритмВыборкиДо100Включительно",
		"АлгоритмВыборки101До250",
		"АлгоритмВыборки251До5000",
		"АлгоритмВыборкиБолее5000",
		"СотрудникиСДолжностью2ТСуществуют",
		"СправочникДолжностей2ТНеПустой",
		"КодыЗанятийЗаполнены",
		"ФЗПЗаАпрельСуществует",
		"ЧасыЗаАпрельСуществуют",
		"СотрудникиИмеютФЗПИЧасы");
	Для Каждого Т Из ЮТТесты.СписокТестов(
		"ТипЗанятостиОпределяетсяПоЧасам",
		"РасчетФЗПИСредЗП",
		"ФильтрНулевыхПоказателей") Цикл
		Тесты.Добавить(Т);
	КонецЦикла;
	// Cell-by-cell эталоны Excel (апрель 2025)
	Для Каждого Т Из ЮТТесты.СписокТестов(
		"ЭталонАбай_Численность",
		"ЭталонЖетысу_Численность",
		"ЭталонКарагандинский_Численность",
		"ЭталонАбай_ТабНомера",
		"ЭталонЖетысу_ТабНомера",
		"ЭталонКарагандинский_ТабНомера") Цикл
		Тесты.Добавить(Т);
	КонецЦикла;
	Возврат Тесты;
КонецФункции

#КонецОбласти

#Область ТестыАлгоритмаВыборки

