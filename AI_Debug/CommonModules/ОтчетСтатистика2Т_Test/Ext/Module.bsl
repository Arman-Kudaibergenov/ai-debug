// Создаёт массив из N числовых элементов (для тестов алгоритма выборки)
Функция СоздатьМассив(КолЭлементов)
	Результат = Новый Массив;
	Для Ном = 1 По КолЭлементов Цикл
		Результат.Добавить(Ном);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Реплика алгоритма выборки из ФормаОтчета2Т2025Кв1 :: ПрименитьВыборкуСотрудников
// При изменении алгоритма в форме — обновить и здесь
Функция ПрименитьВыборкуСотрудников(МассивДанных)
	Численность = МассивДанных.Количество();

	Если Численность <= 100 Тогда
		Возврат МассивДанных;
	КонецЕсли;

	Если Численность <= 250 Тогда
		ШагВыборки = 2;
	ИначеЕсли Численность <= 5000 Тогда
		ШагВыборки = 10;
	Иначе
		ШагВыборки = 50;
	КонецЕсли;

	Результат = Новый Массив;
	Для Индекс = 0 По МассивДанных.ВГраница() Цикл
		Если (Индекс + 1) % ШагВыборки = 0 Тогда
			Результат.Добавить(МассивДанных[Индекс]);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Возвращает данные отчёта 2-Т для филиала за апрель 2025.
// Реплика логики ФормаОтчета2Т2025Кв1KAF :: ЗаполнитьАвтоматическиНаСервере
//
// МаскаФилиала — ПОДОБНО-шаблон для поиска подразделения (например "%Абай%").
// Возвращаемое значение: Структура("Всего, Женщин, ТабНомера")
//   Всего    — количество сотрудников с ФЗП или часами за апрель 2025
//   Женщин   — из них женщин (пол = 2)
//   ТабНомера — Массив табельных номеров (Строка)
Функция ПолучитьДанные2ТФилиала(МаскаФилиала)

	ДатаНачала    = Дата(2025, 4, 1);
	ДатаОкончания = КонецМесяца(ДатаНачала);

	// 1. Найти подразделение по маске
	ЗапросПдр = Новый Запрос;
	ЗапросПдр.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пдр.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПодразделенияОрганизаций КАК Пдр
	|ГДЕ
	|	Пдр.Наименование ПОДОБНО &МаскаФилиала
	|	И Пдр.ПометкаУдаления = ЛОЖЬ
	|	И Пдр.Родитель = ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)";
	ЗапросПдр.УстановитьПараметр("МаскаФилиала", МаскаФилиала);
	ТПдр = ЗапросПдр.Выполнить().Выгрузить();
	Если ТПдр.Количество() = 0 Тогда
		ВызватьИсключение "Филиал не найден по маске: " + МаскаФилиала;
	КонецЕсли;
	Филиал = ТПдр[0].Ссылка;

	// 2. Организация (единственная)
	ЗапросОрг = Новый Запрос;
	ЗапросОрг.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Орг.Ссылка ИЗ Справочник.Организации КАК Орг
	|ГДЕ Орг.ПометкаУдаления = ЛОЖЬ";
	Организация = ЗапросОрг.Выполнить().Выгрузить()[0].Ссылка;

	// 3. Сотрудники в подразделении (активные на конец апреля 2025)
	// Фильтр идентичен форме ФормаОтчета2Т2025Кв1KAF :: ЗаполнитьАвтоматическиНаСервере
	// (без фильтра по буДолжностиДляОтчета2Т — форма не фильтрует по нему)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотр.Код КАК ТабНомер,
	|	Сотр.Физлицо.Пол КАК Пол,
	|	Сотр.Ссылка КАК Сотрудник
	|ИЗ
	|	Справочник.СотрудникиОрганизаций КАК Сотр
	|ГДЕ
	|	Сотр.Организация = &Организация
	|	И Сотр.ТекущееСтруктурноеПодразделение В ИЕРАРХИИ (&парамПодразделение)
	|	И Сотр.ПометкаУдаления = ЛОЖЬ
	|	И (Сотр.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Сотр.ДатаУвольнения > &ДатаОкончания)";
	Запрос.УстановитьПараметр("Организация",       Организация);
	Запрос.УстановитьПараметр("парамПодразделение", Филиал);
	Запрос.УстановитьПараметр("ДатаОкончания",      ДатаОкончания);
	ТСотр = Запрос.Выполнить().Выгрузить();

	// 4. ФЗП за апрель 2025 (по сотрудникам того же филиала)
	ЗапросФЗП = Новый Запрос;
	ЗапросФЗП.Текст =
	"ВЫБРАТЬ
	|	Нач.Сотрудник КАК Сотрудник,
	|	СУММА(Нач.Результат) / 1000 КАК ФЗП
	|ИЗ
	|	Документ.НачислениеЗарплатыРаботникамОрганизаций.Начисления КАК Нач
	|ГДЕ
	|	Нач.Ссылка.Организация = &Организация
	|	И Нач.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Нач.Ссылка.Проведен = ИСТИНА
	|СГРУППИРОВАТЬ ПО Нач.Сотрудник";
	ЗапросФЗП.УстановитьПараметр("Организация",  Организация);
	ЗапросФЗП.УстановитьПараметр("ДатаНачала",   ДатаНачала);
	ЗапросФЗП.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	ТФЗП = ЗапросФЗП.Выполнить().Выгрузить();

	// 5. Часы за апрель 2025
	ЗапросЧасов = Новый Запрос;
	ЗапросЧасов.Текст =
	"ВЫБРАТЬ
	|	РВ.Сотрудник КАК Сотрудник,
	|	СУММА(РВ.Часов) КАК Часов
	|ИЗ
	|	РегистрНакопления.РабочееВремяРаботниковОрганизаций КАК РВ
	|ГДЕ
	|	РВ.Организация = &Организация
	|	И РВ.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|СГРУППИРОВАТЬ ПО РВ.Сотрудник";
	ЗапросЧасов.УстановитьПараметр("Организация",  Организация);
	ЗапросЧасов.УстановитьПараметр("ДатаНачала",   ДатаНачала);
	ЗапросЧасов.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	ТЧасов = ЗапросЧасов.Выполнить().Выгрузить();

	// 6. Объединяем: только сотрудники с ФЗП или часами (логика формы)
	Всего    = 0;
	Женщин   = 0;
	ТабНомера = Новый Массив;

	Для Каждого СтрСотр Из ТСотр Цикл
		СтрФЗП  = ТФЗП.Найти(СтрСотр.Сотрудник, "Сотрудник");
		ФЗП     = ?(СтрФЗП  <> Неопределено, СтрФЗП.ФЗП,  0);
		СтрЧас  = ТЧасов.Найти(СтрСотр.Сотрудник, "Сотрудник");
		Часов   = ?(СтрЧас  <> Неопределено, СтрЧас.Часов, 0);
		Если ФЗП = 0 И Часов = 0 Тогда
			Продолжить;
		КонецЕсли;
		Всего = Всего + 1;
		Если СтрСотр.Пол = Перечисления.ПолФизическихЛиц.Женский Тогда
			Женщин = Женщин + 1;
		КонецЕсли;
		ТабНомера.Добавить(СокрЛП(СтрСотр.ТабНомер));
	КонецЦикла;

	Результат = Новый Структура("Всего, Женщин, ТабНомера");
	Результат.Всего     = Всего;
	Результат.Женщин    = Женщин;
	Результат.ТабНомера = ТабНомера;
	Возврат Результат;

КонецФункции

// Проверяет наличие каждого табельного номера из эталонного массива в данных отчёта.
Процедура ПроверитьТабНомера(ЭталонТабНомера, МаскаФилиала, ИмяФилиала)
	Данные = ПолучитьДанные2ТФилиала(МаскаФилиала);
	НайденыеТабНомера = Новый Соответствие;
	Для Каждого ТН Из Данные.ТабНомера Цикл
		НайденыеТабНомера.Вставить(ТН, Истина);
	КонецЦикла;

	НеНайденные = "";
	Для Каждого ЭталонТН Из ЭталонТабНомера Цикл
		Если НайденыеТабНомера[ЭталонТН] = Неопределено Тогда
			НеНайденные = НеНайденные + ЭталонТН + " ";
		КонецЕсли;
	КонецЦикла;

	ЮТУтверждения.Равно(СокрЛП(НеНайденные), "",
		ИмяФилиала + ": не найдены табельные номера из Excel-эталона: " + НеНайденные);
КонецПроцедуры

#КонецОбласти
