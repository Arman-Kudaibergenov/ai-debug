#Область ТестыДанных

// В базе есть сотрудники с заполненным буДолжностиДляОтчета2Т
Процедура СотрудникиСДолжностью2ТСуществуют() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Сотр.Ссылка) КАК Кол
	|ИЗ
	|	Справочник.СотрудникиОрганизаций КАК Сотр
	|ГДЕ
	|	Сотр.ТекущаяДолжностьОрганизации.буДолжностиДляОтчета2Т
	|		<> ЗНАЧЕНИЕ(Справочник.буДолжностиДляОтчета2Т.ПустаяСсылка)
	|	И Сотр.ПометкаУдаления = ЛОЖЬ";

	Кол = Запрос.Выполнить().Выгрузить()[0].Кол;
	ЮТУтверждения.Больше(Кол, 0,
		"Ожидаются сотрудники с заполненным буДолжностиДляОтчета2Т");
КонецПроцедуры

// Справочник буДолжностиДляОтчета2Т непустой
Процедура СправочникДолжностей2ТНеПустой() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Д.Ссылка) КАК Кол
	|ИЗ
	|	Справочник.буДолжностиДляОтчета2Т КАК Д
	|ГДЕ
	|	Д.ПометкаУдаления = ЛОЖЬ";

	Кол = Запрос.Выполнить().Выгрузить()[0].Кол;
	ЮТУтверждения.Больше(Кол, 0,
		"Справочник буДолжностиДляОтчета2Т должен содержать записи");
КонецПроцедуры

// КодЗанятий заполнен хотя бы у одной должности (иначе отчёт будет пустым)
Процедура КодыЗанятийЗаполнены() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ВЫБОР
	|		КОГДА Д.КодЗанятий <> """"
	|			ТОГДА Д.Ссылка
	|		ИНАЧЕ NULL
	|	КОНЕЦ) КАК СЗаполненнымКЗ,
	|	КОЛИЧЕСТВО(Д.Ссылка) КАК Всего
	|ИЗ
	|	Справочник.буДолжностиДляОтчета2Т КАК Д
	|ГДЕ
	|	Д.ПометкаУдаления = ЛОЖЬ";

	Стр = Запрос.Выполнить().Выгрузить()[0];
	ЮТУтверждения.Больше(Стр.СЗаполненнымКЗ, 0,
		"КодЗанятий должен быть заполнен хотя бы у одной должности 2-Т. "
		+ "Всего записей: " + Стр.Всего + ", с КЗ: " + Стр.СЗаполненнымКЗ);
КонецПроцедуры

#КонецОбласти

#Область ТестыE2E

// ФЗП за апрель 2025 содержит записи (запрос из формы 2-Т)
Процедура ФЗПЗаАпрельСуществует() Экспорт
	ЗапросФЗП = Новый Запрос;
	ЗапросФЗП.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Нач.Сотрудник) КАК КолСотр,
	|	СУММА(Нач.Результат) / 1000 КАК ФЗПТысРуб
	|ИЗ
	|	Документ.НачислениеЗарплатыРаботникамОрганизаций.Начисления КАК Нач
	|ГДЕ
	|	Нач.Ссылка.Проведен = ИСТИНА
	|	И Нач.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";

	ЗапросФЗП.УстановитьПараметр("ДатаНачала", Дата(2025, 4, 1));
	ЗапросФЗП.УстановитьПараметр("ДатаОкончания", КонецМесяца(Дата(2025, 4, 1)));

	Стр = ЗапросФЗП.Выполнить().Выгрузить()[0];
	ЮТУтверждения.Больше(Стр.КолСотр, 0,
		"Ожидаются начисления за апрель 2025. Сотрудников: " + Стр.КолСотр);
	ЮТУтверждения.Больше(Стр.ФЗПТысРуб, 0,
		"ФЗП должен быть > 0 тыс. руб. Факт: " + Стр.ФЗПТысРуб);
КонецПроцедуры

// Часы за апрель 2025 содержат записи (запрос из формы 2-Т)
Процедура ЧасыЗаАпрельСуществуют() Экспорт
	ЗапросЧасов = Новый Запрос;
	ЗапросЧасов.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РВ.Сотрудник) КАК КолСотр,
	|	СУММА(РВ.Часов) КАК ВсегоЧасов,
	|	СУММА(РВ.ЧасовПоНорме) КАК ВсегоПоНорме
	|ИЗ
	|	РегистрНакопления.РабочееВремяРаботниковОрганизаций КАК РВ
	|ГДЕ
	|	РВ.Период МЕЖДУ &ДатаНачала И &ДатаОкончания";

	ЗапросЧасов.УстановитьПараметр("ДатаНачала", Дата(2025, 4, 1));
	ЗапросЧасов.УстановитьПараметр("ДатаОкончания", КонецМесяца(Дата(2025, 4, 1)));

	Стр = ЗапросЧасов.Выполнить().Выгрузить()[0];
	ЮТУтверждения.Больше(Стр.КолСотр, 0,
		"Ожидаются часы за апрель 2025. Сотрудников: " + Стр.КолСотр);
	ЮТУтверждения.Больше(Стр.ВсегоЧасов, 0,
		"Часов должно быть > 0. Факт: " + Стр.ВсегоЧасов);
КонецПроцедуры

// E2E: сотрудники с должностью 2-Т имеют и ФЗП и часы (join работает)
Процедура СотрудникиИмеютФЗПИЧасы() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотр.Ссылка КАК Сотрудник,
	|	Сотр.ТекущаяДолжностьОрганизации.буДолжностиДляОтчета2Т.КодЗанятий КАК КодЗанятия,
	|	ЕСТЬNULL(ДанныеФЗП.СуммаФЗП, 0) КАК ФЗП,
	|	ЕСТЬNULL(Часы.Часов, 0) КАК Часов
	|ИЗ
	|	Справочник.СотрудникиОрганизаций КАК Сотр
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				Нач.Сотрудник КАК Сотрудник,
	|				СУММА(Нач.Результат) / 1000 КАК СуммаФЗП
	|			ИЗ
	|				Документ.НачислениеЗарплатыРаботникамОрганизаций.Начисления КАК Нач
	|			ГДЕ
	|				Нач.Ссылка.Проведен = ИСТИНА
	|				И Нач.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			СГРУППИРОВАТЬ ПО
	|				Нач.Сотрудник
	|		) КАК ДанныеФЗП
	|		ПО Сотр.Ссылка = ДанныеФЗП.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				РВ.Сотрудник КАК Сотрудник,
	|				СУММА(РВ.Часов) КАК Часов
	|			ИЗ
	|				РегистрНакопления.РабочееВремяРаботниковОрганизаций КАК РВ
	|			ГДЕ
	|				РВ.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			СГРУППИРОВАТЬ ПО
	|				РВ.Сотрудник
	|		) КАК Часы
	|		ПО Сотр.Ссылка = Часы.Сотрудник
	|ГДЕ
	|	Сотр.ТекущаяДолжностьОрганизации.буДолжностиДляОтчета2Т
	|		<> ЗНАЧЕНИЕ(Справочник.буДолжностиДляОтчета2Т.ПустаяСсылка)
	|	И Сотр.ПометкаУдаления = ЛОЖЬ
	|	И (Сотр.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Сотр.ДатаУвольнения > &ДатаОкончания)
	|	И (ЕСТЬNULL(ДанныеФЗП.СуммаФЗП, 0) > 0 ИЛИ ЕСТЬNULL(Часы.Часов, 0) > 0)";

	Запрос.УстановитьПараметр("ДатаНачала", Дата(2025, 4, 1));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(Дата(2025, 4, 1)));

	Результат = Запрос.Выполнить().Выгрузить();

	ЮТУтверждения.Больше(Результат.Количество(), 0,
		"Ожидаются сотрудники с должностью 2-Т, ФЗП или часами за апрель 2025");

	// Проверяем что у каждого есть КодЗанятия
	КолБезКода = 0;
	Для Каждого Стр Из Результат Цикл
		Если НЕ ЗначениеЗаполнено(Стр.КодЗанятия) Тогда
			КолБезКода = КолБезКода + 1;
		КонецЕсли;
	КонецЦикла;

	ЮТУтверждения.Равно(КолБезКода, 0,
		"У всех сотрудников должен быть КодЗанятия. Без кода: " + КолБезКода
		+ " из " + Результат.Количество());
КонецПроцедуры

#КонецОбласти

#Область ТестыРасчетнойЛогики

// ТипЗанятости: часы < норме → 2 (неполная), часы >= норме → 1 (полная)
Процедура ТипЗанятостиОпределяетсяПоЧасам() Экспорт
	// Полная занятость: часы = норме
	ТипПолная = ?(160 < 160, 2, 1);
	ЮТУтверждения.Равно(ТипПолная, 1, "160 часов при норме 160 → полная занятость (1)");

	// Полная занятость: часы > нормы (переработка)
	ТипПереработка = ?(180 < 160, 2, 1);
	ЮТУтверждения.Равно(ТипПереработка, 1, "180 часов при норме 160 → полная занятость (1)");

	// Неполная занятость: часы < нормы
	ТипНеполная = ?(80 < 160, 2, 1);
	ЮТУтверждения.Равно(ТипНеполная, 2, "80 часов при норме 160 → неполная занятость (2)");

	// Граничный случай: 0 часов, 0 норма → полная (0 < 0 = Ложь)
	ТипНоль = ?(0 < 0, 2, 1);
	ЮТУтверждения.Равно(ТипНоль, 1, "0 часов при норме 0 → тип 1 (не неполная)");
КонецПроцедуры

// ФЗП в тысячах рублей, СредЗП = ФЗП * 1000 (обратная конвертация в рубли)
Процедура РасчетФЗПИСредЗП() Экспорт
	// Имитация: начисление 45 678,50 руб → ФЗП = 45.68 тыс.руб (/ 1000, округление 2)
	НачислениеРуб = 45678.50;
	ФЗПТысРуб = Окр(НачислениеРуб / 1000, 2);
	ЮТУтверждения.Равно(ФЗПТысРуб, 45.68, "45678.50 / 1000 округлено до 2 = 45.68");

	// СредЗП = ФЗП * 1000 (обратно в рубли для графы таблицы)
	СредЗП = Окр(ФЗПТысРуб * 1000, 2);
	ЮТУтверждения.Равно(СредЗП, 45680, "45.68 * 1000 = 45680 (не исходные 45678.50 — потеря точности при двойном округлении)");

	// Ещё кейс: 123 456,789 → ФЗП = 123.46 → СредЗП = 123460
	ФЗП2 = Окр(123456.789 / 1000, 2);
	ЮТУтверждения.Равно(ФЗП2, 123.46, "123456.789 / 1000 = 123.46");
	СредЗП2 = Окр(ФЗП2 * 1000, 2);
	ЮТУтверждения.Равно(СредЗП2, 123460, "123.46 * 1000 = 123460");
КонецПроцедуры

// Сотрудники с ФЗП=0 И Часов=0 исключаются из результата
Процедура ФильтрНулевыхПоказателей() Экспорт
	// Имитация массива данных из формы
	МассивВход = Новый Массив;

	// Сотрудник с данными — включается
	Стр1 = Новый Структура("ФЗП,Часов", 50.5, 160);
	МассивВход.Добавить(Стр1);

	// Сотрудник без данных — исключается
	Стр2 = Новый Структура("ФЗП,Часов", 0, 0);
	МассивВход.Добавить(Стр2);

	// Сотрудник только с ФЗП — включается
	Стр3 = Новый Структура("ФЗП,Часов", 30, 0);
	МассивВход.Добавить(Стр3);

	// Сотрудник только с часами — включается
	Стр4 = Новый Структура("ФЗП,Часов", 0, 80);
	МассивВход.Добавить(Стр4);

	// Применяем фильтр (реплика логики формы)
	Результат = Новый Массив;
	Для Каждого Элем Из МассивВход Цикл
		Если Элем.ФЗП = 0 И Элем.Часов = 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Элем);
	КонецЦикла;

	ЮТУтверждения.Равно(Результат.Количество(), 3,
		"Из 4 сотрудников 1 с нулевыми показателями должен быть исключён");
КонецПроцедуры

#КонецОбласти

