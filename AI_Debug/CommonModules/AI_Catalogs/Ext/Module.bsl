// AI_Catalogs — tools for working with catalogs (справочники)
// Tools: get_catalog_item, find_catalog_items, create_catalog_item, update_catalog_item

Функция ОписаниеИнструментов() Экспорт

	Инструменты = Новый Массив;

	// get_catalog_item
	ИнструментCatalogItem = Новый Структура;
	ИнструментCatalogItem.Вставить("name", "get_catalog_item");
	ИнструментCatalogItem.Вставить("description", "Возвращает все реквизиты и табличные части элемента справочника по GUID. GUID получается из find_catalog_items или execute_query.");
	СхемаCatalogItem = Новый Структура;
	СхемаCatalogItem.Вставить("type", "object");
	СвойстваCatalogItem = Новый Структура;
	СвойстваCatalogItem.Вставить("catalogName", Новый Структура("type,description", "string", "Имя справочника (например Номенклатура)"));
	СвойстваCatalogItem.Вставить("itemRef", Новый Структура("type,description", "string", "GUID элемента справочника"));
	СхемаCatalogItem.Вставить("properties", СвойстваCatalogItem);
	СхемаCatalogItem.Вставить("required", AI_Utils.ПолучитьМассив("catalogName", "itemRef"));
	ИнструментCatalogItem.Вставить("inputSchema", СхемаCatalogItem);
	Инструменты.Добавить(ИнструментCatalogItem);

	// find_catalog_items
	ИнструментFindItems = Новый Структура;
	ИнструментFindItems.Вставить("name", "find_catalog_items");
	ИнструментFindItems.Вставить("description", "Ищет элементы справочника по наименованию или коду. Возвращает GUID для дальнейшего использования в get_catalog_item.");
	СхемаFindItems = Новый Структура;
	СхемаFindItems.Вставить("type", "object");
	СвойстваFindItems = Новый Структура;
	СвойстваFindItems.Вставить("catalogName", Новый Структура("type,description", "string", "Имя справочника"));
	СвойстваFindItems.Вставить("searchText", Новый Структура("type,description", "string", "Текст для поиска в наименовании и коде (необязательно)"));
	СвойстваFindItems.Вставить("limit", Новый Структура("type,description", "number", "Максимум результатов (по умолчанию 50)"));
	СхемаFindItems.Вставить("properties", СвойстваFindItems);
	СхемаFindItems.Вставить("required", AI_Utils.ПолучитьМассив("catalogName"));
	ИнструментFindItems.Вставить("inputSchema", СхемаFindItems);
	Инструменты.Добавить(ИнструментFindItems);

	// create_catalog_item
	ИнстрSprCreate = Новый Структура;
	ИнстрSprCreate.Вставить("name", "create_catalog_item");
	ИнстрSprCreate.Вставить("description", "Создаёт новый элемент справочника. Возвращает GUID созданного элемента. Используется для подготовки тестовых данных перед запуском тестов.");
	СхемаSprCreate = Новый Структура("type", "object");
	СвойстваSprCreate = Новый Структура;
	СвойстваSprCreate.Вставить("catalogName", Новый Структура("type,description", "string", "Имя справочника (например Номенклатура, Контрагенты)"));
	СвойстваSprCreate.Вставить("data", Новый Структура("type,description", "object", "Поля элемента: {ИмяРеквизита: Значение}. Ссылочные поля — GUID-строка; для СОСТАВНОГО типа обязателен явный тип: ""Справочник.Имя:GUID"" / ""Документ.Имя:GUID"" / ""Перечисление.Имя.Значение"". Даты — строка YYYYMMDD или YYYYMMDDHHMMSS."));
	СхемаSprCreate.Вставить("properties", СвойстваSprCreate);
	СхемаSprCreate.Вставить("required", AI_Utils.ПолучитьМассив("catalogName"));
	ИнстрSprCreate.Вставить("inputSchema", СхемаSprCreate);
	Инструменты.Добавить(ИнстрSprCreate);

	// update_catalog_item
	ИнстрUpdCatalog = Новый Структура;
	ИнстрUpdCatalog.Вставить("name", "update_catalog_item");
	ИнстрUpdCatalog.Вставить("description", "Обновляет реквизиты существующего элемента справочника. GUID получается из find_catalog_items или execute_query. Ссылочные поля можно передавать в формате 'Справочник.Имя:GUID' или просто GUID-строкой.");
	СхемаUpdCatalog = Новый Структура("type", "object");
	СвойстваUpdCatalog = Новый Структура;
	СвойстваUpdCatalog.Вставить("catalogName", Новый Структура("type,description", "string", "Имя справочника (например Контрагенты)"));
	СвойстваUpdCatalog.Вставить("itemRef", Новый Структура("type,description", "string", "GUID элемента справочника"));
	СвойстваUpdCatalog.Вставить("data", Новый Структура("type,description", "object", "Поля для обновления: {ИмяРеквизита: Значение}. Обновляются только переданные поля."));
	СхемаUpdCatalog.Вставить("properties", СвойстваUpdCatalog);
	СхемаUpdCatalog.Вставить("required", AI_Utils.ПолучитьМассив("catalogName", "itemRef"));
	ИнстрUpdCatalog.Вставить("inputSchema", СхемаUpdCatalog);
	Инструменты.Добавить(ИнстрUpdCatalog);

	Возврат Инструменты;

КонецФункции

Функция ВыполнитьИнструмент(ИмяИнструмента, Параметры) Экспорт

	Если ИмяИнструмента = "get_catalog_item" Тогда
		Возврат ПолучитьЭлементСправочника(Параметры);
	ИначеЕсли ИмяИнструмента = "find_catalog_items" Тогда
		Возврат НайтиЭлементыСправочника(Параметры);
	ИначеЕсли ИмяИнструмента = "create_catalog_item" Тогда
		Возврат СоздатьЭлементСправочника(Параметры);
	ИначеЕсли ИмяИнструмента = "update_catalog_item" Тогда
		Возврат ОбновитьЭлементСправочника(Параметры);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", "Не реализован инструмент: " + ИмяИнструмента);
	Возврат Ответ;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьЭлементСправочника(Параметры)

	ИмяСправочника = Параметры.catalogName;
	СтрокаСсылки = Параметры.itemRef;

	МетаОбъект = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаОбъект = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Справочник не найден: " + ИмяСправочника);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаСсылки);
		Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(УИД);
		Объект = Ссылка.ПолучитьОбъект();

		Если Объект = Неопределено Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Элемент не найден: " + СтрокаСсылки);
			Возврат Ответ;
		КонецЕсли;

		Строки = Новый Массив;
		Строки.Добавить("Справочник: " + ИмяСправочника);
		Строки.Добавить("Ссылка: " + Строка(Ссылка));
		Строки.Добавить("GUID: " + Строка(Ссылка.УникальныйИдентификатор()));
		Строки.Добавить("Код: " + Строка(Объект.Код));
		Строки.Добавить("Наименование: " + Строка(Объект.Наименование));
		Строки.Добавить("ПометкаУдаления: " + AI_Utils.ФорматироватьЗначение(Объект.ПометкаУдаления));

		Если МетаОбъект.Реквизиты.Количество() > 0 Тогда
			Строки.Добавить("");
			Строки.Добавить("=== Реквизиты ===");
			Для Каждого Реквизит Из МетаОбъект.Реквизиты Цикл
				Строки.Добавить(Реквизит.Имя + ": " + AI_Anonymizer.ФорматироватьДляВывода(Реквизит.Имя, Объект[Реквизит.Имя]));
			КонецЦикла;
		КонецЕсли;

		Для Каждого ТабЧасть Из МетаОбъект.ТабличныеЧасти Цикл
			КолСтрок = Объект[ТабЧасть.Имя].Количество();
			Строки.Добавить("");
			Строки.Добавить("=== ТЧ: " + ТабЧасть.Имя + " (" + Формат(КолСтрок, "ЧГ=") + " строк) ===");
			Если КолСтрок > 0 Тогда
				Колонки = Новый Массив;
				Для Каждого Реквизит Из ТабЧасть.Реквизиты Цикл
					Колонки.Добавить(Реквизит.Имя);
				КонецЦикла;
				Для Каждого СтрТЧ Из Объект[ТабЧасть.Имя] Цикл
					ЧастиСтроки = Новый Массив;
					Для Каждого ИмяКол Из Колонки Цикл
						ЧастиСтроки.Добавить(ИмяКол + ": " + AI_Anonymizer.ФорматироватьДляВывода(ИмяКол, СтрТЧ[ИмяКол]));
					КонецЦикла;
					Строки.Добавить(СтрСоединить(ЧастиСтроки, " | "));
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
		Возврат Ответ;

	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка получения элемента справочника: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция НайтиЭлементыСправочника(Параметры)

	ИмяСправочника = Параметры.catalogName;
	ТекстПоиска = "";
	Если Параметры.Свойство("searchText") Тогда
		ТекстПоиска = Параметры.searchText;
	КонецЕсли;
	Лимит = 50;
	Если Параметры.Свойство("limit") И ЗначениеЗаполнено(Параметры.limit) Тогда
		Лимит = Параметры.limit;
	КонецЕсли;

	Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Справочник не найден: " + ИмяСправочника);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;

		Если ЗначениеЗаполнено(ТекстПоиска) Тогда
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=") + "
				|	Ссылка,
				|	Наименование,
				|	Код
				|ИЗ
				|	Справочник." + ИмяСправочника + "
				|ГДЕ
				|	НЕ ПометкаУдаления
				|	И (Наименование ПОДОБНО &ТекстПоиска
				|	ИЛИ Код ПОДОБНО &ТекстПоиска)
				|УПОРЯДОЧИТЬ ПО
				|	Наименование";
			Запрос.УстановитьПараметр("ТекстПоиска", "%" + ТекстПоиска + "%");
		Иначе
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=") + "
				|	Ссылка,
				|	Наименование,
				|	Код
				|ИЗ
				|	Справочник." + ИмяСправочника + "
				|ГДЕ
				|	НЕ ПометкаУдаления
				|УПОРЯДОЧИТЬ ПО
				|	Наименование";
		КонецЕсли;

		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();

		Строки = Новый Массив;
		Строки.Добавить("Справочник: " + ИмяСправочника);
		Если ЗначениеЗаполнено(ТекстПоиска) Тогда
			Строки.Добавить("Поиск: " + ТекстПоиска);
		КонецЕсли;
		Строки.Добавить("");

		Счетчик = 0;
		Пока Выборка.Следующий() Цикл
			Строки.Добавить(
				"GUID: " + Строка(Выборка.Ссылка.УникальныйИдентификатор()) +
				" | Код: " + Строка(Выборка.Код) +
				" | Наименование: " + Строка(Выборка.Наименование)
			);
			Счетчик = Счетчик + 1;
		КонецЦикла;

		Строки.Добавить("");
		Строки.Добавить("Найдено: " + Формат(Счетчик, "ЧГ="));

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
		Возврат Ответ;

	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка поиска в справочнике: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция СоздатьЭлементСправочника(Параметры)

	ИмяСправочника = Параметры.catalogName;

	МетаОбъект = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаОбъект = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Справочник не найден: " + ИмяСправочника);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		НовыйОбъект = Справочники[ИмяСправочника].СоздатьЭлемент();

		ОшибкиПолей = Новый Массив;
		Если Параметры.Свойство("data") И ТипЗнч(Параметры.data) = Тип("Структура") Тогда
			AI_Utils.УстановитьРеквизиты(НовыйОбъект, МетаОбъект, Параметры.data, ОшибкиПолей);
		КонецЕсли;

		НовыйОбъект.Записать();

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("ref", Строка(НовыйОбъект.Ссылка.УникальныйИдентификатор()));
		Ответ.Вставить("message", "Элемент справочника " + ИмяСправочника + " создан");
		// Показать поля, которые не удалось установить (напр. составной тип без явного типа)
		Если ОшибкиПолей.Количество() > 0 Тогда
			Ответ.Вставить("fieldErrors", ОшибкиПолей);
			Ответ["message"] = Ответ["message"] + " (не установлено полей: " + Строка(ОшибкиПолей.Количество()) + ")";
		КонецЕсли;
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка создания элемента справочника: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция ОбновитьЭлементСправочника(Параметры)

	ИмяСправочника = Параметры.catalogName;
	СтрокаСсылки = Параметры.itemRef;

	МетаОбъект = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаОбъект = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Справочник не найден: " + ИмяСправочника);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаСсылки);
		Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(УИД);
		Объект = Ссылка.ПолучитьОбъект();

		Если Объект = Неопределено Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Элемент справочника не найден: " + СтрокаСсылки);
			Возврат Ответ;
		КонецЕсли;

		ОшибкиПолей = Новый Массив;
		Если Параметры.Свойство("data") И ТипЗнч(Параметры.data) = Тип("Структура") Тогда
			AI_Utils.УстановитьРеквизиты(Объект, МетаОбъект, Параметры.data, ОшибкиПолей);
		КонецЕсли;

		Объект.Записать();

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("ref", Строка(Ссылка.УникальныйИдентификатор()));
		Ответ.Вставить("message", "Элемент справочника " + ИмяСправочника + " обновлён");
		// Показать поля, которые не удалось установить (напр. составной тип без явного типа)
		Если ОшибкиПолей.Количество() > 0 Тогда
			Ответ.Вставить("fieldErrors", ОшибкиПолей);
			Ответ["message"] = Ответ["message"] + " (не установлено полей: " + Строка(ОшибкиПолей.Количество()) + ")";
		КонецЕсли;
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка обновления элемента справочника: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

#КонецОбласти
