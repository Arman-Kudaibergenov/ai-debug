////////////////////////////////////////////////////////////////////////////////
// Модуль ЮТУтверждения: утверждения для тестов
// При провале бросает исключение — run_unit_tests перехватывает и пишет FAIL.
//
// API (вызов напрямую, без .Что()):
//   ЮТУтверждения.Равно(Факт, Ожидаемое)
//   ЮТУтверждения.НеРавно(Факт, НеОжидаемое)
//   ЮТУтверждения.Истина(Условие)
//   ЮТУтверждения.Ложь(Условие)
//   ЮТУтверждения.Больше(Значение, Порог)
//   ЮТУтверждения.НеЗаполнено(Значение)
//   ЮТУтверждения.Заполнено(Значение)
//   ЮТУтверждения.ИмеетДлину(Коллекция, ОжидаемаяДлина)

#Область ПрограммныйИнтерфейс

// Значение равно ожидаемому.
//
// Параметры:
//   Значение      - Произвольный - фактическое значение
//   Ожидаемое     - Произвольный - ожидаемое значение
//   Комментарий   - Строка - пояснение к проверке (необязательно)
//
Процедура Равно(Значение, Ожидаемое, Комментарий = "") Экспорт
	Если Значение <> Ожидаемое Тогда
		ВызватьИсключение СформироватьСообщениеОшибки(
			"Ожидалось: " + Строка(Ожидаемое) + ", получено: " + Строка(Значение), Комментарий);
	КонецЕсли;
КонецПроцедуры

// Значение не равно запрещённому.
//
// Параметры:
//   Значение        - Произвольный
//   НеОжидаемое     - Произвольный
//   Комментарий     - Строка
//
Процедура НеРавно(Значение, НеОжидаемое, Комментарий = "") Экспорт
	Если Значение = НеОжидаемое Тогда
		ВызватьИсключение СформироватьСообщениеОшибки(
			"Значение не должно быть равно: " + Строка(НеОжидаемое), Комментарий);
	КонецЕсли;
КонецПроцедуры

// Условие истинно. Аналог ЮТУтверждения.Что(X).Равно(Истина).
//
// Параметры:
//   Значение     - Булево
//   Комментарий  - Строка
//
Процедура ЭтоИстина(Значение, Комментарий = "") Экспорт
	Если Значение <> Истина Тогда
		ВызватьИсключение СформироватьСообщениеОшибки("Ожидалось Истина, получено Ложь", Комментарий);
	КонецЕсли;
КонецПроцедуры

// Условие ложно. Аналог ЮТУтверждения.Что(X).Равно(Ложь).
//
// Параметры:
//   Значение     - Булево
//   Комментарий  - Строка
//
Процедура ЭтоЛожь(Значение, Комментарий = "") Экспорт
	Если Значение <> Ложь Тогда
		ВызватьИсключение СформироватьСообщениеОшибки("Ожидалось Ложь, получено Истина", Комментарий);
	КонецЕсли;
КонецПроцедуры

// Значение больше порога.
//
// Параметры:
//   Значение     - Число
//   Порог        - Число
//   Комментарий  - Строка
//
Процедура Больше(Значение, Порог, Комментарий = "") Экспорт
	Если Значение <= Порог Тогда
		ВызватьИсключение СформироватьСообщениеОшибки(
			"Ожидалось > " + Строка(Порог) + ", получено: " + Строка(Значение), Комментарий);
	КонецЕсли;
КонецПроцедуры

// Значение меньше порога.
//
// Параметры:
//   Значение     - Число
//   Порог        - Число
//   Комментарий  - Строка
//
Процедура Меньше(Значение, Порог, Комментарий = "") Экспорт
	Если Значение >= Порог Тогда
		ВызватьИсключение СформироватьСообщениеОшибки(
			"Ожидалось < " + Строка(Порог) + ", получено: " + Строка(Значение), Комментарий);
	КонецЕсли;
КонецПроцедуры

// Значение не заполнено (пустая строка, ноль, пустая ссылка, неопределено).
//
// Параметры:
//   Значение     - Произвольный
//   Комментарий  - Строка
//
Процедура НеЗаполнено(Значение, Комментарий = "") Экспорт
	Если ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение СформироватьСообщениеОшибки(
			"Ожидалось незаполненное значение, получено: " + Строка(Значение), Комментарий);
	КонецЕсли;
КонецПроцедуры

// Значение заполнено.
//
// Параметры:
//   Значение     - Произвольный
//   Комментарий  - Строка
//
Процедура Заполнено(Значение, Комментарий = "") Экспорт
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение СформироватьСообщениеОшибки("Ожидалось заполненное значение", Комментарий);
	КонецЕсли;
КонецПроцедуры

// Коллекция имеет заданное количество элементов.
//
// Параметры:
//   Коллекция        - Массив, ТаблицаЗначений и т.п. — объект с методом Количество()
//   ОжидаемаяДлина   - Число
//   Комментарий      - Строка
//
Процедура ИмеетДлину(Коллекция, ОжидаемаяДлина, Комментарий = "") Экспорт
	ФактДлина = Коллекция.Количество();
	Если ФактДлина <> ОжидаемаяДлина Тогда
		ВызватьИсключение СформироватьСообщениеОшибки(
			"Ожидалось элементов: " + Строка(ОжидаемаяДлина) + ", получено: " + Строка(ФактДлина), Комментарий);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьСообщениеОшибки(ОсновноеСообщение, Комментарий)
	Если ПустаяСтрока(Комментарий) Тогда
		Возврат ОсновноеСообщение;
	КонецЕсли;
	Возврат ОсновноеСообщение + " (" + Комментарий + ")";
КонецФункции

#КонецОбласти
