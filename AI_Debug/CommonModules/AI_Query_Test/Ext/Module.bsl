////////////////////////////////////////////////////////////////////////////////
// Модуль AI_Query_Test: тесты execute_query с параметрами (paramsCode).
//
// Запуск: run_unit_tests({"moduleName": "AI_Query_Test"})
//

#Область СлужебныйПрограммныйИнтерфейс

// Обязательная функция — точка входа для run_unit_tests.
//
Функция ИсполняемыеСценарии() Экспорт
	Возврат ЮТТесты.СписокТестов(
		"ExecuteQuery_ParamsCode_ПараметрУстановлен",
		"ExecuteQuery_ПараметрБезParamsCode_ОшибкаСИменем",
		"ExecuteQuery_ParamsCode_СтопЛист_Отказ",
		"ExecuteQuery_ParamsCode_СекретнаяКолонка_Замаскирована");
КонецФункции

#КонецОбласти

#Область Тесты

Процедура ExecuteQuery_ParamsCode_ПараметрУстановлен() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("queryText", "ВЫБРАТЬ &Порог КАК Значение");
	Параметры.Вставить("paramsCode", "Запрос.УстановитьПараметр(""Порог"", 42);");

	Результат = AI_Query.ВыполнитьИнструмент("execute_query", Параметры);

	ЮТУтверждения.ЭтоИстина(Результат.success, "запрос с paramsCode должен выполниться");
	ЮТУтверждения.ЭтоИстина(СтрНайти(Результат.data, "Значение: 42") > 0,
		"в выводе должно быть значение параметра");

КонецПроцедуры

Процедура ExecuteQuery_ПараметрБезParamsCode_ОшибкаСИменем() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("queryText", "ВЫБРАТЬ &Порог КАК Значение");

	Результат = AI_Query.ВыполнитьИнструмент("execute_query", Параметры);

	ЮТУтверждения.ЭтоЛожь(Результат.success, "запрос с &Порог без paramsCode должен быть отклонён");
	ЮТУтверждения.ЭтоИстина(СтрНайти(Результат.error, "Порог") > 0,
		"ошибка должна содержать имя параметра");
	ЮТУтверждения.ЭтоИстина(СтрНайти(Результат.error, "paramsCode") > 0,
		"ошибка должна подсказывать про paramsCode");

КонецПроцедуры

Процедура ExecuteQuery_ParamsCode_СтопЛист_Отказ() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("queryText", "ВЫБРАТЬ 1 КАК Значение");
	Параметры.Вставить("paramsCode", "Соединение = Новый HTTPСоединение(""example.com"");");

	Результат = AI_Query.ВыполнитьИнструмент("execute_query", Параметры);

	ЮТУтверждения.ЭтоЛожь(Результат.success, "код с HTTPСоединение должен быть отклонён стоп-листом");
	ЮТУтверждения.ЭтоИстина(СтрНайти(Результат.error, "HTTPСоединение") > 0,
		"ошибка должна называть запрещённую конструкцию");

КонецПроцедуры

Процедура ExecuteQuery_ParamsCode_СекретнаяКолонка_Замаскирована() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("queryText", "ВЫБРАТЬ ""x"" КАК Пароль");
	Параметры.Вставить("paramsCode", "// параметров нет, путь с транзакцией");

	Результат = AI_Query.ВыполнитьИнструмент("execute_query", Параметры);

	ЮТУтверждения.ЭтоИстина(Результат.success, "запрос должен выполниться");
	ЮТУтверждения.ЭтоИстина(СтрНайти(Результат.data, AI_Anonymizer.МаркерСекрета()) > 0,
		"секретная колонка должна быть замаскирована маркером");
	ЮТУтверждения.ЭтоИстина(СтрНайти(Результат.data, "Замаскированы секретные колонки") > 0,
		"должна быть строка сводки о маскировке");
	ЮТУтверждения.ЭтоЛожь(СтрНайти(Результат.data, "Пароль: x") > 0,
		"значение секретной колонки не должно попадать в вывод");

КонецПроцедуры

#КонецОбласти
