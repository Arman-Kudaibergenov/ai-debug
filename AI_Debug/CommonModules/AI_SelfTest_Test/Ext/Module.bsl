////////////////////////////////////////////////////////////////////////////////
// Модуль AI_SelfTest_Test: пример тестового модуля для run_unit_tests.
//
// Как использовать:
//   run_unit_tests({})                              — запустить все _Test модули
//   run_unit_tests({"moduleName": "AI_SelfTest_Test"}) — только этот модуль
//
// Структура _Test модуля:
//   1. ИсполняемыеСценарии() — возвращает массив имён тест-процедур
//   2. Каждая перечисленная процедура — один тест
//   3. Провал = вызов исключения (ЮТУтверждения бросает автоматически)

#Область СлужебныйПрограммныйИнтерфейс

// Обязательная функция — точка входа для run_unit_tests.
// Возвращает массив имён тест-процедур этого модуля.
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция ИсполняемыеСценарии() Экспорт
	Возврат ЮТТесты.СписокТестов(
		"Равно_ЧислаСовпадают_Проходит",
		"Равно_ЧислаРазные_Падает",
		"ЭтоИстина_ИстинноеУсловие_Проходит",
		"Больше_БольшееЗначение_Проходит",
		"Меньше_МеньшееЗначение_Проходит",
		"ИмеетДлину_МассивИзТрехЭлементов_ДлинаТри",
		"НеЗаполнено_ПустаяСтрока_Проходит",
		"Заполнено_НепустаяСтрока_Проходит");
КонецФункции

#КонецОбласти

#Область Тесты

// ЮТУтверждения.Равно: числа совпадают → тест проходит
Процедура Равно_ЧислаСовпадают_Проходит() Экспорт
	ЮТУтверждения.Равно(2 + 2, 4);
КонецПроцедуры

// ЮТУтверждения.Равно: числа разные → тест ПАДАЕТ (проверяет что падение работает)
// Этот тест ожидаемо завершится с [FAIL] — это демонстрация поведения при ошибке.
Процедура Равно_ЧислаРазные_Падает() Экспорт
	ЮТУтверждения.Равно(2 + 2, 5, "Специально неверное утверждение - тест должен упасть");
КонецПроцедуры

// ЮТУтверждения.ЭтоИстина: истинное условие → тест проходит
Процедура ЭтоИстина_ИстинноеУсловие_Проходит() Экспорт
	ЮТУтверждения.ЭтоИстина(1 < 2, "1 должно быть меньше 2");
КонецПроцедуры

// ЮТУтверждения.Больше: значение больше порога → тест проходит
Процедура Больше_БольшееЗначение_Проходит() Экспорт
	ЮТУтверждения.Больше(10, 5, "10 должно быть больше 5");
КонецПроцедуры

// ЮТУтверждения.Меньше: значение меньше порога → тест проходит
Процедура Меньше_МеньшееЗначение_Проходит() Экспорт
	ЮТУтверждения.Меньше(3, 10, "3 должно быть меньше 10");
КонецПроцедуры

// ЮТУтверждения.ИмеетДлину: массив из 3 элементов имеет длину 3
Процедура ИмеетДлину_МассивИзТрехЭлементов_ДлинаТри() Экспорт
	Массив = Новый Массив;
	Массив.Добавить("А");
	Массив.Добавить("Б");
	Массив.Добавить("В");
	ЮТУтверждения.ИмеетДлину(Массив, 3);
КонецПроцедуры

// ЮТУтверждения.НеЗаполнено: пустая строка считается незаполненной
Процедура НеЗаполнено_ПустаяСтрока_Проходит() Экспорт
	ЮТУтверждения.НеЗаполнено("", "Пустая строка должна быть незаполненной");
КонецПроцедуры

// ЮТУтверждения.Заполнено: непустая строка считается заполненной
Процедура Заполнено_НепустаяСтрока_Проходит() Экспорт
	ЮТУтверждения.Заполнено("Привет", "Непустая строка должна быть заполненной");
КонецПроцедуры

#КонецОбласти
