#Область ПрограммныйИнтерфейс

// Проверяет доступ к выполнению инструмента
//
// Параметры:
//   ИмяИнструмента - Строка - имя инструмента для проверки
//
// Возвращаемое значение:
//   Булево - Истина, если доступ разрешен
//
Функция ПроверитьДоступ(ИмяИнструмента) Экспорт
	Возврат Истина;
КонецФункции

// Валидирует параметры инструмента
//
// Параметры:
//   ИмяИнструмента - Строка - имя инструмента
//   Параметры - Структура - параметры для валидации
//
// Возвращаемое значение:
//   Массив из Строка - массив сообщений об ошибках (пустой, если ошибок нет)
//
Функция ВалидироватьПараметры(ИмяИнструмента, Параметры) Экспорт

	Ошибки = Новый Массив;

	Схема = ПолучитьСхемуПараметров(ИмяИнструмента);

	Если Схема = Неопределено Тогда
		Ошибки.Добавить("Неизвестный инструмент: " + ИмяИнструмента);
		Возврат Ошибки;
	КонецЕсли;

	Для Каждого ОбязательныйПараметр Из Схема.Обязательные Цикл
		Если НЕ Параметры.Свойство(ОбязательныйПараметр) Тогда
			Ошибки.Добавить("Отсутствует обязательный параметр: " + ОбязательныйПараметр);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючЗначение Из Параметры Цикл
		ОписаниеПараметра = Схема.Параметры.Получить(КлючЗначение.Ключ);
		Если ОписаниеПараметра <> Неопределено Тогда
			Если НЕ ПроверитьТипПараметра(КлючЗначение.Значение, ОписаниеПараметра.Тип) Тогда
				Ошибки.Добавить(СтрШаблон("Параметр '%1' имеет неверный тип. Ожидается: %2",
					КлючЗначение.Ключ, ОписаниеПараметра.Тип));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Ошибки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

