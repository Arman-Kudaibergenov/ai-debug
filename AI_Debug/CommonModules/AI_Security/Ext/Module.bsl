Функция ПолучитьМассив(Знач Элемент1, Знач Элемент2 = Неопределено, Знач Элемент3 = Неопределено)
	Массив = Новый Массив;
	Массив.Добавить(Элемент1);
	Если Элемент2 <> Неопределено Тогда
		Массив.Добавить(Элемент2);
	КонецЕсли;
	Если Элемент3 <> Неопределено Тогда
		Массив.Добавить(Элемент3);
	КонецЕсли;
	Возврат Массив;
КонецФункции

Функция ПроверитьТипПараметра(Значение, ОжидаемыйТип)
	Если ОжидаемыйТип = "Строка" Тогда
		Возврат ТипЗнч(Значение) = Тип("Строка");
	ИначеЕсли ОжидаемыйТип = "Число" Тогда
		Возврат ТипЗнч(Значение) = Тип("Число");
	ИначеЕсли ОжидаемыйТип = "Булево" Тогда
		Возврат ТипЗнч(Значение) = Тип("Булево");
	ИначеЕсли ОжидаемыйТип = "Структура" Тогда
		Возврат ТипЗнч(Значение) = Тип("Структура");
	ИначеЕсли ОжидаемыйТип = "Массив" Тогда
		Возврат ТипЗнч(Значение) = Тип("Массив");
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

