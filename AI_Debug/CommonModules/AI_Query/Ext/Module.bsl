// AI_Query — universal query execution tool
// Tools: execute_query

Функция ОписаниеИнструментов() Экспорт

	Инструменты = Новый Массив;

	// execute_query
	ИнструментQuery = Новый Структура;
	ИнструментQuery.Вставить("name", "execute_query");
	ИнструментQuery.Вставить("description",
		"Выполняет запрос к базе данных 1С. Возвращает результат в виде таблицы."
		+ " Пример: ВЫБРАТЬ Наименование ИЗ Справочник.Номенклатура."
		+ " Запрос с параметрами (&Параметр) требует заполнения paramsCode — кода на встроенном языке,"
		+ " который ВЫПОЛНЯЕТСЯ НА СЕРВЕРЕ перед запросом.");
	СхемаQuery = Новый Структура;
	СхемаQuery.Вставить("type", "object");
	СвойстваQuery = Новый Структура;
	СвойстваQuery.Вставить("queryText", Новый Структура("type,description", "string", "Текст запроса на языке запросов 1С"));
	СвойстваQuery.Вставить("maxRows", Новый Структура("type,description", "number", "Максимальное количество строк (по умолчанию 1000)"));
	СвойстваQuery.Вставить("paramsCode", Новый Структура("type,description", "string",
		"Код на встроенном языке 1С для заполнения параметров запроса. Не заполнять, если в запросе нет параметров."
		+ " Доступна переменная Запрос с уже установленным текстом — значения задавать через Запрос.УстановитьПараметр(""Имя"", Значение)."
		+ " Код выполняется на сервере в безопасном режиме внутри транзакции, которая отменяется ВСЕГДА,"
		+ " поэтому любые изменения данных не сохраняются. Запрещены: управление транзакцией и переключение режимов исполнения,"
		+ " фоновые и регламентные задания, запуск приложений и команд ОС, обращения наружу (HTTP, FTP, WS, почта)."
		+ " Объявления Перем, процедур и функций недопустимы."
		+ " Пример: Запрос.УстановитьПараметр(""Пользователь"", Справочники.Пользователи.ПолучитьСсылку("
		+ "Новый УникальныйИдентификатор(""01234567-89ab-cdef-0123-456789abcdef"")));"));
	СхемаQuery.Вставить("properties", СвойстваQuery);
	СхемаQuery.Вставить("required", AI_Utils.ПолучитьМассив("queryText"));
	ИнструментQuery.Вставить("inputSchema", СхемаQuery);
	Инструменты.Добавить(ИнструментQuery);

	Возврат Инструменты;

КонецФункции

Функция ВыполнитьИнструмент(ИмяИнструмента, Параметры) Экспорт

	Если ИмяИнструмента = "execute_query" Тогда
		Возврат ВыполнитьЗапрос(Параметры);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", "Не реализован инструмент: " + ИмяИнструмента);
	Возврат Ответ;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапрос(Параметры)

	ТекстЗапроса = Параметры.queryText;
	МаксСтрок = 1000;
	Если Параметры.Свойство("maxRows") И ЗначениеЗаполнено(Параметры.maxRows) Тогда
		МаксСтрок = Параметры.maxRows;
	КонецЕсли;

	КодПараметров = "";
	Если Параметры.Свойство("paramsCode") И ЗначениеЗаполнено(Параметры.paramsCode) Тогда
		КодПараметров = СокрЛП(Параметры.paramsCode);
	КонецЕсли;

	Если ЗначениеЗаполнено(КодПараметров) Тогда
		Возврат ВыполнитьЗапросСПараметрами(ТекстЗапроса, КодПараметров, МаксСтрок);
	КонецЕсли;

	// Запрос с параметрами без кода их заполнения выполнить нельзя. Платформенная ошибка
	// про незаданный параметр не подсказывает, чем её лечить, поэтому отвечаем сами —
	// с именами параметров и примером вызова.
	ПараметрыВТексте = НайтиПараметрыЗапроса(ТекстЗапроса);
	Если ПараметрыВТексте.Количество() > 0 Тогда
		Возврат ОтветОшибка("В тексте запроса есть параметры (&" + СтрСоединить(ПараметрыВТексте, ", &")
			+ "), но paramsCode не заполнен. Задайте их значения кодом на встроенном языке,"
			+ " например: Запрос.УстановитьПараметр(""" + ПараметрыВТексте[0] + """, Значение);");
	КонецЕсли;

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;

		Возврат ОтветУспех(СформироватьВывод(Запрос.Выполнить(), МаксСтрок));

	Исключение
		Возврат ОтветОшибка("Ошибка выполнения запроса: " + ОписаниеОшибки());
	КонецПопытки;

КонецФункции

// Выполняет запрос, параметры которого заполняет переданный код на встроенном языке.
//
// Код и запрос выполняются внутри транзакции, которая отменяется в любом случае:
// изменения данных, сделанные кодом напрямую или через вызванную им бизнес-логику,
// не сохраняются. Дополнительно код исполняется в безопасном режиме (без привилегированного
// режима, COM, внешних компонент и файловых операций), а конструкции, способные выполниться
// вне транзакции, запрещены заранее — см. НайтиЗапрещеннуюКонструкцию.
//
// Параметры:
//   ТекстЗапроса   - Строка - текст запроса на языке запросов 1С
//   КодПараметров  - Строка - код на встроенном языке, заполняющий параметры запроса
//   МаксСтрок      - Число  - ограничение количества строк вывода
//
// Возвращаемое значение:
//   Структура - ответ инструмента, см. ОтветУспех / ОтветОшибка
//
Функция ВыполнитьЗапросСПараметрами(ТекстЗапроса, КодПараметров, МаксСтрок)

	// Код пишется в журнал до всех проверок: попытка выполнить запрещённое тоже должна оставить след.
	AI_Logger.ЗаписатьВыполняемыйКод("execute_query", КодПараметров);

	ЗапрещеннаяКонструкция = НайтиЗапрещеннуюКонструкцию(КодПараметров);
	Если ЗначениеЗаполнено(ЗапрещеннаяКонструкция) Тогда
		Возврат ОтветОшибка(СтрШаблон(
			"В коде заполнения параметров запрещена конструкция ""%1"": её последствия не отменяются"
			+ " вместе с транзакцией запроса. Заполняйте параметры без неё.",
			ЗапрещеннаяКонструкция));
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;

	Вывод = "";
	ТекстОшибки = "";

	// Запоминается до своей транзакции: раскручивать ниже этого уровня нельзя.
	БылаТранзакцияВызывающего = ТранзакцияАктивна();

	НачатьТранзакцию();

	Попытка

		// Режим устанавливается здесь, а Выполнить работает в кадре ЗаполнитьПараметрыЗапроса:
		// безопасный режим, установленный вызывающим методом, вызываемый код снять не может.
		УстановитьБезопасныйРежим(Истина);

		ЗаполнитьПараметрыЗапроса(Запрос, КодПараметров);

		// Стоп-лист ловит явные вызовы, но не вызовы через обёртки конфигурации, поэтому
		// вмешательство в транзакцию проверяется по фактическому состоянию, а не по тексту кода.
		Если НЕ ТранзакцияАктивна() Тогда
			ВызватьИсключение "Код заполнения параметров вмешался в управление транзакцией:"
				+ " отмену изменений гарантировать невозможно, запрос не выполнялся.";
		КонецЕсли;

		Попытка
			// Вывод формируется до отмены транзакции: после отмены выборка недоступна.
			Вывод = СформироватьВывод(Запрос.Выполнить(), МаксСтрок);
		Исключение
			ВызватьИсключение "Ошибка выполнения запроса: " + ОписаниеОшибки();
		КонецПопытки;

	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Если БылаТранзакцияВызывающего Тогда
		// Своя транзакция вложена в чужую — снимаем только свой уровень, чужую трогать нельзя.
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
	Иначе
		// Раскрутка до конца: код мог открыть свои транзакции и не закрыть их,
		// тогда одиночная отмена сняла бы только верхний уровень вложенности.
		Пока ТранзакцияАктивна() Цикл
			ОтменитьТранзакцию();
		КонецЦикла;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ОтветОшибка(ТекстОшибки);
	КонецЕсли;

	Возврат ОтветУспех(Вывод);

КонецФункции

// Выполняет код заполнения параметров в собственном кадре вызова.
//
// Отдельный метод нужен по двум причинам: безопасный режим, установленный вызывающим методом,
// нельзя снять из вызываемого кода, и код не видит локальные переменные ВыполнитьЗапросСПараметрами
// (иначе он мог бы переприсвоить ТекстОшибки или МаксСтрок и исказить результат).
//
// Параметры:
//   Запрос - Запрос - запрос с установленным текстом, параметры которого заполняет код
//   КодПараметров - Строка - код на встроенном языке
//
Процедура ЗаполнитьПараметрыЗапроса(Знач Запрос, Знач КодПараметров)

	Попытка
		Выполнить(КодПараметров);
	Исключение
		ВызватьИсключение СтрШаблон(
			"Ошибка в коде заполнения параметров: %1%2Проверьте код (сам запрос не выполнялся):%2%3",
			ОписаниеОшибки(), Символы.ПС, КодПараметров);
	КонецПопытки;

КонецПроцедуры

// Ищет в коде заполнения параметров конструкции, последствия которых не отменяются
// вместе с транзакцией запроса: код в отдельном сеансе и выход за пределы базы.
// Остальные изменения данных отменять не требуется — их снимает отмена транзакции.
//
// Возвращаемое значение:
//   Строка - найденная запрещённая конструкция, пустая строка если таких нет
//
Функция НайтиЗапрещеннуюКонструкцию(КодПараметров)

	ЗапрещенныеКонструкции = Новый Массив;

	// Управление транзакцией: снимает саму гарантию отмены изменений.
	ЗапрещенныеКонструкции.Добавить("ЗафиксироватьТранзакцию");
	ЗапрещенныеКонструкции.Добавить("CommitTransaction");
	ЗапрещенныеКонструкции.Добавить("ОтменитьТранзакцию");
	ЗапрещенныеКонструкции.Добавить("RollbackTransaction");
	ЗапрещенныеКонструкции.Добавить("НачатьТранзакцию");
	ЗапрещенныеКонструкции.Добавить("BeginTransaction");

	// Снятие ограничений исполнения.
	ЗапрещенныеКонструкции.Добавить("УстановитьБезопасныйРежим");
	ЗапрещенныеКонструкции.Добавить("SetSafeMode");
	ЗапрещенныеКонструкции.Добавить("УстановитьПривилегированныйРежим");
	ЗапрещенныеКонструкции.Добавить("SetPrivilegedMode");

	// Исполнение в отдельном сеансе и выход за пределы базы.
	ЗапрещенныеКонструкции.Добавить("ФоновыеЗадания");
	ЗапрещенныеКонструкции.Добавить("BackgroundJobs");
	ЗапрещенныеКонструкции.Добавить("РегламентныеЗадания");
	ЗапрещенныеКонструкции.Добавить("ScheduledJobs");
	ЗапрещенныеКонструкции.Добавить("ЗапуститьПриложение");
	ЗапрещенныеКонструкции.Добавить("RunApp");
	ЗапрещенныеКонструкции.Добавить("КомандаСистемы");
	ЗапрещенныеКонструкции.Добавить("SystemCommand");
	ЗапрещенныеКонструкции.Добавить("HTTPСоединение");
	ЗапрещенныеКонструкции.Добавить("HTTPConnection");
	ЗапрещенныеКонструкции.Добавить("FTPСоединение");
	ЗапрещенныеКонструкции.Добавить("FTPConnection");
	ЗапрещенныеКонструкции.Добавить("ИнтернетПочта");
	ЗапрещенныеКонструкции.Добавить("InternetMail");
	ЗапрещенныеКонструкции.Добавить("WSСсылки");
	ЗапрещенныеКонструкции.Добавить("WSReferences");
	ЗапрещенныеКонструкции.Добавить("WSПрокси");
	ЗапрещенныеКонструкции.Добавить("WSProxy");

	КодВВерхнемРегистре = ВРег(КодПараметров);

	Для Каждого Конструкция Из ЗапрещенныеКонструкции Цикл
		Если СтрНайти(КодВВерхнемРегистре, ВРег(Конструкция)) > 0 Тогда
			Возврат Конструкция;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает имена параметров, найденные в тексте запроса.
//
// Разбор делает сама платформа: ручной поиск амперсандов пришлось бы учить строковым
// литералам, комментариям и прочему синтаксису языка запросов.
// На неразбираемом тексте НайтиПараметры бросает исключение — тогда список пуст,
// а о синтаксисе скажет сам Выполнить, его сообщение точнее и с позицией ошибки.
//
// Параметры:
//   ТекстЗапроса - Строка - текст запроса на языке запросов 1С
//
// Возвращаемое значение:
//   Массив из Строка - имена параметров без амперсанда
//
Функция НайтиПараметрыЗапроса(ТекстЗапроса)

	Имена = Новый Массив;

	Попытка
		ЗапросРазбора = Новый Запрос;
		ЗапросРазбора.Текст = ТекстЗапроса;
		ОписанияПараметров = ЗапросРазбора.НайтиПараметры();
	Исключение
		Возврат Имена;
	КонецПопытки;

	Для Каждого ОписаниеПараметра Из ОписанияПараметров Цикл
		Имена.Добавить(ОписаниеПараметра.Имя);
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Формирует текстовое представление результата запроса.
// Вынесено из ВыполнитьЗапрос, чтобы вывод одинаково строился для запроса с параметрами и без них.
// Секретные колонки (AI_Anonymizer.ЭтоСекретноеИмя) маскируются маркером до отдачи наружу.
//
Функция СформироватьВывод(РезультатЗапроса, МаксСтрок)

	Выборка = РезультатЗапроса.Выбрать();

	Колонки = Новый Массив;
	СекретныеКолонки = Новый Соответствие;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
		Если AI_Anonymizer.ЭтоСекретноеИмя(Колонка.Имя) Тогда
			СекретныеКолонки.Вставить(Колонка.Имя, Истина);
		КонецЕсли;
	КонецЦикла;

	// Реверсивная анонимизация ПДн — только при включённой политике
	// (мастер-запись РС AI_AnonymizationPolicy). Выключена — вывод как раньше.
	ПолитикаАнонимизации = AI_Anonymizer.ПолитикаАнонимизацииАктивна();

	Строки = Новый Массив;
	Строки.Добавить("Колонки: " + СтрСоединить(Колонки, ", "));
	Строки.Добавить("");

	Счетчик = 0;
	Пока Выборка.Следующий() И Счетчик < МаксСтрок Цикл
		ЧастиСтроки = Новый Массив;
		Для Каждого ИмяКолонки Из Колонки Цикл
			Значение = Выборка[ИмяКолонки];
			Если СекретныеКолонки[ИмяКолонки] <> Неопределено
				И ЗначениеЗаполнено(Значение) Тогда
				ЧастиСтроки.Добавить(ИмяКолонки + ": " + AI_Anonymizer.МаркерСекрета());
				Продолжить;
			КонецЕсли;
			ТекстЗначения = Строка(Значение);
			Если ПолитикаАнонимизации И ТипЗнч(Значение) = Тип("Строка") Тогда
				ТекстЗначения = AI_Anonymizer.АнонимизироватьТекст(ТекстЗначения, "query", ИмяКолонки);
			КонецЕсли;
			// Проверка типа отсеивает примитивные значения, на которых прежний код
			// возбуждал исключение для каждой ячейки таблицы. Попытка оставлена страховкой:
			// у ссылок перечислений и точек маршрута метода УникальныйИдентификатор нет,
			// хотя объект метаданных по типу находится.
			Если ЭтоСсылкаНаОбъектБазы(Значение) Тогда
				Попытка
					ТекстЗначения = ТекстЗначения + " [" + Строка(Значение.УникальныйИдентификатор()) + "]";
				Исключение
				КонецПопытки;
			КонецЕсли;
			ЧастиСтроки.Добавить(ИмяКолонки + ": " + ТекстЗначения);
		КонецЦикла;
		Строки.Добавить(СтрСоединить(ЧастиСтроки, " | "));
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Если Счетчик >= МаксСтрок Тогда
		Строки.Добавить("");
		Строки.Добавить("... (показано первых " + Формат(МаксСтрок, "ЧГ=") + " строк)");
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить("Всего строк: " + Формат(Счетчик, "ЧГ="));

	Если СекретныеКолонки.Количество() > 0 Тогда
		ИменаЗамаскированных = Новый Массив;
		Для Каждого КлючЗначение Из СекретныеКолонки Цикл
			ИменаЗамаскированных.Добавить(КлючЗначение.Ключ);
		КонецЦикла;
		Строки.Добавить("Замаскированы секретные колонки: "
			+ СтрСоединить(ИменаЗамаскированных, ", "));
	КонецЕсли;

	Если ПолитикаАнонимизации Тогда
		Строки.Добавить("Применена анонимизация ПДн (область: query). "
			+ "Карту токенов возвращает инструмент get_anonymization_map.");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ЭтоСсылкаНаОбъектБазы(Значение)

	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Метаданные.НайтиПоТипу(ТипЗнч(Значение)) <> Неопределено;

КонецФункции

Функция ОтветУспех(Данные)

	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("data", Данные);
	Возврат Ответ;

КонецФункции

Функция ОтветОшибка(Сообщение)

	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", Сообщение);
	Возврат Ответ;

КонецФункции

#КонецОбласти
