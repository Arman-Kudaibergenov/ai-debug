// Формирование ответов об ошибках

Функция ОшибкаДоступа() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("isError", Истина);

	Контент = Новый Массив;

	БлокКонтента = Новый Структура;
	БлокКонтента.Вставить("type", "text");
	БлокКонтента.Вставить("text", "Доступ запрещен. Проверьте права пользователя или режим работы сервера.");

	Контент.Добавить(БлокКонтента);

	Результат.Вставить("content", Контент);

	Возврат Результат;

КонецФункции

Функция ОшибкаВыполнения(ИнформацияОбОшибке) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("isError", Истина);

	Контент = Новый Массив;

	БлокКонтента = Новый Структура;
	БлокКонтента.Вставить("type", "text");
	БлокКонтента.Вставить("text", СтрШаблон(
		"Ошибка при выполнении инструмента:%1%1%2",
		Символы.ПС,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)
	));

	Контент.Добавить(БлокКонтента);

	Результат.Вставить("content", Контент);

	Возврат Результат;

КонецФункции

Функция ОшибкаРесурсНеНайден(URI) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("isError", Истина);

	Контент = Новый Массив;

	БлокКонтента = Новый Структура;
	БлокКонтента.Вставить("type", "text");
	БлокКонтента.Вставить("text", СтрШаблон("Ресурс не найден: %1", URI));

	Контент.Добавить(БлокКонтента);

	Результат.Вставить("content", Контент);

	Возврат Результат;

КонецФункции

Функция ОшибкаВалидации(Ошибки) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("isError", Истина);

	Контент = Новый Массив;

	ТекстОшибок = "Ошибки валидации параметров:" + Символы.ПС;

	Для Каждого Ошибка Из Ошибки Цикл
		ТекстОшибок = ТекстОшибок + "- " + Ошибка + Символы.ПС;
	КонецЦикла;

	БлокКонтента = Новый Структура;
	БлокКонтента.Вставить("type", "text");
	БлокКонтента.Вставить("text", ТекстОшибок);

	Контент.Добавить(БлокКонтента);

	Результат.Вставить("content", Контент);

	// Маркер для брокера ai-1c-control-plane: аттестация unknown-tool семантики
	Если СтрНайти(ТекстОшибок, "Неизвестный инструмент") > 0 Тогда
		Результат.Вставить("code", "unknown_tool");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Документация: процесс расследования инцидентов по технологическому журналу.
// Источники: scenarios.md (SteelMorgan/1c-agent-based-dev-framework),
// навык 1c-expert-tech-journal, ИТС metod8dev (разбор TLOCK/TDEADLOCK/TTIMEOUT),
// docs/event-inventory.md (palsergeich/TJ_parce, корпус 175 ГБ) — грабли формата.
//
Функция ПолучитьДокументациюTechLog()

	Текст =
	"# Расследование по технологическому журналу (ТЖ)
	|
	|get_tech_log даёт записи ТЖ. Этот навык превращает их в расследование: от симптома к причине.
	|
	|## 0. Инструменты AI_Debug для расследования
	|
	|- get_tech_log — записи ТЖ (фильтры по времени, событию, процессу)
	|- get_event_log — журнал регистрации: сшивка по пользователю и времени
	|- execute_query / execute_code — дочитать объект или код, найденный в Context записи ТЖ
	|
	|## 1. Классификация инцидента: что собирать
	|
	|- startup: EXCP, CONN — версия платформы, режим клиента, тип ИБ
	|- HTTP: EXCP, CALL, SCALL — путь запроса, обработчик, сервис
	|- web-client: EXCP, CALL — URL, идентификатор сессии, форма/модуль
	|- фоновое задание: EXCP, TLOCK, CALL — имя задания, параметры, счётчик повторов
	|- auth/session: CONN, EXCP — пользователь, аутентификация, завершение сеанса
	|- DBMS: DBMSSQL/DBPOSTGRS, SDBL — текст запроса, длительность, транзакция
	|- lock/deadlock: TLOCK, TDEADLOCK, TTIMEOUT — держатель/ожидающий, объект, время ожидания
	|- long call: CALL, SCALL — Duration, метод, стек
	|
	|## 2. Обязательные идентификаторы
	|
	|Фиксируй в рабочем контексте: timestamp с часовым поясом, база (IB), пользователь (Usr),
	|Session, Con (t:connectID), рабочий процесс (process), Trans, JobID, CorrID/ClientID.
	|Отсутствующий идентификатор — явно отметь в выводе, не додумывай.
	|
	|## 3. Дедлоки и ожидания: TLOCK / TDEADLOCK / TTIMEOUT
	|
	|- TDEADLOCK: поле DeadlockConnectionIntersections содержит пары t:connectID участников
	|  и пространства блокировки с полями (например InfoRg10.DIMS Exclusive Fld11=..., Fld12=...).
	|- До события TDEADLOCK найди TLOCK тех же t:connectID: поля Locks (Shared/Exclusive),
	|  WaitConnections и Context (модуль:строка — точка кода).
	|- Разделяемая блокировка ставится при чтении, исключительная при записи;
	|  обе снимаются только в конце внешней транзакции.
	|- Ожидания: TLOCK с непустым WaitConnections — считай топ пространств (Regions).
	|- TTIMEOUT, rollback, retry — следствия. Причина — в первом TLOCK цепочки.
	|
	|## 4. DBMS-улики единым блоком
	|
	|Для DBMSSQL/DBPOSTGRS/TLOCK/TDEADLOCK держи улики вместе, не разрывай:
	|query_text; lock_holder (session/trans/process); lock_waiter (session/trans/process);
	|wait_event; table/index; границы транзакции (begin/end); elapsed; process/session/connection.
	|
	|Рядом с DBMSSQL ищи SDBL: SDBL — исходный запрос на языке запросов 1С,
	|DBMSSQL — его SQL-трансляция. Сшивка по Trans и Session.
	|
	|## 5. Timeline
	|
	|- Зафиксируй источник времени и часовой пояс каждого файла; расходятся — приведи к UTC.
	|- Первая причинная запись (EXCP, начало TLOCK, первый DBMSSQL за порогом) важнее следствий.
	|- Повторяющиеся однотипные записи после первой ошибки — следствие, не причина.
	|- Нет записей до момента сбоя — запроси предшествующий интервал, не интерпретируй неполное окно.
	|
	|## 6. Безопасный сбор (предохранители)
	|
	|- Не включай подробный ТЖ без оценки I/O и места; после расследования верни минимальный
	|  режим (EXCP + длительные запросы с порогом) и проверь ротацию.
	|- Точечный сбор: один сценарий, известный пользователь и время, короткое окно.
	|- Не собирай параметры с персональными/коммерческими данными без политики доступа.
	|- Массовый анализ — через агрегацию: нормализуй текст (GUID, числа, временные таблицы
	|  в плейсхолдеры), группируй по контексту, считай частоту и суммарное время.
	|
	|## 7. Грабли формата ТЖ (по боевому корпусу 175 ГБ, 121 млн событий)
	|
	|- BOM в начале КАЖДОГО файла .log — читай как UTF-8 with BOM, иначе первая запись битая.
	|- Длительности в микросекундах и доходят до 4,9 часов — считай в 64-бит, не в Integer.
	|- TLOCK может быть до 3,4 МБ на событие (Locks держит полный дамп управляемых блокировок
	|  с тысячами диапазонов Fld) — не тащи такие строки в контекст целиком, вырезай Regions
	|  и WaitConnections.
	|- Свойства с двоеточием (p:processName, t:connectID, t:clientID) — это норма, а не мусор.
	|- Смешанные типы: CALL.Method бывает числом (ординал) и строкой (имя метода);
	|  TLOCK.WaitConnections бывает списком connectID строкой.
	|- В корпусе MSSQL нет событий DBPOSTGRS/SDBL — под PostgreSQL набор событий другой,
	|  проверяй фактические имена на целевой базе.
	|
	|## 8. Шаблон вывода (обязательный)
	|
	|### Timeline — ключевые события по времени, с указанием TZ
	|### Гипотеза первопричины — конкретная запись ТЖ → формулировка причины
	|### Затронутые метаданные / модули — объект → модуль → процедура (или «не установлено»)
	|### Шаг верификации — действие, которое подтверждает или опровергает гипотезу
	|### Недостающие улики — каких данных не хватает и что запросить. Раздел обязателен:
	|если вывод ненадёжен — скажи это и запроси данные вместо предположения.
	|";

	Возврат Текст;

КонецФункции

#КонецОбласти
