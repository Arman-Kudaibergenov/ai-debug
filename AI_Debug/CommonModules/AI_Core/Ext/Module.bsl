// Формирование ответов об ошибках

Функция ОшибкаДоступа() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("isError", Истина);

	Контент = Новый Массив;

	БлокКонтента = Новый Структура;
	БлокКонтента.Вставить("type", "text");
	БлокКонтента.Вставить("text", "Доступ запрещен. Проверьте права пользователя или режим работы сервера.");

	Контент.Добавить(БлокКонтента);

	Результат.Вставить("content", Контент);

	Возврат Результат;

КонецФункции

Функция ОшибкаВыполнения(ИнформацияОбОшибке) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("isError", Истина);

	Контент = Новый Массив;

	БлокКонтента = Новый Структура;
	БлокКонтента.Вставить("type", "text");
	БлокКонтента.Вставить("text", СтрШаблон(
		"Ошибка при выполнении инструмента:%1%1%2",
		Символы.ПС,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)
	));

	Контент.Добавить(БлокКонтента);

	Результат.Вставить("content", Контент);

	Возврат Результат;

КонецФункции

Функция ОшибкаРесурсНеНайден(URI) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("isError", Истина);

	Контент = Новый Массив;

	БлокКонтента = Новый Структура;
	БлокКонтента.Вставить("type", "text");
	БлокКонтента.Вставить("text", СтрШаблон("Ресурс не найден: %1", URI));

	Контент.Добавить(БлокКонтента);

	Результат.Вставить("content", Контент);

	Возврат Результат;

КонецФункции

Функция ОшибкаВалидации(Ошибки) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("isError", Истина);

	Контент = Новый Массив;

	ТекстОшибок = "Ошибки валидации параметров:" + Символы.ПС;

	Для Каждого Ошибка Из Ошибки Цикл
		ТекстОшибок = ТекстОшибок + "- " + Ошибка + Символы.ПС;
	КонецЦикла;

	БлокКонтента = Новый Структура;
	БлокКонтента.Вставить("type", "text");
	БлокКонтента.Вставить("text", ТекстОшибок);

	Контент.Добавить(БлокКонтента);

	Результат.Вставить("content", Контент);

	// Маркер для брокера ai-1c-control-plane: аттестация unknown-tool семантики
	Если СтрНайти(ТекстОшибок, "Неизвестный инструмент") > 0 Тогда
		Результат.Вставить("code", "unknown_tool");
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
