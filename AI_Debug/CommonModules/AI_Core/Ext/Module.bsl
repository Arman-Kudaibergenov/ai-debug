////////////////////////////////////////////////////////////////////////////////
// Модуль AI_Core: Ядро MCP протокола
//
// Обеспечивает:
// - Управление списком инструментов (сбор из доменных модулей)
// - Выполнение инструментов с проверкой безопасности
// - Управление ресурсами (документация)
// - Формирование ответов в формате MCP
//

#Область ПрограммныйИнтерфейс

// Получает список всех доступных инструментов в формате MCP
//
// Возвращаемое значение:
//   Массив из Структура - список инструментов
//
Функция ПолучитьСписокИнструментов() Экспорт

	Инструменты = Новый Массив;

	// Собираем инструменты из всех доменных модулей
	Для Каждого Инстр Из AI_Query.ОписаниеИнструментов() Цикл
		Инструменты.Добавить(Инстр);
	КонецЦикла;

	Для Каждого Инстр Из AI_Catalogs.ОписаниеИнструментов() Цикл
		Инструменты.Добавить(Инстр);
	КонецЦикла;

	Для Каждого Инстр Из AI_Documents.ОписаниеИнструментов() Цикл
		Инструменты.Добавить(Инстр);
	КонецЦикла;

	Для Каждого Инстр Из AI_Metadata.ОписаниеИнструментов() Цикл
		Инструменты.Добавить(Инстр);
	КонецЦикла;

	Для Каждого Инстр Из AI_Registers.ОписаниеИнструментов() Цикл
		Инструменты.Добавить(Инстр);
	КонецЦикла;

	Для Каждого Инстр Из AI_System.ОписаниеИнструментов() Цикл
		Инструменты.Добавить(Инстр);
	КонецЦикла;

	Для Каждого Инстр Из AI_PrintForms.ОписаниеИнструментов() Цикл
		Инструменты.Добавить(Инстр);
	КонецЦикла;

	Для Каждого Инстр Из AI_Diagnostics.ОписаниеИнструментов() Цикл
		Инструменты.Добавить(Инстр);
	КонецЦикла;

	Для Каждого Инстр Из AI_Executor.ОписаниеИнструментов() Цикл
		Инструменты.Добавить(Инстр);
	КонецЦикла;

	Возврат Инструменты;

КонецФункции

// Выполняет инструмент с проверкой безопасности и логированием
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Параметры) Экспорт

	// Проверка безопасности
	Если НЕ AI_Security.ПроверитьДоступ(ИмяИнструмента) Тогда
		Возврат ОшибкаДоступа();
	КонецЕсли;

	// Валидация параметров
	ОшибкиВалидации = AI_Security.ВалидироватьПараметры(ИмяИнструмента, Параметры);

	Если ОшибкиВалидации.Количество() > 0 Тогда
		Возврат ОшибкаВалидации(ОшибкиВалидации);
	КонецЕсли;

	// Логирование начала выполнения
	НачалоВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Результат = ВыполнитьИнструментВнутренний(ИмяИнструмента, Параметры);

		// Логирование успеха
		ВремяВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВыполнения;
		AI_Logger.ЗаписатьУспех(ИмяИнструмента, Параметры, Результат, ВремяВыполнения);

		Возврат Результат;

	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();

		// Логирование ошибки
		AI_Logger.ЗаписатьОшибку(ИмяИнструмента, Параметры, ИнформацияОбОшибке);

		Возврат ОшибкаВыполнения(ИнформацияОбОшибке);
	КонецПопытки;

КонецФункции

// Получает список доступных ресурсов (документация)
//
Функция ПолучитьСписокРесурсов() Экспорт

	Ресурсы = Новый Массив;

	Ресурсы.Добавить(СоздатьОписаниеРесурса(
		"ai://docs/quickstart",
		"Быстрый старт",
		"Руководство по началу работы с AI Debug Extension",
		"text/markdown"
	));

	Ресурсы.Добавить(СоздатьОписаниеРесурса(
		"ai://docs/tools",
		"Список инструментов",
		"Полное описание всех доступных инструментов",
		"text/markdown"
	));

	Ресурсы.Добавить(СоздатьОписаниеРесурса(
		"ai://docs/debugging",
		"Руководство по отладке",
		"Как использовать AI для отладки кода 1С",
		"text/markdown"
	));

	Ресурсы.Добавить(СоздатьОписаниеРесурса(
		"ai://docs/techlog",
		"Расследование по технологическому журналу",
		"Процесс расследования инцидентов по ТЖ: классификация, корреляция событий, дедлоки, шаблон вывода",
		"text/markdown"
	));

	Возврат Ресурсы;

КонецФункции

// Читает содержимое ресурса по URI
//
Функция ПрочитатьРесурс(URI) Экспорт

	Если СтрНачинаетсяС(URI, "ai://docs/") Тогда
		Возврат ПрочитатьДокументацию(URI);
	КонецЕсли;

	Возврат ОшибкаРесурсНеНайден(URI);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьОписаниеРесурса(URI, Имя, Описание, MIMEType)

	ОписаниеРесурса = Новый Структура;
	ОписаниеРесурса.Вставить("uri", URI);
	ОписаниеРесурса.Вставить("name", Имя);
	ОписаниеРесурса.Вставить("description", Описание);
	ОписаниеРесурса.Вставить("mimeType", MIMEType);

	Возврат ОписаниеРесурса;

КонецФункции

// Маршрутизация инструмента к доменному модулю

Функция ВыполнитьИнструментВнутренний(ИмяИнструмента, Параметры)

	// Определяем доменный модуль по имени инструмента
	Если ИмяИнструмента = "execute_query" Тогда
		РезультатQuery = AI_Query.ВыполнитьИнструмент(ИмяИнструмента, Параметры);
	ИначеЕсли ИмяИнструмента = "get_catalog_item"
		ИЛИ ИмяИнструмента = "find_catalog_items"
		ИЛИ ИмяИнструмента = "create_catalog_item"
		ИЛИ ИмяИнструмента = "update_catalog_item" Тогда
		РезультатQuery = AI_Catalogs.ВыполнитьИнструмент(ИмяИнструмента, Параметры);
	ИначеЕсли ИмяИнструмента = "get_document"
		ИЛИ ИмяИнструмента = "create_document"
		ИЛИ ИмяИнструмента = "update_document"
		ИЛИ ИмяИнструмента = "post_document"
		ИЛИ ИмяИнструмента = "unpost_document" Тогда
		РезультатQuery = AI_Documents.ВыполнитьИнструмент(ИмяИнструмента, Параметры);
	ИначеЕсли ИмяИнструмента = "list_metadata_objects"
		ИЛИ ИмяИнструмента = "get_metadata_structure"
		ИЛИ ИмяИнструмента = "get_event_log"
		ИЛИ ИмяИнструмента = "find_references_to_object" Тогда
		РезультатQuery = AI_Metadata.ВыполнитьИнструмент(ИмяИнструмента, Параметры);
	ИначеЕсли ИмяИнструмента = "get_register_records"
		ИЛИ ИмяИнструмента = "write_information_register"
		ИЛИ ИмяИнструмента = "delete_register_record" Тогда
		РезультатQuery = AI_Registers.ВыполнитьИнструмент(ИмяИнструмента, Параметры);
	ИначеЕсли ИмяИнструмента = "delete_object"
		ИЛИ ИмяИнструмента = "run_unit_tests" Тогда
		РезультатQuery = AI_System.ВыполнитьИнструмент(ИмяИнструмента, Параметры);
	ИначеЕсли ИмяИнструмента = "convert_file" Тогда
		РезультатQuery = AI_PrintForms.ВыполнитьИнструмент(ИмяИнструмента, Параметры);
	ИначеЕсли ИмяИнструмента = "get_document_postings"
		ИЛИ ИмяИнструмента = "get_exchange_status"
		ИЛИ ИмяИнструмента = "get_constants"
		ИЛИ ИмяИнструмента = "get_tech_log" Тогда
		РезультатQuery = AI_Diagnostics.ВыполнитьИнструмент(ИмяИнструмента, Параметры);
	ИначеЕсли ИмяИнструмента = "execute_code" Тогда
		РезультатQuery = AI_Executor.ВыполнитьИнструмент(ИмяИнструмента, Параметры);
	Иначе
		РезультатQuery = Новый Структура;
		РезультатQuery.Вставить("success", Ложь);
		РезультатQuery.Вставить("error", "Неизвестный инструмент: " + ИмяИнструмента);
		РезультатQuery.Вставить("errorCode", "unknown_tool");
	КонецЕсли;

	// Конвертация формата {success, data} → MCP {content, isError}
	МCPОтвет = Новый Структура;
	Контент = Новый Массив;
	БлокКонтента = Новый Структура;
	БлокКонтента.Вставить("type", "text");

	Если РезультатQuery.success Тогда
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, РезультатQuery);
		БлокКонтента.Вставить("text", ЗаписьJSON.Закрыть());
		МCPОтвет.Вставить("isError", Ложь);
	Иначе
		Сообщение = "";
		Если РезультатQuery.Свойство("error") Тогда
			Сообщение = РезультатQuery.error;
		КонецЕсли;
		Если РезультатQuery.Свойство("errorCode") Тогда
			Сообщение = Сообщение + " [" + РезультатQuery.errorCode + "]";
		КонецЕсли;
		БлокКонтента.Вставить("text", Сообщение);
		МCPОтвет.Вставить("isError", Истина);
	КонецЕсли;

	Контент.Добавить(БлокКонтента);
	МCPОтвет.Вставить("content", Контент);

	Возврат МCPОтвет;

КонецФункции

// Чтение ресурсов (документация)

Функция ПрочитатьДокументацию(URI)

	Содержимое = "";

	Если URI = "ai://docs/quickstart" Тогда
		Содержимое = ПолучитьДокументациюQuickstart();
	ИначеЕсли URI = "ai://docs/tools" Тогда
		Содержимое = ПолучитьДокументациюTools();
	ИначеЕсли URI = "ai://docs/debugging" Тогда
		Содержимое = ПолучитьДокументациюDebugging();
	ИначеЕсли URI = "ai://docs/techlog" Тогда
		Содержимое = ПолучитьДокументациюTechLog();
	Иначе
		Возврат ОшибкаРесурсНеНайден(URI);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("uri", URI);
	Результат.Вставить("mimeType", "text/markdown");
	Результат.Вставить("text", Содержимое);

	Возврат Результат;

КонецФункции

