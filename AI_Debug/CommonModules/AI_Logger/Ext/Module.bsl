////////////////////////////////////////////////////////////////////////////////
// Модуль AI_Logger
// 
// Логирование операций AI-инструментов для отладки и анализа
//
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Записывает успешное выполнение операции AI-инструмента
//
// Параметры:
//   ИмяИнструмента - Строка - имя выполненного инструмента
//   Параметры - Произвольный - параметры инструмента (будут сериализованы в JSON)
//   Результат - Произвольный - результат выполнения (будет сериализован в JSON)
//   ВремяВыполнения - Число - время выполнения в миллисекундах
//
Процедура ЗаписатьУспех(ИмяИнструмента, Параметры, Результат, ВремяВыполнения) Экспорт

	// Константы не поддерживаются в расширениях (совместимость 8.3.10).
	// Логирование всегда включено — события пишутся в журнал регистрации.
	ЗаписьЖурналаРегистрации(
		"AI." + ИмяИнструмента,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Выполнено за " + ВремяВыполнения + " мс. Пользователь: " + ПолучитьИмяПользователя()
	);

КонецПроцедуры

// Записывает ошибку при выполнении операции AI-инструмента
//
// Параметры:
//   ИмяИнструмента - Строка - имя инструмента, при выполнении которого произошла ошибка
//   Параметры - Произвольный - параметры инструмента (будут сериализованы в JSON)
//   ИнформацияОбОшибке - ИнформацияОбОшибке - информация об ошибке
//
Процедура ЗаписатьОшибку(ИмяИнструмента, Параметры, ИнформацияОбОшибке) Экспорт

	ЗаписьЖурналаРегистрации(
		"AI." + ИмяИнструмента,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ИнформацияОбОшибке.Описание + " (" + ИнформацияОбОшибке.ИмяМодуля + ":" + ИнформацияОбОшибке.НомерСтроки + ")"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сериализует значение в JSON
//
// Параметры:
//   Значение - Произвольный - значение для сериализации
//
// Возвращаемое значение:
//   Строка - JSON-представление значения
//
Функция СериализоватьJSON(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "null";
	КонецЕсли;
	
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Значение);
		
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		// Если не удалось сериализовать, возвращаем строковое представление
		Возврат Строка(Значение);
	КонецПопытки;
	
КонецФункции

// Получает имя текущего пользователя
//
// Возвращаемое значение:
//   Строка - имя пользователя информационной базы
//
Функция ПолучитьИмяПользователя()
	
	Попытка
		ИмяПользователя = ИмяПользователя();
		
		Если ПустаяСтрока(ИмяПользователя) Тогда
			Возврат "Неизвестный";
		КонецЕсли;
		
		Возврат ИмяПользователя;
	Исключение
		Возврат "Неизвестный";
	КонецПопытки;
	
КонецФункции

#КонецОбласти
