// Создаёт массив имён тест-процедур.
// Удобная обёртка для ИсполняемыеСценарии() тест-модуля.
//
// Параметры:
//   П1..П10 - Строка - имена тест-процедур
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция СписокТестов(П1 = "", П2 = "", П3 = "", П4 = "", П5 = "", П6 = "", П7 = "", П8 = "", П9 = "", П10 = "") Экспорт
	Рез = Новый Массив;
	Все = Новый Массив;
	Все.Добавить(П1); Все.Добавить(П2); Все.Добавить(П3); Все.Добавить(П4); Все.Добавить(П5);
	Все.Добавить(П6); Все.Добавить(П7); Все.Добавить(П8); Все.Добавить(П9); Все.Добавить(П10);
	Для Каждого П Из Все Цикл
		Если ЗначениеЗаполнено(П) Тогда
			Рез.Добавить(П);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

#КонецОбласти
