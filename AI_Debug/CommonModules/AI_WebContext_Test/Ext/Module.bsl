////////////////////////////////////////////////////////////////////////////////
// Модуль AI_WebContext_Test: тесты совместимости HTTP-сервиса с веб-клиентом.
//
// Проверяет корректность работы расширения AI_Debug когда одновременно
// открыт веб-клиент 1С (типичный сценарий при использовании web-test скилла):
//   - Список инструментов инициализируется без ошибок
//   - Все инструменты имеют обязательные поля (name, description, inputSchema)
//   - execute_query выполняет простой запрос и возвращает данные
//   - list_metadata_objects возвращает список объектов
//   - Сериализация JSON работает корректно для нестандартных значений
//
// Запуск:
//   run_unit_tests({})
//   run_unit_tests({"moduleName": "AI_WebContext_Test"})

#Область СлужебныйПрограммныйИнтерфейс

Функция ИсполняемыеСценарии() Экспорт
	Возврат ЮТТесты.СписокТестов(
		"СписокИнструментовНеПуст",
		"ВсеИнструментыИмеютОбязательныеПоля",
		"ЗапросВозвращаетДанные",
		"СписокМетаданныхВозвращаетОбъекты",
		"ВыполнитьИнструментВозвращаетКорректнуюСтруктуру");
КонецФункции

#КонецОбласти

#Область Тесты

// AI_Core.ПолучитьСписокИнструментов() не должен бросать исключений
// и должен возвращать хотя бы один инструмент
Процедура СписокИнструментовНеПуст() Экспорт
	Инструменты = AI_Core.ПолучитьСписокИнструментов();
	ЮТУтверждения.ЭтоИстина(ТипЗнч(Инструменты) = Тип("Массив"),
		"ПолучитьСписокИнструментов должен вернуть Массив");
	ЮТУтверждения.Больше(Инструменты.Количество(), 0,
		"Список инструментов не должен быть пустым");
КонецПроцедуры

// Каждый инструмент должен иметь поля name, description и inputSchema
Процедура ВсеИнструментыИмеютОбязательныеПоля() Экспорт
	Инструменты = AI_Core.ПолучитьСписокИнструментов();
	Для Каждого Инструмент Из Инструменты Цикл
		ЮТУтверждения.ЭтоИстина(Инструмент.Свойство("name"),
			"Инструмент должен иметь поле 'name'");
		ЮТУтверждения.Заполнено(Инструмент.name,
			"Поле 'name' инструмента не должно быть пустым");
		ЮТУтверждения.ЭтоИстина(Инструмент.Свойство("description"),
			"Инструмент " + Инструмент.name + " должен иметь поле 'description'");
		ЮТУтверждения.ЭтоИстина(Инструмент.Свойство("inputSchema"),
			"Инструмент " + Инструмент.name + " должен иметь поле 'inputSchema'");
	КонецЦикла;
КонецПроцедуры

// execute_query с COUNT(*) должен вернуть данные без ошибок
// Это критично когда web-test скрипт вызывает HTTP-сервис для верификации данных
Процедура ЗапросВозвращаетДанные() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("queryText", "ВЫБРАТЬ 1 КАК Значение");
	Результат = AI_Core.ВыполнитьИнструмент("execute_query", Параметры);
	ЮТУтверждения.ЭтоИстина(Результат.Свойство("content"),
		"Результат execute_query должен содержать поле 'content'");
	Контент = Результат.content;
	ЮТУтверждения.ЭтоИстина(ТипЗнч(Контент) = Тип("Массив"),
		"Поле 'content' должно быть массивом");
	ЮТУтверждения.Больше(Контент.Количество(), 0,
		"Результат запроса не должен быть пустым");
	ЮТУтверждения.ЭтоИстина(НЕ (Результат.Свойство("isError") И Результат.isError = Истина),
		"Простой запрос не должен завершаться ошибкой");
КонецПроцедуры

// list_metadata_objects для "Справочник" должен вернуть список
// Используется web-test скриптами для discovery объектов
Процедура СписокМетаданныхВозвращаетОбъекты() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("type", "Справочник");
	Результат = AI_Core.ВыполнитьИнструмент("list_metadata_objects", Параметры);
	ЮТУтверждения.ЭтоИстина(НЕ (Результат.Свойство("isError") И Результат.isError = Истина),
		"list_metadata_objects не должен завершаться ошибкой");
	ЮТУтверждения.ЭтоИстина(Результат.Свойство("content"),
		"Результат должен содержать поле 'content'");
КонецПроцедуры

// ВыполнитьИнструмент для несуществующего инструмента должен вернуть
// isError=true, а не бросить исключение — HTTP-сервис должен быть устойчив
Процедура ВыполнитьИнструментВозвращаетКорректнуюСтруктуру() Экспорт
	Параметры = Новый Структура;
	Результат = AI_Core.ВыполнитьИнструмент("несуществующий_инструмент", Параметры);
	ЮТУтверждения.ЭтоИстина(Результат.Свойство("isError"),
		"Результат должен иметь поле 'isError'");
	ЮТУтверждения.ЭтоИстина(Результат.isError = Истина,
		"Вызов несуществующего инструмента должен вернуть isError=true");
	ЮТУтверждения.ЭтоИстина(Результат.Свойство("content"),
		"Ответ с ошибкой должен содержать поле 'content' с описанием");
КонецПроцедуры

#КонецОбласти
