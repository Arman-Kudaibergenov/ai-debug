#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Устанавливает мастер-запись политики, возвращает прежнее состояние.
//
Функция УстановитьМастерПолитики(Включено)

	Было = AI_Anonymizer.ПолитикаАнонимизацииАктивна();

	Менеджер = РегистрыСведений.AI_AnonymizationPolicy.СоздатьМенеджерЗаписи();
	Менеджер.ОбъектМетаданных = "__GLOBAL__";
	Менеджер.Реквизит = "__MASTER__";
	Менеджер.Включено = Включено;
	Менеджер.Записать();

	Возврат Было;

КонецФункции

// Удаляет записи карты анонимизации тестовой области.
//
Процедура ОчиститьКартуТеста(Область)

	Набор = РегистрыСведений.AI_AnonymizationMap.СоздатьНаборЗаписей();
	Набор.Отбор.Канал.Установить(Область);
	Набор.Записать();

КонецПроцедуры

#КонецОбласти
