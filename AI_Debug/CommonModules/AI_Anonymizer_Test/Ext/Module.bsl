////////////////////////////////////////////////////////////////////////////////
// Модуль AI_Anonymizer_Test: тесты маскировки секретов (AI_Anonymizer).
//
// Запуск: run_unit_tests({"moduleName": "AI_Anonymizer_Test"})
//

#Область СлужебныйПрограммныйИнтерфейс

// Обязательная функция — точка входа для run_unit_tests.
//
Функция ИсполняемыеСценарии() Экспорт
	Возврат ЮТТесты.СписокТестов(
		"ЭтоСекретноеИмя_Пароль_Истина",
		"ЭтоСекретноеИмя_Token_Истина",
		"ЭтоСекретноеИмя_КлючЗаписи_Ложь",
		"ЭтоСекретноеИмя_Наименование_Ложь",
		"МаскироватьСекреты_Структура_КлючЗамаскирован",
		"МаскироватьСекреты_ВложеннаяСтруктура_КлючЗамаскирован",
		"МаскироватьСекреты_ПустоеЗначение_НеМаскируется",
		"МаскироватьСекреты_МассивСтруктур_КлючЗамаскирован",
		"МаскироватьСекреты_Примитив_БезИзменений");
КонецФункции

#КонецОбласти

#Область Тесты

Процедура ЭтоСекретноеИмя_Пароль_Истина() Экспорт
	ЮТУтверждения.ЭтоИстина(AI_Anonymizer.ЭтоСекретноеИмя("Пароль"));
	ЮТУтверждения.ЭтоИстина(AI_Anonymizer.ЭтоСекретноеИмя("ПарольПользователя"));
КонецПроцедуры

Процедура ЭтоСекретноеИмя_Token_Истина() Экспорт
	ЮТУтверждения.ЭтоИстина(AI_Anonymizer.ЭтоСекретноеИмя("AccessToken"));
	ЮТУтверждения.ЭтоИстина(AI_Anonymizer.ЭтоСекретноеИмя("APIKey"));
КонецПроцедуры

Процедура ЭтоСекретноеИмя_КлючЗаписи_Ложь() Экспорт
	// «Ключ» без уточнителя — не секрет: КлючЗаписи, КлючСвязи и т.п.
	ЮТУтверждения.ЭтоЛожь(AI_Anonymizer.ЭтоСекретноеИмя("КлючЗаписи"));
КонецПроцедуры

Процедура ЭтоСекретноеИмя_Наименование_Ложь() Экспорт
	ЮТУтверждения.ЭтоЛожь(AI_Anonymizer.ЭтоСекретноеИмя("Наименование"));
КонецПроцедуры

Процедура МаскироватьСекреты_Структура_КлючЗамаскирован() Экспорт

	Вход = Новый Структура("Логин,Пароль", "user1", "qwerty123");
	Результат = AI_Anonymizer.МаскироватьСекреты(Вход);

	ЮТУтверждения.Равно(Результат.Логин, "user1");
	ЮТУтверждения.Равно(Результат.Пароль, "[SECRET_REMOVED]");
	// исходная структура не изменилась
	ЮТУтверждения.Равно(Вход.Пароль, "qwerty123");

КонецПроцедуры

Процедура МаскироватьСекреты_ВложеннаяСтруктура_КлючЗамаскирован() Экспорт

	Внутренняя = Новый Структура("ТокенДоступа", "abc-token");
	Вход = Новый Структура("Имя,Параметры", "test", Внутренняя);

	Результат = AI_Anonymizer.МаскироватьСекреты(Вход);

	ЮТУтверждения.Равно(Результат.Параметры.ТокенДоступа, "[SECRET_REMOVED]");

КонецПроцедуры

Процедура МаскироватьСекреты_ПустоеЗначение_НеМаскируется() Экспорт

	Вход = Новый Структура("Пароль", "");
	Результат = AI_Anonymizer.МаскироватьСекреты(Вход);

	// пустой секрет не маскируется — маркер не должен выглядеть как значение
	ЮТУтверждения.Равно(Результат.Пароль, "");

КонецПроцедуры

Процедура МаскироватьСекреты_МассивСтруктур_КлючЗамаскирован() Экспорт

	Элемент = Новый Структура("Пользователь,Пароль", "u", "p");
	Массив = Новый Массив;
	Массив.Добавить(Элемент);

	Результат = AI_Anonymizer.МаскироватьСекреты(Массив);

	ЮТУтверждения.Равно(Результат[0].Пароль, "[SECRET_REMOVED]");
	ЮТУтверждения.Равно(Результат[0].Пользователь, "u");

КонецПроцедуры

Процедура МаскироватьСекреты_Примитив_БезИзменений() Экспорт

	ЮТУтверждения.Равно(AI_Anonymizer.МаскироватьСекреты("qwerty123"), "qwerty123");
	ЮТУтверждения.Равно(AI_Anonymizer.МаскироватьСекреты(42), 42);
	ЮТУтверждения.Равно(AI_Anonymizer.МаскироватьСекреты(Неопределено), Неопределено);

КонецПроцедуры

#КонецОбласти
