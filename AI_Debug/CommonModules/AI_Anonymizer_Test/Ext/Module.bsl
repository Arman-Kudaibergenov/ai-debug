Процедура Анонимизация_СвободныйТекстБезПДн_БезИзменений() Экспорт

	Текст = "Продажа 10 штук по цене 500, склад Основной";
	ЮТУтверждения.Равно(AI_Anonymizer.АнонимизироватьТекст(Текст, "unit_test"), Текст);
	// маркер секрета детекторы ПДн не трогают
	ЮТУтверждения.Равно(AI_Anonymizer.АнонимизироватьТекст("[SECRET_REMOVED]", "unit_test"),
		"[SECRET_REMOVED]");

КонецПроцедуры

Процедура Деанонимизация_КруговойПуть_Восстановлено() Экспорт

	ОчиститьКартуТеста("unit_test");
	Попытка
		Исходный = "Контакт: ИНН 1234567890, +7 701 123 45 67, ivan@example.com";
		Анонимизированный = AI_Anonymizer.АнонимизироватьТекст(Исходный, "unit_test");
		Восстановленный = AI_Anonymizer.ДеанонимизироватьТекст(Анонимизированный, "unit_test");
		ЮТУтверждения.Равно(Восстановленный, Исходный);
	Исключение
		ОчиститьКартуТеста("unit_test");
		ВызватьИсключение;
	КонецПопытки;
	ОчиститьКартуТеста("unit_test");

