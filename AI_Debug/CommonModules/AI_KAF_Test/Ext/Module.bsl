////////////////////////////////////////////////////////////////////////////////
// Модуль AI_KAF_Test: бизнес-логические тесты для базы КазАгроФинанс.
//
// Проверяет:
//   - Наличие ключевых справочников (Номенклатура, Контрагенты, Организации)
//   - Целостность документов (все Поступления проведены, имеют контрагента)
//   - Бизнес-правила (суммы документов положительные)
//
// Запуск:
//   run_unit_tests({})                             — все _Test модули
//   run_unit_tests({"moduleName": "AI_KAF_Test"}) — только этот модуль

#Область СлужебныйПрограммныйИнтерфейс

Функция ИсполняемыеСценарии() Экспорт
	Возврат ЮТТесты.СписокТестов(
		"НоменклатураСуществует",
		"КонтрагентыСуществуют",
		"ОрганизацияОпределена",
		"ВсеПоступленияПроведены",
		"ПоступленияИмеютКонтрагента",
		"СуммыПоступленийПоложительные");
КонецФункции

#КонецОбласти

#Область Тесты

// Справочник Номенклатура содержит хотя бы один элемент
Процедура НоменклатураСуществует() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ Справочник.Номенклатура");
	Рез = Запрос.Выполнить().Выбрать();
	Рез.Следующий();
	ЮТУтверждения.Больше(Рез.Кол, 0, "Номенклатура должна содержать хотя бы один элемент");
КонецПроцедуры

// Справочник Контрагенты содержит существенное количество записей
Процедура КонтрагентыСуществуют() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ Справочник.Контрагенты");
	Рез = Запрос.Выполнить().Выбрать();
	Рез.Следующий();
	ЮТУтверждения.Больше(Рез.Кол, 1000, "Ожидается более 1000 контрагентов в базе KAF");
КонецПроцедуры

// Справочник Организации содержит хотя бы одну организацию с непустым наименованием
Процедура ОрганизацияОпределена() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Наименование ИЗ Справочник.Организации ГДЕ НЕ ПометкаУдаления");
	Рез = Запрос.Выполнить().Выбрать();
	ЮТУтверждения.ЭтоИстина(Рез.Следующий(), "Должна быть хотя бы одна действующая организация");
	ЮТУтверждения.Заполнено(Рез.Наименование, "Наименование организации не должно быть пустым");
КонецПроцедуры

// Все документы ПоступлениеТоваровУслуг должны быть проведены
Процедура ВсеПоступленияПроведены() Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол
		|ИЗ Документ.ПоступлениеТоваровУслуг
		|ГДЕ НЕ Проведен");
	Рез = Запрос.Выполнить().Выбрать();
	Рез.Следующий();
	ЮТУтверждения.Равно(Рез.Кол, 0, "Все поступления товаров должны быть проведены. Непроведённых: " + Рез.Кол);
КонецПроцедуры

// Все проведённые поступления имеют заполненного контрагента
Процедура ПоступленияИмеютКонтрагента() Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол
		|ИЗ Документ.ПоступлениеТоваровУслуг
		|ГДЕ Проведен И Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)");
	Рез = Запрос.Выполнить().Выбрать();
	Рез.Следующий();
	ЮТУтверждения.Равно(Рез.Кол, 0, "Все проведённые поступления должны иметь контрагента. Без контрагента: " + Рез.Кол);
КонецПроцедуры

// Суммы всех проведённых поступлений > 0
Процедура СуммыПоступленийПоложительные() Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол
		|ИЗ Документ.ПоступлениеТоваровУслуг
		|ГДЕ Проведен И СуммаДокумента <= 0");
	Рез = Запрос.Выполнить().Выбрать();
	Рез.Следующий();
	ЮТУтверждения.Равно(Рез.Кол, 0, "Суммы всех проведённых поступлений должны быть положительными. Нулевых/отрицательных: " + Рез.Кол);
КонецПроцедуры

#КонецОбласти
