////////////////////////////////////////////////////////////////////////////////
// Модуль AI_Anonymizer: необратимая маскировка секретов на стороне сервера
// (граница ROCTUP по мотивам SteelMorgan/1c-mcp-tools).
//
// Принцип: значение уходит наружу уже заменённым на маркер [SECRET_REMOVED];
// исходное значение в ответ не попадает ни в каком виде.
//
// Покрытие: колонки результата execute_query и значения ключей
// структур/соответствий/массивов в результате execute_code.
// Сопоставление — по имени колонки/ключа (см. МаркерыСекретныхИмен);
// значения-строки без секретного имени не анализируются.
//

#Область ПрограммныйИнтерфейс

// Маркер замены секретного значения
//
Функция МаркерСекрета() Экспорт
	Возврат "[SECRET_REMOVED]";
КонецФункции

// Проверяет имя колонки, реквизита или ключа на признак секрета
// (пароль, токен, ключ API, приватный ключ).
//
// Параметры:
//   Имя - Строка - имя колонки запроса, реквизита или ключа структуры
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоСекретноеИмя(Имя) Экспорт

	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяНРег = НРег(Имя);
	Для Каждого Маркер Из МаркерыСекретныхИмен() Цикл
		Если СтрНайти(ИмяНРег, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает копию значения с замаскированными секретами.
// Структура, Соответствие, Массив — рекурсивно (до 5 уровней);
// прочие типы возвращаются без изменений.
//
// Параметры:
//   Значение - Произвольный - исходное значение
//   Глубина - Число - служебный, текущий уровень рекурсии
//
// Возвращаемое значение:
//   Произвольный - копия с маскировкой или исходное значение
//
Функция МаскироватьСекреты(Значение, Глубина = 0) Экспорт

	Если Глубина > 5 Тогда
		Возврат Значение;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Структура") Тогда

		Копия = Новый Структура;
		Для Каждого КлючЗначение Из Значение Цикл
			Если ЭтоСекретноеИмя(КлючЗначение.Ключ)
				И ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
				Копия.Вставить(КлючЗначение.Ключ, МаркерСекрета());
			Иначе
				Копия.Вставить(КлючЗначение.Ключ,
					МаскироватьСекреты(КлючЗначение.Значение, Глубина + 1));
			КонецЕсли;
		КонецЦикла;
		Возврат Копия;

	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда

		Копия = Новый Соответствие;
		Для Каждого КлючЗначение Из Значение Цикл
			Если ТипЗнч(КлючЗначение.Ключ) = Тип("Строка")
				И ЭтоСекретноеИмя(КлючЗначение.Ключ)
				И ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
				Копия.Вставить(КлючЗначение.Ключ, МаркерСекрета());
			Иначе
				Копия.Вставить(КлючЗначение.Ключ,
					МаскироватьСекреты(КлючЗначение.Значение, Глубина + 1));
			КонецЕсли;
		КонецЦикла;
		Возврат Копия;

	ИначеЕсли ТипЗначения = Тип("Массив") Тогда

		Копия = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Копия.Добавить(МаскироватьСекреты(Элемент, Глубина + 1));
		КонецЦикла;
		Возврат Копия;

	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подстроки (НРег), по которым имя признаётся секретным.
// «Ключ» без уточнителя не входит: слишком много ложных срабатываний
// (КлючЗаписи, КлючСвязи, КлючСтроки).
//
Функция МаркерыСекретныхИмен()

	Маркеры = Новый Массив;
	Маркеры.Добавить("парол");
	Маркеры.Добавить("password");
	Маркеры.Добавить("passwd");
	Маркеры.Добавить("токен");
	Маркеры.Добавить("token");
	Маркеры.Добавить("secret");
	Маркеры.Добавить("секрет");
	Маркеры.Добавить("apikey");
	Маркеры.Добавить("api_key");
	Маркеры.Добавить("api-ключ");
	Маркеры.Добавить("ключapi");
	Маркеры.Добавить("приватныйключ");
	Маркеры.Добавить("privatekey");
	Маркеры.Добавить("private_key");
	Маркеры.Добавить("authorization");

	Возврат Маркеры;

КонецФункции

#КонецОбласти
