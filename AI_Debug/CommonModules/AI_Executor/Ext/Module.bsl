// AI_Executor — выполнение произвольного серверного кода BSL
// Tools: execute_code
//
// ВНИМАНИЕ: инструмент выполняет произвольный код на сервере с правами
// пользователя HTTP-сервиса. Ограничения: Basic-аутентификация HTTP-сервиса ai
// и режим «только чтение» (AI_Security.РежимТолькоЧтение — при включении
// execute_code блокируется вместе с пишущими инструментами).
// Таймаут выполнения в BSL недоступен — бесконечный цикл в коде
// завершится только по таймауту HTTP-сервиса/сеанса.

Функция ОписаниеИнструментов() Экспорт

	Инструменты = Новый Массив;

	// execute_code
	ИнструментCode = Новый Структура;
	ИнструментCode.Вставить("name", "execute_code");
	ИнструментCode.Вставить("description", "Выполняет произвольный код на встроенном языке 1С на сервере. Сначала пробует вычислить как выражение (mode=eval), при синтаксической ошибке выполняет как блок операторов (mode=exec) — в этом режиме результат можно вернуть через переменную Результат. Пример: ""2+2"" или ""Результат = ТекущаяДатаСеанса();""");
	СхемаCode = Новый Структура;
	СхемаCode.Вставить("type", "object");
	СвойстваCode = Новый Структура;
	СвойстваCode.Вставить("code", Новый Структура("type,description", "string", "Код на встроенном языке 1С (BSL)"));
	СхемаCode.Вставить("properties", СвойстваCode);
	СхемаCode.Вставить("required", AI_Utils.ПолучитьМассив("code"));
	ИнструментCode.Вставить("inputSchema", СхемаCode);
	Инструменты.Добавить(ИнструментCode);

	Возврат Инструменты;

КонецФункции

Функция ВыполнитьИнструмент(ИмяИнструмента, Параметры) Экспорт

	Если ИмяИнструмента = "execute_code" Тогда
		Возврат ВыполнитьКод(Параметры);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", "Не реализован инструмент: " + ИмяИнструмента);
	Возврат Ответ;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьКод(Параметры)

	Код = Параметры.code;

	// Режим eval: код — выражение
	Попытка
		ЗначениеРезультата = Вычислить(Код);
		Возврат ОтветУспех(ЗначениеРезультата, "eval");
	Исключение
		ОшибкаEval = ОписаниеОшибки();
	КонецПопытки;

	// Режим exec: код — блок операторов, результат через переменную Результат
	Попытка
		Результат = Неопределено;
		Выполнить(Код);
		Возврат ОтветУспех(Результат, "exec");
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "eval: " + ОшибкаEval + Символы.ПС + "exec: " + ОписаниеОшибки());
		Ответ.Вставить("errorCode", "execution_error");
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция ОтветУспех(ЗначениеРезультата, Режим)

	// Граница ROCTUP: секретные ключи структур маскируются до отдачи наружу
	ЗначениеРезультата = AI_Anonymizer.МаскироватьСекреты(ЗначениеРезультата);

	ДанныеРезультата = Новый Структура;
	ДанныеРезультата.Вставить("mode", Режим);

	ТипРезультата = ТипЗнч(ЗначениеРезультата);
	ДанныеРезультата.Вставить("type", Строка(ТипРезультата));

	Если ЗначениеРезультата = Неопределено
		ИЛИ ТипРезультата = Тип("Строка")
		ИЛИ ТипРезультата = Тип("Число")
		ИЛИ ТипРезультата = Тип("Булево")
		ИЛИ ТипРезультата = Тип("Дата") Тогда
		ДанныеРезультата.Вставить("result", ЗначениеРезультата);
	Иначе
		ДанныеРезультата.Вставить("result", Строка(ЗначениеРезультата));
	КонецЕсли;

	// Ограничение размера текстового результата
	Если ТипЗнч(ДанныеРезультата.result) = Тип("Строка")
		И СтрДлина(ДанныеРезультата.result) > 16000 Тогда
		ДанныеРезультата.Вставить("result",
			Лев(ДанныеРезультата.result, 16000)
			+ Символы.ПС + "... (обрезано до 16000 символов)");
		ДанныеРезультата.Вставить("truncated", Истина);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("data", ДанныеРезультата);
	Возврат Ответ;

КонецФункции

#КонецОбласти
