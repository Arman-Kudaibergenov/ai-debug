Функция ВыполнитьИнструмент(ИмяИнструмента, Параметры) Экспорт

	Если ИмяИнструмента = "get_document" Тогда
		Возврат ПолучитьДокумент(Параметры);
	ИначеЕсли ИмяИнструмента = "create_document" Тогда
		Возврат СоздатьДокумент(Параметры);
	ИначеЕсли ИмяИнструмента = "update_document" Тогда
		Возврат ОбновитьДокумент(Параметры);
	ИначеЕсли ИмяИнструмента = "post_document" Тогда
		Возврат ПровестиДокумент(Параметры);
	ИначеЕсли ИмяИнструмента = "unpost_document" Тогда
		Возврат ОтменитьПроведениеДокумента(Параметры);
	ИначеЕсли ИмяИнструмента = "qec_export_timesheet" Тогда
		Возврат ЭкспортироватьТабельQEC(Параметры);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", "Не реализован инструмент: " + ИмяИнструмента);
	Возврат Ответ;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДокумент(Параметры)

	ТипДокумента = Параметры.documentType;
	СтрокаСсылки = Параметры.documentRef;

	МетаОбъект = Метаданные.Документы.Найти(ТипДокумента);
	Если МетаОбъект = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Документ не найден в метаданных: " + ТипДокумента);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаСсылки);
		Ссылка = Документы[ТипДокумента].ПолучитьСсылку(УИД);
		Объект = Ссылка.ПолучитьОбъект();

		Если Объект = Неопределено Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Документ не найден: " + СтрокаСсылки);
			Возврат Ответ;
		КонецЕсли;

		Строки = Новый Массив;
		Строки.Добавить("Документ: " + ТипДокумента);
		Строки.Добавить("GUID: " + Строка(Ссылка.УникальныйИдентификатор()));
		Строки.Добавить("Номер: " + Строка(Объект.Номер));
		Строки.Добавить("Дата: " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy HH:mm:ss"));
		Строки.Добавить("Проведен: " + AI_Utils.ФорматироватьЗначение(Объект.Проведен));
		Строки.Добавить("ПометкаУдаления: " + AI_Utils.ФорматироватьЗначение(Объект.ПометкаУдаления));

		Если МетаОбъект.Реквизиты.Количество() > 0 Тогда
			Строки.Добавить("");
			Строки.Добавить("=== Реквизиты ===");
			Для Каждого Реквизит Из МетаОбъект.Реквизиты Цикл
				Строки.Добавить(Реквизит.Имя + ": " + AI_Utils.ФорматироватьЗначение(Объект[Реквизит.Имя]));
			КонецЦикла;
		КонецЕсли;

		Для Каждого ТабЧасть Из МетаОбъект.ТабличныеЧасти Цикл
			КолСтрок = Объект[ТабЧасть.Имя].Количество();
			Строки.Добавить("");
			Строки.Добавить("=== ТЧ: " + ТабЧасть.Имя + " (" + Формат(КолСтрок, "ЧГ=") + " строк) ===");
			Если КолСтрок > 0 Тогда
				Колонки = Новый Массив;
				Для Каждого Реквизит Из ТабЧасть.Реквизиты Цикл
					Колонки.Добавить(Реквизит.Имя);
				КонецЦикла;
				Для Каждого СтрТЧ Из Объект[ТабЧасть.Имя] Цикл
					ЧастиСтроки = Новый Массив;
					Для Каждого ИмяКол Из Колонки Цикл
						ЧастиСтроки.Добавить(ИмяКол + ": " + AI_Utils.ФорматироватьЗначение(СтрТЧ[ИмяКол]));
					КонецЦикла;
					Строки.Добавить(СтрСоединить(ЧастиСтроки, " | "));
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
		Возврат Ответ;

	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка получения документа: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция СоздатьДокумент(Параметры)

	ТипДокумента = Параметры.documentType;

	МетаОбъект = Метаданные.Документы.Найти(ТипДокумента);
	Если МетаОбъект = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Документ не найден в метаданных: " + ТипДокумента);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		НовыйДокумент = Документы[ТипДокумента].СоздатьДокумент();
		НовыйДокумент.Дата = ТекущаяДатаСеанса();

		Если Параметры.Свойство("header") И ТипЗнч(Параметры.header) = Тип("Структура") Тогда
			AI_Utils.УстановитьРеквизиты(НовыйДокумент, МетаОбъект, Параметры.header);
		КонецЕсли;

		Если Параметры.Свойство("tables") И ТипЗнч(Параметры.tables) = Тип("Структура") Тогда
			Для Каждого КЗТаб Из Параметры.tables Цикл
				ИмяТЧ = КЗТаб.Ключ;
				МетаТЧ = МетаОбъект.ТабличныеЧасти.Найти(ИмяТЧ);
				Если МетаТЧ = Неопределено ИЛИ ТипЗнч(КЗТаб.Значение) <> Тип("Массив") Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого СтрокаДанных Из КЗТаб.Значение Цикл
					НовСтрока = НовыйДокумент[ИмяТЧ].Добавить();
					Если ТипЗнч(СтрокаДанных) = Тип("Структура") Тогда
						Для Каждого КЗРеквизит Из СтрокаДанных Цикл
							МетаРеквизит = МетаТЧ.Реквизиты.Найти(КЗРеквизит.Ключ);
							Если МетаРеквизит = Неопределено Тогда
								Попытка
									НовСтрока[КЗРеквизит.Ключ] = КЗРеквизит.Значение;
								Исключение
								КонецПопытки;
							Иначе
								Попытка
									НовСтрока[КЗРеквизит.Ключ] = AI_Utils.КонвертироватьЗначение(МетаРеквизит.Тип, КЗРеквизит.Значение);
								Исключение
								КонецПопытки;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;

		НовыйДокумент.Записать();

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("ref", Строка(НовыйДокумент.Ссылка.УникальныйИдентификатор()));
		Ответ.Вставить("number", Строка(НовыйДокумент.Номер));
		Ответ.Вставить("message", "Документ " + ТипДокумента + " создан, номер: " + НовыйДокумент.Номер);
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка создания документа: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция ОбновитьДокумент(Параметры)

	ТипДокумента = Параметры.documentType;
	СтрокаСсылки = Параметры.documentRef;

	МетаОбъект = Метаданные.Документы.Найти(ТипДокумента);
	Если МетаОбъект = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Документ не найден в метаданных: " + ТипДокумента);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаСсылки);
		Ссылка = Документы[ТипДокумента].ПолучитьСсылку(УИД);
		ДокументОбъект = Ссылка.ПолучитьОбъект();

		Если ДокументОбъект = Неопределено Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Документ не найден: " + СтрокаСсылки);
			Возврат Ответ;
		КонецЕсли;

		Если Параметры.Свойство("header") И ТипЗнч(Параметры.header) = Тип("Структура") Тогда
			AI_Utils.УстановитьРеквизиты(ДокументОбъект, МетаОбъект, Параметры.header);
		КонецЕсли;

		Если Параметры.Свойство("tables") И ТипЗнч(Параметры.tables) = Тип("Структура") Тогда
			Для Каждого КЗТаб Из Параметры.tables Цикл
				ИмяТЧ = КЗТаб.Ключ;
				МетаТЧ = МетаОбъект.ТабличныеЧасти.Найти(ИмяТЧ);
				Если МетаТЧ = Неопределено ИЛИ ТипЗнч(КЗТаб.Значение) <> Тип("Массив") Тогда
					Продолжить;
				КонецЕсли;
				ДокументОбъект[ИмяТЧ].Очистить();
				Для Каждого СтрокаДанных Из КЗТаб.Значение Цикл
					НовСтрока = ДокументОбъект[ИмяТЧ].Добавить();
					Если ТипЗнч(СтрокаДанных) = Тип("Структура") Тогда
						Для Каждого КЗРеквизит Из СтрокаДанных Цикл
							МетаРеквизит = МетаТЧ.Реквизиты.Найти(КЗРеквизит.Ключ);
							Если МетаРеквизит = Неопределено Тогда
								Попытка
									НовСтрока[КЗРеквизит.Ключ] = КЗРеквизит.Значение;
								Исключение
								КонецПопытки;
							Иначе
								Попытка
									НовСтрока[КЗРеквизит.Ключ] = AI_Utils.КонвертироватьЗначение(МетаРеквизит.Тип, КЗРеквизит.Значение);
								Исключение
								КонецПопытки;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;

		ДокументОбъект.Записать();

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("ref", Строка(Ссылка.УникальныйИдентификатор()));
		Ответ.Вставить("message", "Документ " + ТипДокумента + " обновлён");
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка обновления документа: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция ПровестиДокумент(Параметры)

	ТипДокумента = Параметры.documentType;
	СтрокаСсылки = Параметры.documentRef;

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаСсылки);
		Ссылка = Документы[ТипДокумента].ПолучитьСсылку(УИД);
		ДокументОбъект = Ссылка.ПолучитьОбъект();

		Если ДокументОбъект = Неопределено Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Документ не найден: " + СтрокаСсылки);
			Возврат Ответ;
		КонецЕсли;

		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("message", "Документ " + ТипДокумента + " проведён");
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка проведения документа: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция ОтменитьПроведениеДокумента(Параметры)

	ТипДокумента = Параметры.documentType;
	СтрокаСсылки = Параметры.documentRef;

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаСсылки);
		Ссылка = Документы[ТипДокумента].ПолучитьСсылку(УИД);
		ДокументОбъект = Ссылка.ПолучитьОбъект();

		Если ДокументОбъект = Неопределено Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Документ не найден: " + СтрокаСсылки);
			Возврат Ответ;
		КонецЕсли;

		ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("message", "Проведение документа " + ТипДокумента + " отменено");
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка отмены проведения документа: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция ЭкспортироватьТабельQEC(Параметры)

	Попытка
		УИД = Новый УникальныйИдентификатор(Параметры.documentRef);
		ДокСсылка = Документы.ТабельУчетаРабочегоВремени.ПолучитьСсылку(УИД);
		Тело = QECПолучитьТелоТабельУчетаРабочегоВремени(ДокСсылка);

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", Тело);
		Ответ.Вставить("message", "Экспортировано строк времени: " + Формат(Тело.СтрокиВремени.Количество(), "ЧГ=0"));
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка экспорта табеля QEC: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция QECПолучитьТелоТабельУчетаРабочегоВремени(ДокСсылка)

	ЗапросДокумента = Новый Запрос;
	ЗапросДокумента.Текст =
	"ВЫБРАТЬ
	|	ТабельУчетаРабочегоВремени.Ссылка КАК Ссылка,
	|	ТабельУчетаРабочегоВремени.Организация КАК Организация,
	|	"""" КАК ОрганизацияКод,
	|	ТабельУчетаРабочегоВремени.Организация.Наименование КАК ОрганизацияНаименование,
	|	ТабельУчетаРабочегоВремени.Подразделение КАК Подразделение,
	|	ТабельУчетаРабочегоВремени.Подразделение.Код КАК ПодразделениеКод,
	|	ТабельУчетаРабочегоВремени.Подразделение.Наименование КАК ПодразделениеНаименование,
	|	ТабельУчетаРабочегоВремени.ПериодРегистрации КАК ПериодРегистрации,
	|	ТабельУчетаРабочегоВремени.ДатаНачалаПериода КАК ДатаНачалаПериода,
	|	ТабельУчетаРабочегоВремени.ДатаОкончанияПериода КАК ДатаОкончанияПериода
	|ИЗ
	|	Документ.ТабельУчетаРабочегоВремени КАК ТабельУчетаРабочегоВремени
	|ГДЕ
	|	ТабельУчетаРабочегоВремени.Ссылка = &Ссылка";
	ЗапросДокумента.УстановитьПараметр("Ссылка", ДокСсылка);

	ВыборкаДокумента = ЗапросДокумента.Выполнить().Выбрать();
	Если Не ВыборкаДокумента.Следующий() Тогда
		ВызватьИсключение "Документ ТабельУчетаРабочегоВремени не найден: " + Строка(ДокСсылка);
	КонецЕсли;

	ПараметрыИмпорта = Новый Структура;
	ПараметрыИмпорта.Вставить("ВнешнийИдентификаторZUP", Строка(ДокСсылка.УникальныйИдентификатор()));
	ПараметрыИмпорта.Вставить("ОрганизацияКод", ВыборкаДокумента.ОрганизацияКод);
	ПараметрыИмпорта.Вставить("ОрганизацияНаименование", ВыборкаДокумента.ОрганизацияНаименование);
	ПараметрыИмпорта.Вставить("ПодразделениеКод", ВыборкаДокумента.ПодразделениеКод);
	ПараметрыИмпорта.Вставить("ПодразделениеНаименование", ВыборкаДокумента.ПодразделениеНаименование);
	ПараметрыИмпорта.Вставить("ПериодРегистрации", ВыборкаДокумента.ПериодРегистрации);

	СтрокиВремени = Новый Массив;
	QECЗаполнитьСтрокиВремениТабеляZUP(ДокСсылка, ВыборкаДокумента, СтрокиВремени);

	Возврат Новый Структура("ПараметрыИмпорта,СтрокиВремени", ПараметрыИмпорта, СтрокиВремени);

КонецФункции

Процедура QECЗаполнитьСтрокиВремениТабеляZUP(ДокСсылка, ДанныеДокумента, СтрокиВремени)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеОВремени.Сотрудник КАК Сотрудник,
	|	ДанныеОВремени.Сотрудник.Код КАК КодСотрудникаZUP,
	|	ДанныеОВремени.Сотрудник.ФизическоеЛицо.ИНН КАК ФизическоеЛицоИНН,
	|	ДанныеОВремени.Сотрудник.ФизическоеЛицо.Наименование КАК ФизическоеЛицоНаименование,
	|	ДанныеОВремени.Сотрудник.Наименование КАК СотрудникНаименование,
	|	ДанныеОВремени.*
	|ИЗ
	|	Документ.ТабельУчетаРабочегоВремени.ДанныеОВремени КАК ДанныеОВремени
	|ГДЕ
	|	ДанныеОВремени.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для НомерДня = 1 По 31 Цикл
			Если НомерДня > День(КонецМесяца(ДанныеДокумента.ДатаНачалаПериода)) Тогда
				Продолжить;
			КонецЕсли;

			Часы = QECЗначениеРеквизитаСтрокиТабеля(Выборка, "Часов" + Строка(НомерДня), 0);
			Если Часы = 0 Тогда
				Продолжить;
			КонецЕсли;

			ДатаВремени = Дата(Год(ДанныеДокумента.ДатаНачалаПериода), Месяц(ДанныеДокумента.ДатаНачалаПериода), НомерДня);
			Если ДатаВремени < ДанныеДокумента.ДатаНачалаПериода Или ДатаВремени > ДанныеДокумента.ДатаОкончанияПериода Тогда
				Продолжить;
			КонецЕсли;

			ВидВремени = QECЗначениеРеквизитаСтрокиТабеля(Выборка, "ВидВремени" + Строка(НомерДня), Неопределено);
			Если Не ЗначениеЗаполнено(ВидВремени) Тогда
				Продолжить;
			КонецЕсли;

			СтрокаВремени = Новый Структура;
			СтрокаВремени.Вставить("Дата", ДатаВремени);
			СтрокаВремени.Вставить("НачалоПериода", НачалоДня(ДатаВремени));
			СтрокаВремени.Вставить("КонецПериода", КонецДня(ДатаВремени));
			СтрокаВремени.Вставить("Часы", Часы);
			СтрокаВремени.Вставить("Дни", 1);
			СтрокаВремени.Вставить("ВидВремениZUP", Строка(ВидВремени));
			СтрокаВремени.Вставить("ВидВремениZUPКод", QECКодВидаВремениZUP(ВидВремени));
			СтрокаВремени.Вставить("КодСотрудникаZUP", Выборка.КодСотрудникаZUP);
			СтрокаВремени.Вставить("ФизическоеЛицоИНН", Выборка.ФизическоеЛицоИНН);
			СтрокаВремени.Вставить("ФизическоеЛицоНаименование", Выборка.ФизическоеЛицоНаименование);
			СтрокаВремени.Вставить("СотрудникНаименование", Выборка.СотрудникНаименование);
			СтрокаВремени.Вставить("ПодразделениеКод", ДанныеДокумента.ПодразделениеКод);
			СтрокаВремени.Вставить("ПодразделениеНаименование", ДанныеДокумента.ПодразделениеНаименование);
			СтрокиВремени.Добавить(СтрокаВремени);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция QECЗначениеРеквизитаСтрокиТабеля(СтрокаТабеля, ИмяРеквизита, ЗначениеПоУмолчанию)

	Попытка
		Возврат СтрокаТабеля[ИмяРеквизита];
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;

КонецФункции

Функция QECКодВидаВремениZUP(ВидВремени)

	Попытка
		Если ЗначениеЗаполнено(ВидВремени.Код) Тогда
			Возврат ВидВремени.Код;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Строка(ВидВремени);

КонецФункции

#КонецОбласти
