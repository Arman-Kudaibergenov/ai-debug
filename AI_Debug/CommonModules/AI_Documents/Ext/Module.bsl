	СвойстваUpdDoc.Вставить("header", Новый Структура("type,description", "object", "Реквизиты шапки для обновления: {ИмяРеквизита: Значение}"));
	СвойстваUpdDoc.Вставить("tables", Новый Структура("type,description", "object", "Табличные части: {ИмяТЧ: [{ИмяРеквизита: Значение}]}. ПОЛНАЯ ЗАМЕНА содержимого!"));
	СхемаUpdDoc.Вставить("properties", СвойстваUpdDoc);
	СхемаUpdDoc.Вставить("required", AI_Utils.ПолучитьМассив("documentType", "documentRef"));
	ИнстрUpdDoc.Вставить("inputSchema", СхемаUpdDoc);
	Инструменты.Добавить(ИнстрUpdDoc);

	// post_document
	ИнстрPost = Новый Структура;
	ИнстрPost.Вставить("name", "post_document");
