// AI_Documents — tools for working with documents
// Tools: get_document, create_document, update_document, post_document, unpost_document

Функция ОписаниеИнструментов() Экспорт

	Инструменты = Новый Массив;

	// get_document
	ИнструментDocument = Новый Структура;
	ИнструментDocument.Вставить("name", "get_document");
	ИнструментDocument.Вставить("description", "Возвращает шапку и табличные части документа по GUID. GUID получается из execute_query.");
	СхемаDocument = Новый Структура;
	СхемаDocument.Вставить("type", "object");
	СвойстваDocument = Новый Структура;
	СвойстваDocument.Вставить("documentType", Новый Структура("type,description", "string", "Имя документа (например ПоступлениеТоваровУслуг)"));
	СвойстваDocument.Вставить("documentRef", Новый Структура("type,description", "string", "GUID документа"));
	СхемаDocument.Вставить("properties", СвойстваDocument);
	СхемаDocument.Вставить("required", AI_Utils.ПолучитьМассив("documentType", "documentRef"));
	ИнструментDocument.Вставить("inputSchema", СхемаDocument);
	Инструменты.Добавить(ИнструментDocument);

	// create_document
	ИнстрDocCreate = Новый Структура;
	ИнстрDocCreate.Вставить("name", "create_document");
	ИнстрDocCreate.Вставить("description", "Создаёт новый документ с шапкой и табличными частями. Возвращает GUID и номер документа. Документ записывается без проведения — для проведения используй post_document.");
	СхемаDocCreate = Новый Структура("type", "object");
	СвойстваDocCreate = Новый Структура;
	СвойстваDocCreate.Вставить("documentType", Новый Структура("type,description", "string", "Имя документа (например ПоступлениеТоваровУслуг)"));
	СвойстваDocCreate.Вставить("header", Новый Структура("type,description", "object", "Реквизиты шапки: {ИмяРеквизита: Значение}. Ссылочные поля — GUID-строка."));
	СвойстваDocCreate.Вставить("tables", Новый Структура("type,description", "object", "Табличные части: {ИмяТЧ: [{ИмяРеквизита: Значение}]}"));
	СхемаDocCreate.Вставить("properties", СвойстваDocCreate);
	СхемаDocCreate.Вставить("required", AI_Utils.ПолучитьМассив("documentType"));
	ИнстрDocCreate.Вставить("inputSchema", СхемаDocCreate);
	Инструменты.Добавить(ИнстрDocCreate);

	// update_document
	ИнстрUpdDoc = Новый Структура;
	ИнстрUpdDoc.Вставить("name", "update_document");
	ИнстрUpdDoc.Вставить("description", "Обновляет документ (шапку и/или табличные части). Табличные части ЗАМЕНЯЮТСЯ ЦЕЛИКОМ — если нужно добавить строку, сначала получи текущие данные через get_document. Документ записывается БЕЗ проведения.");
	СхемаUpdDoc = Новый Структура("type", "object");
	СвойстваUpdDoc = Новый Структура;
	СвойстваUpdDoc.Вставить("documentType", Новый Структура("type,description", "string", "Имя документа"));
	СвойстваUpdDoc.Вставить("documentRef", Новый Структура("type,description", "string", "GUID документа"));
	СвойстваUpdDoc.Вставить("header", Новый Структура("type,description", "object", "Реквизиты шапки для обновления: {ИмяРеквизита: Значение} Ссылочное/составное поле — GUID с типом: ""Справочник.Имя:GUID"" / ""Документ.Имя:GUID"" / ""Перечисление.Имя.Значение""."));
	СвойстваUpdDoc.Вставить("tables", Новый Структура("type,description", "object", "Табличные части: {ИмяТЧ: [{ИмяРеквизита: Значение}]}. ПОЛНАЯ ЗАМЕНА содержимого! Ссылочное/составное поле — GUID с типом: ""Справочник.Имя:GUID"" / ""Документ.Имя:GUID"" / ""Перечисление.Имя.Значение""."));
	СхемаUpdDoc.Вставить("properties", СвойстваUpdDoc);
	СхемаUpdDoc.Вставить("required", AI_Utils.ПолучитьМассив("documentType", "documentRef"));
	ИнстрUpdDoc.Вставить("inputSchema", СхемаUpdDoc);
	Инструменты.Добавить(ИнстрUpdDoc);

	// post_document
	ИнстрPost = Новый Структура;
	ИнстрPost.Вставить("name", "post_document");
	ИнстрPost.Вставить("description", "Проводит документ (РежимЗаписиДокумента.Проведение). Запускает все обработчики проведения и движения по регистрам. GUID получается из create_document или execute_query.");
	СхемаPost = Новый Структура("type", "object");
	СвойстваPost = Новый Структура;
	СвойстваPost.Вставить("documentType", Новый Структура("type,description", "string", "Имя документа"));
	СвойстваPost.Вставить("documentRef", Новый Структура("type,description", "string", "GUID документа"));
	СхемаPost.Вставить("properties", СвойстваPost);
	СхемаPost.Вставить("required", AI_Utils.ПолучитьМассив("documentType", "documentRef"));
	ИнстрPost.Вставить("inputSchema", СхемаPost);
	Инструменты.Добавить(ИнстрPost);

	// unpost_document
	ИнстрUnpost = Новый Структура;
	ИнстрUnpost.Вставить("name", "unpost_document");
	ИнстрUnpost.Вставить("description", "Отменяет проведение документа (РежимЗаписиДокумента.ОтменаПроведения). Удаляет движения по регистрам. GUID получается из execute_query.");
	СхемаUnpost = Новый Структура("type", "object");
	СвойстваUnpost = Новый Структура;
	СвойстваUnpost.Вставить("documentType", Новый Структура("type,description", "string", "Имя документа"));
	СвойстваUnpost.Вставить("documentRef", Новый Структура("type,description", "string", "GUID документа"));
	СхемаUnpost.Вставить("properties", СвойстваUnpost);
	СхемаUnpost.Вставить("required", AI_Utils.ПолучитьМассив("documentType", "documentRef"));
	ИнстрUnpost.Вставить("inputSchema", СхемаUnpost);
	Инструменты.Добавить(ИнстрUnpost);

	Возврат Инструменты;

КонецФункции

Функция ВыполнитьИнструмент(ИмяИнструмента, Параметры) Экспорт

	Если ИмяИнструмента = "get_document" Тогда
		Возврат ПолучитьДокумент(Параметры);
	ИначеЕсли ИмяИнструмента = "create_document" Тогда
		Возврат СоздатьДокумент(Параметры);
	ИначеЕсли ИмяИнструмента = "update_document" Тогда
		Возврат ОбновитьДокумент(Параметры);
	ИначеЕсли ИмяИнструмента = "post_document" Тогда
		Возврат ПровестиДокумент(Параметры);
	ИначеЕсли ИмяИнструмента = "unpost_document" Тогда
		Возврат ОтменитьПроведениеДокумента(Параметры);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", "Не реализован инструмент: " + ИмяИнструмента);
	Возврат Ответ;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДокумент(Параметры)

	ТипДокумента = Параметры.documentType;
	СтрокаСсылки = Параметры.documentRef;

	МетаОбъект = Метаданные.Документы.Найти(ТипДокумента);
	Если МетаОбъект = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Документ не найден в метаданных: " + ТипДокумента);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаСсылки);
		Ссылка = Документы[ТипДокумента].ПолучитьСсылку(УИД);
		Объект = Ссылка.ПолучитьОбъект();

		Если Объект = Неопределено Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Документ не найден: " + СтрокаСсылки);
			Возврат Ответ;
		КонецЕсли;

		Строки = Новый Массив;
		Строки.Добавить("Документ: " + ТипДокумента);
		Строки.Добавить("GUID: " + Строка(Ссылка.УникальныйИдентификатор()));
		Строки.Добавить("Номер: " + Строка(Объект.Номер));
		Строки.Добавить("Дата: " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy HH:mm:ss"));
		Строки.Добавить("Проведен: " + AI_Utils.ФорматироватьЗначение(Объект.Проведен));
		Строки.Добавить("ПометкаУдаления: " + AI_Utils.ФорматироватьЗначение(Объект.ПометкаУдаления));

		Если МетаОбъект.Реквизиты.Количество() > 0 Тогда
			Строки.Добавить("");
			Строки.Добавить("=== Реквизиты ===");
			Для Каждого Реквизит Из МетаОбъект.Реквизиты Цикл
				Строки.Добавить(Реквизит.Имя + ": " + AI_Anonymizer.ФорматироватьДляВывода(Реквизит.Имя, Объект[Реквизит.Имя]));
			КонецЦикла;
		КонецЕсли;

		Для Каждого ТабЧасть Из МетаОбъект.ТабличныеЧасти Цикл
			КолСтрок = Объект[ТабЧасть.Имя].Количество();
			Строки.Добавить("");
			Строки.Добавить("=== ТЧ: " + ТабЧасть.Имя + " (" + Формат(КолСтрок, "ЧГ=") + " строк) ===");
			Если КолСтрок > 0 Тогда
				Колонки = Новый Массив;
				Для Каждого Реквизит Из ТабЧасть.Реквизиты Цикл
					Колонки.Добавить(Реквизит.Имя);
				КонецЦикла;
				Для Каждого СтрТЧ Из Объект[ТабЧасть.Имя] Цикл
					ЧастиСтроки = Новый Массив;
					Для Каждого ИмяКол Из Колонки Цикл
						ЧастиСтроки.Добавить(ИмяКол + ": " + AI_Anonymizer.ФорматироватьДляВывода(ИмяКол, СтрТЧ[ИмяКол]));
					КонецЦикла;
					Строки.Добавить(СтрСоединить(ЧастиСтроки, " | "));
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
		Возврат Ответ;

	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка получения документа: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция СоздатьДокумент(Параметры)

	ТипДокумента = Параметры.documentType;

	МетаОбъект = Метаданные.Документы.Найти(ТипДокумента);
	Если МетаОбъект = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Документ не найден в метаданных: " + ТипДокумента);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		НовыйДокумент = Документы[ТипДокумента].СоздатьДокумент();
		НовыйДокумент.Дата = ТекущаяДатаСеанса();

		ОшибкиПолей = Новый Массив;
		Если Параметры.Свойство("header") И ТипЗнч(Параметры.header) = Тип("Структура") Тогда
			AI_Utils.УстановитьРеквизиты(НовыйДокумент, МетаОбъект, Параметры.header, ОшибкиПолей);
		КонецЕсли;

		Если Параметры.Свойство("tables") И ТипЗнч(Параметры.tables) = Тип("Структура") Тогда
			Для Каждого КЗТаб Из Параметры.tables Цикл
				ИмяТЧ = КЗТаб.Ключ;
				МетаТЧ = МетаОбъект.ТабличныеЧасти.Найти(ИмяТЧ);
				Если МетаТЧ = Неопределено ИЛИ ТипЗнч(КЗТаб.Значение) <> Тип("Массив") Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого СтрокаДанных Из КЗТаб.Значение Цикл
					НовСтрока = НовыйДокумент[ИмяТЧ].Добавить();
					Если ТипЗнч(СтрокаДанных) = Тип("Структура") Тогда
						Для Каждого КЗРеквизит Из СтрокаДанных Цикл
							МетаРеквизит = МетаТЧ.Реквизиты.Найти(КЗРеквизит.Ключ);
							Если МетаРеквизит = Неопределено Тогда
								Попытка
									НовСтрока[КЗРеквизит.Ключ] = КЗРеквизит.Значение;
								Исключение
									// Не глотать ошибку установки поля — накапливать в ОшибкиПолей
									Если ТипЗнч(ОшибкиПолей) = Тип("Массив") Тогда
										ОшибкиПолей.Добавить("Поле '" + КЗРеквизит.Ключ + "': " + ОписаниеОшибки());
									КонецЕсли;
								КонецПопытки;
							Иначе
								Попытка
									НовСтрока[КЗРеквизит.Ключ] = AI_Utils.КонвертироватьЗначение(МетаРеквизит.Тип, КЗРеквизит.Значение);
								Исключение
									// Не глотать ошибку установки поля — накапливать в ОшибкиПолей
									Если ТипЗнч(ОшибкиПолей) = Тип("Массив") Тогда
										ОшибкиПолей.Добавить("Поле '" + КЗРеквизит.Ключ + "': " + ОписаниеОшибки());
									КонецЕсли;
								КонецПопытки;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;

		// Заполнение наборов движений по регистрам (для документов-регистраторов, в т.ч. непроводимых корректировок)
		КолвоДвижений = 0;
		Если Параметры.Свойство("movements") Тогда
			ДвиженияДанные = Параметры.movements;
			// MCP передаёт вложенный object-параметр строкой JSON — разбираем
			Если ТипЗнч(ДвиженияДанные) = Тип("Строка") Тогда
				Попытка
					ДвиженияДанные = РазобратьJSONВЗначение(ДвиженияДанные);
				Исключение
					ДвиженияДанные = Неопределено;
				КонецПопытки;
			КонецЕсли;
			Если ТипЗнч(ДвиженияДанные) = Тип("Структура") ИЛИ ТипЗнч(ДвиженияДанные) = Тип("Соответствие")
				ИЛИ ТипЗнч(ДвиженияДанные) = Тип("ФиксированнаяСтруктура") Тогда
				КолвоДвижений = ЗаполнитьДвиженияДокумента(НовыйДокумент, ДвиженияДанные, ОшибкиПолей);
			КонецЕсли;
		КонецЕсли;

		НовыйДокумент.Записать();

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("ref", Строка(НовыйДокумент.Ссылка.УникальныйИдентификатор()));
		Ответ.Вставить("number", Строка(НовыйДокумент.Номер));
		Ответ.Вставить("message", "Документ " + ТипДокумента + " создан, номер: " + НовыйДокумент.Номер + ", движений записано: " + КолвоДвижений);
		// Показать поля, которые не удалось установить (напр. составной тип без явного типа)
		Если ОшибкиПолей.Количество() > 0 Тогда
			Ответ.Вставить("fieldErrors", ОшибкиПолей);
			Ответ["message"] = Ответ["message"] + " (не установлено полей: " + Строка(ОшибкиПолей.Количество()) + ")";
		КонецЕсли;
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка создания документа: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

// Заполняет наборы движений документа по структуре {ИмяРегистра: [{...}]},
// возвращает число добавленных строк. Наборы записываются активными вместе с документом
// (без проведения) — для непроводимых документов-корректировок.
Функция ЗаполнитьДвиженияДокумента(НовыйДокумент, Движения, ОшибкиПолей = Неопределено)

	КолвоДобавлено = 0;
	Для Каждого КЗРег Из Движения Цикл
		ИмяРегистра = КЗРег.Ключ;
		Если ТипЗнч(КЗРег.Значение) <> Тип("Массив") И ТипЗнч(КЗРег.Значение) <> Тип("ФиксированныйМассив") Тогда
			Продолжить;
		КонецЕсли;

		// Определяем тип регистра и его метаданные (накопления / сведений)
		МетаРегНакопл = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
		МетаРегСвед = Неопределено;
		Если МетаРегНакопл = Неопределено Тогда
			МетаРегСвед = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
		КонецЕсли;
		Если МетаРегНакопл = Неопределено И МетаРегСвед = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Документ должен быть регистратором этого регистра
		Попытка
			НаборДвижений = НовыйДокумент.Движения[ИмяРегистра];
		Исключение
			Продолжить;
		КонецПопытки;
		НаборДвижений.Записывать = Истина;

		Для Каждого СтрокаДвижения Из КЗРег.Значение Цикл
			Если ТипЗнч(СтрокаДвижения) <> Тип("Структура") И ТипЗнч(СтрокаДвижения) <> Тип("Соответствие") И ТипЗнч(СтрокаДвижения) <> Тип("ФиксированнаяСтруктура") Тогда
				Продолжить;
			КонецЕсли;
			НовДвижение = НаборДвижений.Добавить();
			КолвоДобавлено = КолвоДобавлено + 1;
			Попытка
				НовДвижение.Активность = Истина;
			Исключение
			КонецПопытки;

			ПериодУстановлен = Ложь;
			Для Каждого КЗПоле Из СтрокаДвижения Цикл
				// ВидДвижения — только для регистра накопления
				Если КЗПоле.Ключ = "ВидДвижения" Тогда
					Если МетаРегНакопл <> Неопределено Тогда
						Попытка
							НовДвижение.ВидДвижения = ПреобразоватьВидДвиженияНакопления(КЗПоле.Значение);
						Исключение
						КонецПопытки;
					КонецЕсли;
					Продолжить;
				КонецЕсли;
				ОписаниеТипаПоля = ПолучитьТипПоляДвижения(МетаРегНакопл, МетаРегСвед, КЗПоле.Ключ);
				Попытка
					Если ОписаниеТипаПоля = Неопределено Тогда
						Если КЗПоле.Ключ = "Период" И ТипЗнч(КЗПоле.Значение) = Тип("Строка") Тогда
							НовДвижение.Период = Дата(КЗПоле.Значение);
						Иначе
							НовДвижение[КЗПоле.Ключ] = КЗПоле.Значение;
						КонецЕсли;
					Иначе
						НовДвижение[КЗПоле.Ключ] = AI_Utils.КонвертироватьЗначение(ОписаниеТипаПоля, КЗПоле.Значение);
					КонецЕсли;
					Если КЗПоле.Ключ = "Период" Тогда
						ПериодУстановлен = Истина;
					КонецЕсли;
				Исключение
					// Не глотать ошибку установки поля — накапливать в ОшибкиПолей
					Если ТипЗнч(ОшибкиПолей) = Тип("Массив") Тогда
						ОшибкиПолей.Добавить("Поле '" + КЗПоле.Ключ + "': " + ОписаниеОшибки());
					КонецЕсли;
				КонецПопытки;
			КонецЦикла;

			// Период по умолчанию — дата документа
			Если НЕ ПериодУстановлен Тогда
				Попытка
					НовДвижение.Период = НовыйДокумент.Дата;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат КолвоДобавлено;

КонецФункции

// Возвращает ОписаниеТипов поля движения (измерение/ресурс/реквизит) или Неопределено.
Функция ПолучитьТипПоляДвижения(МетаРегНакопл, МетаРегСвед, ИмяПоля)

	Коллекции = Новый Массив;
	Если МетаРегНакопл <> Неопределено Тогда
		Коллекции.Добавить(МетаРегНакопл.Измерения);
		Коллекции.Добавить(МетаРегНакопл.Ресурсы);
		Коллекции.Добавить(МетаРегНакопл.Реквизиты);
	Иначе
		Коллекции.Добавить(МетаРегСвед.Измерения);
		Коллекции.Добавить(МетаРегСвед.Ресурсы);
		Коллекции.Добавить(МетаРегСвед.Реквизиты);
	КонецЕсли;
	Для Каждого Коллекция Из Коллекции Цикл
		МетаПоле = Коллекция.Найти(ИмяПоля);
		Если МетаПоле <> Неопределено Тогда
			Возврат МетаПоле.Тип;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Приводит строку/значение к ВидДвиженияНакопления (по умолчанию Приход).
Функция ПреобразоватьВидДвиженияНакопления(Знач Вид)

	Если ТипЗнч(Вид) = Тип("ВидДвиженияНакопления") Тогда
		Возврат Вид;
	КонецЕсли;
	Стр = ВРег(СокрЛП(Строка(Вид)));
	Если Стр = "РАСХОД" ИЛИ Стр = "EXPENSE" ИЛИ Стр = "-" Тогда
		Возврат ВидДвиженияНакопления.Расход;
	Иначе
		Возврат ВидДвиженияНакопления.Приход;
	КонецЕсли;

КонецФункции

// Разбирает строку JSON в значение (объекты — Соответствия, массивы — Массивы).
// MCP передаёт вложенные object-параметры строкой.
Функция РазобратьJSONВЗначение(Знач СтрокаJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Функция ОбновитьДокумент(Параметры)

	ТипДокумента = Параметры.documentType;
	СтрокаСсылки = Параметры.documentRef;

	МетаОбъект = Метаданные.Документы.Найти(ТипДокумента);
	Если МетаОбъект = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Документ не найден в метаданных: " + ТипДокумента);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаСсылки);
		Ссылка = Документы[ТипДокумента].ПолучитьСсылку(УИД);
		ДокументОбъект = Ссылка.ПолучитьОбъект();

		Если ДокументОбъект = Неопределено Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Документ не найден: " + СтрокаСсылки);
			Возврат Ответ;
		КонецЕсли;

		ОшибкиПолей = Новый Массив;
		Если Параметры.Свойство("header") И ТипЗнч(Параметры.header) = Тип("Структура") Тогда
			AI_Utils.УстановитьРеквизиты(ДокументОбъект, МетаОбъект, Параметры.header, ОшибкиПолей);
		КонецЕсли;

		Если Параметры.Свойство("tables") И ТипЗнч(Параметры.tables) = Тип("Структура") Тогда
			Для Каждого КЗТаб Из Параметры.tables Цикл
				ИмяТЧ = КЗТаб.Ключ;
				МетаТЧ = МетаОбъект.ТабличныеЧасти.Найти(ИмяТЧ);
				Если МетаТЧ = Неопределено ИЛИ ТипЗнч(КЗТаб.Значение) <> Тип("Массив") Тогда
					Продолжить;
				КонецЕсли;
				ДокументОбъект[ИмяТЧ].Очистить();
				Для Каждого СтрокаДанных Из КЗТаб.Значение Цикл
					НовСтрока = ДокументОбъект[ИмяТЧ].Добавить();
					Если ТипЗнч(СтрокаДанных) = Тип("Структура") Тогда
						Для Каждого КЗРеквизит Из СтрокаДанных Цикл
							МетаРеквизит = МетаТЧ.Реквизиты.Найти(КЗРеквизит.Ключ);
							Если МетаРеквизит = Неопределено Тогда
								Попытка
									НовСтрока[КЗРеквизит.Ключ] = КЗРеквизит.Значение;
								Исключение
									// Не глотать ошибку установки поля — накапливать в ОшибкиПолей
									Если ТипЗнч(ОшибкиПолей) = Тип("Массив") Тогда
										ОшибкиПолей.Добавить("Поле '" + КЗРеквизит.Ключ + "': " + ОписаниеОшибки());
									КонецЕсли;
								КонецПопытки;
							Иначе
								Попытка
									НовСтрока[КЗРеквизит.Ключ] = AI_Utils.КонвертироватьЗначение(МетаРеквизит.Тип, КЗРеквизит.Значение);
								Исключение
									// Не глотать ошибку установки поля — накапливать в ОшибкиПолей
									Если ТипЗнч(ОшибкиПолей) = Тип("Массив") Тогда
										ОшибкиПолей.Добавить("Поле '" + КЗРеквизит.Ключ + "': " + ОписаниеОшибки());
									КонецЕсли;
								КонецПопытки;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;

		ДокументОбъект.Записать();

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("ref", Строка(Ссылка.УникальныйИдентификатор()));
		Ответ.Вставить("message", "Документ " + ТипДокумента + " обновлён");
		// Показать поля, которые не удалось установить (напр. составной тип без явного типа)
		Если ОшибкиПолей.Количество() > 0 Тогда
			Ответ.Вставить("fieldErrors", ОшибкиПолей);
			Ответ["message"] = Ответ["message"] + " (не установлено полей: " + Строка(ОшибкиПолей.Количество()) + ")";
		КонецЕсли;
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка обновления документа: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

