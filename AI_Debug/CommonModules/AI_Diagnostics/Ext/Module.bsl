// AI_Diagnostics — read-only инструменты диагностики:
// движения документа, очереди обмена, константы.

#Область ПрограммныйИнтерфейс

Функция ОписаниеИнструментов() Экспорт

	Инструменты = Новый Массив;

	// get_document_postings
	ИнстрДвижения = Новый Структура;
	ИнстрДвижения.Вставить("name", "get_document_postings");
	ИнстрДвижения.Вставить("description",
		"Возвращает движения документа по всем регистрам, которые он проводит. Первый инструмент при вопросах «документ не проводится / не туда встал».");
	СхемаДвижения = Новый Структура("type", "object");
	СвойстваДвижения = Новый Структура;
	СвойстваДвижения.Вставить("documentType", Новый Структура("type,description", "string", "Имя вида документа (например РеализацияТоваровУслуг)"));
	СвойстваДвижения.Вставить("documentRef", Новый Структура("type,description", "string", "GUID документа"));
	СвойстваДвижения.Вставить("maxRowsPerRegister", Новый Структура("type,description", "number", "Максимум записей на регистр (по умолчанию 50)"));
	СхемаДвижения.Вставить("properties", СвойстваДвижения);
	СхемаДвижения.Вставить("required", AI_Utils.ПолучитьМассив("documentType", "documentRef"));
	ИнстрДвижения.Вставить("inputSchema", СхемаДвижения);
	Инструменты.Добавить(ИнстрДвижения);

	// get_exchange_status
	ИнстрОбмен = Новый Структура;
	ИнстрОбмен.Вставить("name", "get_exchange_status");
	ИнстрОбмен.Вставить("description",
		"Состояние обменов: по каждому плану обмена узлы и количество зарегистрированных к выгрузке изменений. Для вопросов «документ не ушёл/не пришёл по интеграции».");
	СхемаОбмен = Новый Структура("type", "object");
	СвойстваОбмен = Новый Структура;
	СвойстваОбмен.Вставить("planName", Новый Структура("type,description", "string", "Имя плана обмена (необязательно — без него все планы)"));
	СхемаОбмен.Вставить("properties", СвойстваОбмен);
	СхемаОбмен.Вставить("required", Новый Массив);
	ИнстрОбмен.Вставить("inputSchema", СхемаОбмен);
	Инструменты.Добавить(ИнстрОбмен);

	// get_constants
	ИнстрКонстанты = Новый Структура;
	ИнстрКонстанты.Вставить("name", "get_constants");
	ИнстрКонстанты.Вставить("description",
		"Значения констант конфигурации (настройки). Поддерживает фильтр по подстроке имени.");
	СхемаКонстанты = Новый Структура("type", "object");
	СвойстваКонстанты = Новый Структура;
	СвойстваКонстанты.Вставить("nameFilter", Новый Структура("type,description", "string", "Подстрока имени константы (необязательно)"));
	СхемаКонстанты.Вставить("properties", СвойстваКонстанты);
	СхемаКонстанты.Вставить("required", Новый Массив);
	ИнстрКонстанты.Вставить("inputSchema", СхемаКонстанты);
	Инструменты.Добавить(ИнстрКонстанты);

	// get_tech_log
	ИнстрТЖ = Новый Структура;
	ИнстрТЖ.Вставить("name", "get_tech_log");
	ИнстрТЖ.Вставить("description",
		"Читает технологический журнал сервера 1С (EXCP, длинные запросы DBPOSTGRS/DBMSSQL с порогом, TLOCK/TTIMEOUT/TDEADLOCK) за последние минуты. Для «виснет/тормозит/взаимоблокировка».");
	СхемаТЖ = Новый Структура("type", "object");
	СвойстваТЖ = Новый Структура;
	СвойстваТЖ.Вставить("minutes", Новый Структура("type,description", "number", "Окно в минут назад (по умолчанию 30)"));
	СвойстваТЖ.Вставить("eventFilter", Новый Структура("type,description", "string", "Фильтр по имени события, напр. TDEADLOCK или DBPOSTGRS (необязательно)"));
	СвойстваТЖ.Вставить("maxEvents", Новый Структура("type,description", "number", "Максимум событий (по умолчанию 50)"));
	СхемаТЖ.Вставить("properties", СвойстваТЖ);
	СхемаТЖ.Вставить("required", Новый Массив);
	ИнстрТЖ.Вставить("inputSchema", СхемаТЖ);
	Инструменты.Добавить(ИнстрТЖ);

	// get_logcfg
	ИнстрЧтениеКонф = Новый Структура;
	ИнстрЧтениеКонф.Вставить("name", "get_logcfg");
	ИнстрЧтениеКонф.Вставить("description",
		"Читает текущий logcfg.xml технологического журнала сервера 1С и список бэкапов. Первый шаг перед configure_logcfg.");
	ИнстрЧтениеКонф.Вставить("inputSchema", Новый Структура("type", "object"));
	Инструменты.Добавить(ИнстрЧтениеКонф);

	// configure_logcfg
	ИнстрЗаписьКонф = Новый Структура;
	ИнстрЗаписьКонф.Вставить("name", "configure_logcfg");
	ИнстрЗаписьКонф.Вставить("description",
		"Заменяет logcfg.xml сервера 1С (точечный сбор ТЖ). Текущий конфиг сохраняется в бэкап, возвращается backupId для restore_logcfg. Конфиг подхватывается платформой ~1 минуту. ОБЯЗАТЕЛЬНО вернуть конфиг после сбора. В режиме «только чтение» заблокирован.");
	СхемаЗаписьКонф = Новый Структура("type", "object");
	СвойстваЗаписьКонф = Новый Структура;
	СвойстваЗаписьКонф.Вставить("xml", Новый Структура("type,description", "string", "Полный текст logcfg.xml"));
	СхемаЗаписьКонф.Вставить("properties", СвойстваЗаписьКонф);
	СхемаЗаписьКонф.Вставить("required", AI_Utils.ПолучитьМассив("xml"));
	ИнстрЗаписьКонф.Вставить("inputSchema", СхемаЗаписьКонф);
	Инструменты.Добавить(ИнстрЗаписьКонф);

	// restore_logcfg
	ИнстрВосстКонф = Новый Структура;
	ИнстрВосстКонф.Вставить("name", "restore_logcfg");
	ИнстрВосстКонф.Вставить("description",
		"Восстанавливает logcfg.xml из бэкапа (по backupId или самый свежий). Вызывать после завершения сбора ТЖ. В режиме «только чтение» заблокирован.");
	СхемаВосстКонф = Новый Структура("type", "object");
	СвойстваВосстКонф = Новый Структура;
	СвойстваВосстКонф.Вставить("backupId", Новый Структура("type,description", "string", "Идентификатор бэкапа из configure_logcfg (необязательно — без него самый свежий)"));
	СхемаВосстКонф.Вставить("properties", СвойстваВосстКонф);
	СхемаВосстКонф.Вставить("required", Новый Массив);
	ИнстрВосстКонф.Вставить("inputSchema", СхемаВосстКонф);
	Инструменты.Добавить(ИнстрВосстКонф);

	Возврат Инструменты;

КонецФункции

Функция ВыполнитьИнструмент(ИмяИнструмента, Параметры) Экспорт

	Если ИмяИнструмента = "get_document_postings" Тогда
		Возврат ПолучитьДвиженияДокумента(Параметры);
	ИначеЕсли ИмяИнструмента = "get_exchange_status" Тогда
		Возврат ПолучитьСостояниеОбменов(Параметры);
	ИначеЕсли ИмяИнструмента = "get_constants" Тогда
		Возврат ПолучитьКонстанты(Параметры);
	ИначеЕсли ИмяИнструмента = "get_tech_log" Тогда
		Возврат ПолучитьТехЖурнал(Параметры);
	ИначеЕсли ИмяИнструмента = "get_logcfg" Тогда
		Возврат ПолучитьКонфигТЖ(Параметры);
	ИначеЕсли ИмяИнструмента = "configure_logcfg" Тогда
		Возврат НастроитьКонфигТЖ(Параметры);
	ИначеЕсли ИмяИнструмента = "restore_logcfg" Тогда
		Возврат ВосстановитьКонфигТЖ(Параметры);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", "Не реализован инструмент: " + ИмяИнструмента);
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДвиженияДокумента(Параметры)

	Ответ = Новый Структура;
	Попытка
		УИД = Новый УникальныйИдентификатор(Параметры.documentRef);
		СсылкаНаДокумент = Документы[Параметры.documentType].ПолучитьСсылку(УИД);
		// Проверка существования объекта
		ДатаДокумента = СсылкаНаДокумент.Дата;
	Исключение
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Документ не найден: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

	МаксимумЗаписей = 50;
	Если Параметры.Свойство("maxRowsPerRegister") И ЗначениеЗаполнено(Параметры.maxRowsPerRegister) Тогда
		МаксимумЗаписей = Параметры.maxRowsPerRegister;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Движения документа: " + Строка(СсылкаНаДокумент)
		+ " (проведен: " + СсылкаНаДокумент.Проведен + ")");

	МетаданныеДокумента = СсылкаНаДокумент.Метаданные();

	Для Каждого РегистрМета Из МетаданныеДокумента.Движения Цикл
		ПолноеИмя = РегистрМета.ПолноеИмя();
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(МаксимумЗаписей, "ЧГ=0")
				+ " * ИЗ " + ПолноеИмя + " ГДЕ Регистратор = &Регистратор";
			Запрос.УстановитьПараметр("Регистратор", СсылкаНаДокумент);
			ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
		Исключение
			Строки.Добавить(ПолноеИмя + ": ошибка чтения — " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Строки.Добавить("");
		Строки.Добавить(ПолноеИмя + ": записей " + ТаблицаРезультата.Количество());
		Для Каждого СтрокаТаблицы Из ТаблицаРезультата Цикл
			ПоляСтроки = Новый Массив;
			Для Каждого Колонка Из ТаблицаРезультата.Колонки Цикл
				ПоляСтроки.Добавить(Колонка.Имя + "=" + Строка(СтрокаТаблицы[Колонка.Имя]));
			КонецЦикла;
			Строки.Добавить("  " + СтрСоединить(ПоляСтроки, "; "));
		КонецЦикла;
	КонецЦикла;

	Ответ.Вставить("success", Истина);
	Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
	Возврат Ответ;

КонецФункции

Функция ПолучитьСостояниеОбменов(Параметры)

	ФильтрПлана = "";
	Если Параметры.Свойство("planName") Тогда
		ФильтрПлана = Параметры.planName;
	КонецЕсли;

	Строки = Новый Массив;

	Для Каждого ПланМета Из Метаданные.ПланыОбмена Цикл
		Если ЗначениеЗаполнено(ФильтрПлана) И ПланМета.Имя <> ФильтрПлана Тогда
			Продолжить;
		КонецЕсли;

		Строки.Добавить("План обмена: " + ПланМета.Имя + " (" + ПланМета.Синоним + ")");

		Попытка
			ЗапросУзлы = Новый Запрос(
				"ВЫБРАТЬ Ссылка, Наименование, ЭтотУзел ИЗ ПланОбмена." + ПланМета.Имя);
			ВыборкаУзлы = ЗапросУзлы.Выполнить().Выбрать();
			Пока ВыборкаУзлы.Следующий() Цикл
				Если ВыборкаУзлы.ЭтотУзел Тогда
					Продолжить;
				КонецЕсли;
				КоличествоИзменений = 0;
				Попытка
					ЗапросИзменения = Новый Запрос(
						"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ ПланОбмена."
						+ ПланМета.Имя + ".Изменения ГДЕ Узел = &Узел");
					ЗапросИзменения.УстановитьПараметр("Узел", ВыборкаУзлы.Ссылка);
					ВыборкаИзменений = ЗапросИзменения.Выполнить().Выбрать();
					Если ВыборкаИзменений.Следующий() Тогда
						КоличествоИзменений = ВыборкаИзменений.Количество;
					КонецЕсли;
				Исключение
					КоличествоИзменений = -1;
				КонецПопытки;
				Строки.Добавить("  узел: " + Строка(ВыборкаУзлы.Наименование)
					+ " — зарегистрировано изменений: " + КоличествоИзменений);
			КонецЦикла;
		Исключение
			Строки.Добавить("  ошибка чтения плана: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
	Возврат Ответ;

КонецФункции

Функция ПолучитьКонстанты(Параметры)

	ФильтрИмени = "";
	Если Параметры.Свойство("nameFilter") Тогда
		ФильтрИмени = НРег(Параметры.nameFilter);
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Константы" + ?(ЗначениеЗаполнено(ФильтрИмени), " (фильтр: " + ФильтрИмени + ")", "") + ":");

	Для Каждого КонстантаМета Из Метаданные.Константы Цикл
		Если ЗначениеЗаполнено(ФильтрИмени)
			И СтрНайти(НРег(КонстантаМета.Имя), ФильтрИмени) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЗначениеКонстанты = Константы[КонстантаМета.Имя].Получить();
			ТекстЗначения = Лев(Строка(ЗначениеКонстанты), 200);
		Исключение
			ТекстЗначения = "<ошибка чтения>";
		КонецПопытки;
		Строки.Добавить(КонстантаМета.Имя + " = " + ТекстЗначения);
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
	Возврат Ответ;

КонецФункции

Функция ПолучитьТехЖурнал(Параметры)

	Ответ = Новый Структура;

	МинутОкно = 30;
	ФильтрСобытия = "";
	МаксСобытий = 50;
	Если Параметры.Свойство("minutes") И ЗначениеЗаполнено(Параметры.minutes) Тогда
		МинутОкно = Параметры.minutes;
	КонецЕсли;
	Если Параметры.Свойство("eventFilter") Тогда
		ФильтрСобытия = ВРег(Параметры.eventFilter);
	КонецЕсли;
	Если Параметры.Свойство("maxEvents") И ЗначениеЗаполнено(Параметры.maxEvents) Тогда
		МаксСобытий = Параметры.maxEvents;
	КонецЕсли;

	КаталогТЖ = "/tmp/tj";
	ПорогВремени = ТекущаяДата() - МинутОкно * 60;

	НайденныеФайлы = НайтиФайлы(КаталогТЖ, "*.log", Истина);
	Если НайденныеФайлы.Количество() = 0 Тогда
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Каталог ТЖ пуст или не настроен: " + КаталогТЖ);
		Возврат Ответ;
	КонецЕсли;

	ТаблицаФайлов = Новый ТаблицаЗначений;
	ТаблицаФайлов.Колонки.Добавить("Файл");
	ТаблицаФайлов.Колонки.Добавить("Изменен");
	Для Каждого ФайлТЖ Из НайденныеФайлы Цикл
		СтрокаФайла = ТаблицаФайлов.Добавить();
		СтрокаФайла.Файл = ФайлТЖ.ПолноеИмя;
		СтрокаФайла.Изменен = ФайлТЖ.ПолучитьВремяИзменения();
	КонецЦикла;
	ТаблицаФайлов.Сортировать("Изменен Убыв");

	События = Новый Массив;

	Для Каждого СтрокаФайла Из ТаблицаФайлов Цикл
		Если События.Количество() >= МаксСобытий Тогда
			Прервать;
		КонецЕсли;

		ФайлОбъект = Новый Файл(СтрокаФайла.Файл);
		ИмяБезРасширения = ФайлОбъект.ИмяБезРасширения;
		Если СтрДлина(ИмяБезРасширения) <> 8 Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ДатаЧасФайла = Дата(2000 + Число(Лев(ИмяБезРасширения, 2)),
				Число(Сред(ИмяБезРасширения, 3, 2)), Число(Сред(ИмяБезРасширения, 5, 2)),
				Число(Сред(ИмяБезРасширения, 7, 2)), 0, 0);
		Исключение
			Продолжить;
		КонецПопытки;

		Если ДатаЧасФайла + 3600 < ПорогВремени Тогда
			Прервать;
		КонецЕсли;

		ЧтениеТекста = Неопределено;
		Попытка
			ЧтениеТекста = Новый ЧтениеТекста(СтрокаФайла.Файл, КодировкаТекста.UTF8);
		Исключение
			// файл мог уйти в ротацию между листингом и чтением
			Продолжить;
		КонецПопытки;
		СтрокаТЖ = ЧтениеТекста.ПрочитатьСтроку();
		ТекущийБлок = "";
		ВремяБлока = Дата(1, 1, 1);

		Пока СтрокаТЖ <> Неопределено Цикл
			Если СтрДлина(СтрокаТЖ) > 10 И Сред(СтрокаТЖ, 3, 1) = ":" И Сред(СтрокаТЖ, 6, 1) = "." Тогда
				Если ТекущийБлок <> "" И ВремяБлока >= ПорогВремени Тогда
					Если ФильтрСобытия = "" ИЛИ СтрНайти(ВРег(ТекущийБлок), ФильтрСобытия) > 0 Тогда
						События.Добавить(ТекущийБлок);
					КонецЕсли;
				КонецЕсли;
				ТекущийБлок = СтрокаТЖ;
				ВремяБлока = ДатаЧасФайла + Число(Лев(СтрокаТЖ, 2)) * 60 + Число(Сред(СтрокаТЖ, 4, 2));
			Иначе
				ТекущийБлок = ТекущийБлок + Символы.ПС + СтрокаТЖ;
			КонецЕсли;
			СтрокаТЖ = ЧтениеТекста.ПрочитатьСтроку();
		КонецЦикла;

		Если ТекущийБлок <> "" И ВремяБлока >= ПорогВремени Тогда
			Если ФильтрСобытия = "" ИЛИ СтрНайти(ВРег(ТекущийБлок), ФильтрСобытия) > 0 Тогда
				События.Добавить(ТекущийБлок);
			КонецЕсли;
		КонецЕсли;

		ЧтениеТекста.Закрыть();
	КонецЦикла;

	Пока События.Количество() > МаксСобытий Цикл
		События.Удалить(0);
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить("ТЖ за последние " + МинутОкно + " мин"
		+ ?(ФильтрСобытия <> "", " (фильтр: " + ФильтрСобытия + ")", "")
		+ ", событий: " + События.Количество());
	Строки.Добавить("");
	Для Каждого Событие Из События Цикл
		Строки.Добавить(Событие);
		Строки.Добавить("---");
	КонецЦикла;

	Ответ.Вставить("success", Истина);
	Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
	Возврат Ответ;

КонецФункции

// Управление logcfg.xml технологического журнала (контракт по мотивам
// SteelMorgan/1c-log-checker: get → configure с backupId → restore).
//

Функция ПутьКLogcfg()

	Разделитель = ПолучитьРазделительПути();
	Каталог = КаталогПрограммы();
	Если НЕ СтрЗаканчиваетсяНа(Каталог, Разделитель) Тогда
		Каталог = Каталог + Разделитель;
	КонецЕсли;

	Возврат Каталог + "conf" + Разделитель + "logcfg.xml";

КонецФункции

Функция ПолучитьКонфигТЖ(Параметры)

	Ответ = Новый Структура;
	Попытка
		Путь = ПутьКLogcfg();
		ФайлКонфига = Новый Файл(Путь);

		Данные = Новый Структура;
		Данные.Вставить("path", Путь);
		Данные.Вставить("exists", ФайлКонфига.Существует());

		Бэкапы = НайтиФайлы(ФайлКонфига.Путь, "logcfg.xml.bak-*");
		СписокБэкапов = Новый Массив;
		Для Каждого ФайлБэкапа Из Бэкапы Цикл
			СписокБэкапов.Добавить(ФайлБэкапа.Имя);
		КонецЦикла;
		Данные.Вставить("backups", СписокБэкапов);

		Если ФайлКонфига.Существует() Тогда
			Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
			Данные.Вставить("content", Чтение.Прочитать());
			Чтение.Закрыть();
		КонецЕсли;

		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", Данные);
	Исключение
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка чтения logcfg: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Ответ;

КонецФункции

Функция НастроитьКонфигТЖ(Параметры)

	Ответ = Новый Структура;
	НовыйТекст = Параметры.xml;

	// Валидация XML до записи
	Попытка
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(НовыйТекст);
		ПостроительДОМ = Новый ПостроительDOM;
		ПостроительДОМ.Прочитать(ЧтениеXML);
		ЧтениеXML.Закрыть();
	Исключение
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Невалидный XML: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

	Попытка
		Путь = ПутьКLogcfg();
		ФайлКонфига = Новый Файл(Путь);
		ИдентификаторБэкапа = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");

		Если ФайлКонфига.Существует() Тогда
			КопироватьФайл(Путь, Путь + ".bak-" + ИдентификаторБэкапа);
		Иначе
			// Маркер «конфига не было» — restore удалит созданный файл
			ЗаписьМаркера = Новый ЗаписьТекста(
				Путь + ".bak-" + ИдентификаторБэкапа + ".absent", "UTF-8");
			ЗаписьМаркера.Закрыть();
		КонецЕсли;

		Запись = Новый ЗаписьТекста(Путь, "UTF-8");
		Запись.Записать(НовыйТекст);
		Запись.Закрыть();

		Данные = Новый Структура;
		Данные.Вставить("path", Путь);
		Данные.Вставить("backupId", ИдентификаторБэкапа);
		Данные.Вставить("note",
			"Конфиг подхватывается платформой ~1 минуту. После сбора вызовите restore_logcfg.");

		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", Данные);
	Исключение
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error",
			"Ошибка записи logcfg (нет прав у процесса rphost на conf-каталог?): " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Ответ;

КонецФункции

Функция ВосстановитьКонфигТЖ(Параметры)

	Ответ = Новый Структура;
	Попытка
		Путь = ПутьКLogcfg();
		ФайлКонфига = Новый Файл(Путь);
		Каталог = ФайлКонфига.Путь;

		ИмяБэкапа = "";
		Если Параметры.Свойство("backupId") И НЕ ПустаяСтрока(Параметры.backupId) Тогда
			ИмяБэкапа = "logcfg.xml.bak-" + Параметры.backupId;
		Иначе
			Найденные = НайтиФайлы(Каталог, "logcfg.xml.bak-*");
			Если Найденные.Количество() = 0 Тогда
				Ответ.Вставить("success", Ложь);
				Ответ.Вставить("error", "Бэкапы logcfg не найдены");
				Возврат Ответ;
			КонецЕсли;
			Свежий = Найденные[0];
			Для Каждого ФайлБэкапа Из Найденные Цикл
				Если ФайлБэкапа.ПолучитьВремяИзменения() > Свежий.ПолучитьВремяИзменения() Тогда
					Свежий = ФайлБэкапа;
				КонецЕсли;
			КонецЦикла;
			ИмяБэкапа = Свежий.Имя;
		КонецЕсли;

		// Маркер «конфига не было»
		Если НЕ СтрЗаканчиваетсяНа(ИмяБэкапа, ".absent") Тогда
			ФайлМаркера = Новый Файл(Каталог + ИмяБэкапа + ".absent");
			Если ФайлМаркера.Существует() Тогда
				ИмяБэкапа = ИмяБэкапа + ".absent";
			КонецЕсли;
		КонецЕсли;

		Если СтрЗаканчиваетсяНа(ИмяБэкапа, ".absent") Тогда
			Если ФайлКонфига.Существует() Тогда
				УдалитьФайлы(Путь);
			КонецЕсли;
			УдалитьФайлы(Каталог + ИмяБэкапа);
			Действие = "удалён (до configure конфига не было)";
		Иначе
			ПутьБэкапа = Каталог + ИмяБэкапа;
			ФайлБэкапа = Новый Файл(ПутьБэкапа);
			Если НЕ ФайлБэкапа.Существует() Тогда
				Ответ.Вставить("success", Ложь);
				Ответ.Вставить("error", "Бэкап не найден: " + ИмяБэкапа);
				Возврат Ответ;
			КонецЕсли;
			КопироватьФайл(ПутьБэкапа, Путь);
			Действие = "восстановлен из " + ИмяБэкапа;
		КонецЕсли;

		Данные = Новый Структура;
		Данные.Вставить("path", Путь);
		Данные.Вставить("restored", Действие);

		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", Данные);
	Исключение
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка восстановления logcfg: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Ответ;

КонецФункции

#КонецОбласти
