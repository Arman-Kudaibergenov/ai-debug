////////////////////////////////////////////////////////////////////////////////
// Модуль AI_LogCfg_Test: тесты управления logcfg.xml (AI_Diagnostics).
//
// Запуск: run_unit_tests({"moduleName": "AI_LogCfg_Test"})
//
// ВНИМАНИЕ: раундтрип пишет в conf-каталог платформы сервера. Если у процесса
// rphost нет прав на запись — тест раундтрипа проваливается по понятной
// причине (это и есть проверка применимости на данном сервере).
//

#Область СлужебныйПрограммныйИнтерфейс

// Обязательная функция — точка входа для run_unit_tests.
//
Функция ИсполняемыеСценарии() Экспорт
	Возврат ЮТТесты.СписокТестов(
		"GetLogcfg_ВозвращаетПутьИФлаг",
		"ConfigureLogcfg_НевалидныйXML_Отказ",
		"LogCfg_Раундтрип_СохраняетИВозвращает");
КонецФункции

#КонецОбласти

#Область Тесты

Процедура GetLogcfg_ВозвращаетПутьИФлаг() Экспорт

	Результат = AI_Diagnostics.ВыполнитьИнструмент("get_logcfg", Новый Структура);

	ЮТУтверждения.ЭтоИстина(Результат.success, "get_logcfg должен вернуть success");
	ЮТУтверждения.Заполнено(Результат.data.path, "должен быть путь к logcfg.xml");
	ЮТУтверждения.ЭтоИстина(СтрНайти(Результат.data.path, "logcfg.xml") > 0);

КонецПроцедуры

Процедура ConfigureLogcfg_НевалидныйXML_Отказ() Экспорт

	Параметры = Новый Структура("xml", "это не xml <>");
	Результат = AI_Diagnostics.ВыполнитьИнструмент("configure_logcfg", Параметры);

	ЮТУтверждения.ЭтоЛожь(Результат.success, "невалидный XML должен быть отклонён");
	ЮТУтверждения.ЭтоИстина(СтрНайти(Результат.error, "Невалидный XML") > 0);

КонецПроцедуры

Процедура LogCfg_Раундтрип_СохраняетИВозвращает() Экспорт

	// Читаем исходное состояние
	До = AI_Diagnostics.ВыполнитьИнструмент("get_logcfg", Новый Структура);
	ЮТУтверждения.ЭтоИстина(До.success);

	ТестовыйКонфиг = "<config xmlns=""http://v8.1c.ru/v8/tech-log"">"
		+ "<log location=""/tmp/tj-ai-test"" history=""1"">"
		+ "<event><eq property=""name"" value=""EXCP""/></event>"
		+ "<property name=""all""/>"
		+ "</log></config>";

	// Пишем тестовый конфиг
	Запись = AI_Diagnostics.ВыполнитьИнструмент("configure_logcfg",
		Новый Структура("xml", ТестовыйКонфиг));
	ЮТУтверждения.ЭтоИстина(Запись.success,
		"configure_logcfg должен записать конфиг (иначе нет прав у rphost на conf)");
	ЮТУтверждения.Заполнено(Запись.data.backupId, "должен вернуться backupId");

	// Проверяем, что записалось
	ПослеЗаписи = AI_Diagnostics.ВыполнитьИнструмент("get_logcfg", Новый Структура);
	ЮТУтверждения.ЭтоИстина(СтрНайти(ПослеЗаписи.data.content, "tj-ai-test") > 0,
		"новый конфиг должен читаться");

	// Возвращаем как было
	Восстановление = AI_Diagnostics.ВыполнитьИнструмент("restore_logcfg",
		Новый Структура("backupId", Запись.data.backupId));
	ЮТУтверждения.ЭтоИстина(Восстановление.success, "restore_logcfg должен сработать");

	// Проверяем возврат в исходное состояние
	ПослеВосстановления = AI_Diagnostics.ВыполнитьИнструмент("get_logcfg", Новый Структура);
	Если До.data.exists Тогда
		ЮТУтверждения.ЭтоИстина(ПослеВосстановления.data.exists,
			"исходный конфиг должен вернуться");
		ЮТУтверждения.Равно(ПослеВосстановления.data.content, До.data.content,
			"содержимое после restore = исходному");
	Иначе
		ЮТУтверждения.ЭтоЛожь(ПослеВосстановления.data.exists,
			"конфига не было — и после restore быть не должно");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
