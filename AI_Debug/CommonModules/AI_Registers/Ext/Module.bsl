// AI_Registers — tools for register operations

Функция ОписаниеИнструментов() Экспорт

	Инструменты = Новый Массив;

	// get_register_records
	ИнстрGetReg = Новый Структура;
	ИнстрGetReg.Вставить("name", "get_register_records");
	ИнстрGetReg.Вставить("description", "Возвращает записи регистра с фильтрацией. Для сложных запросов с агрегацией используй execute_query.");
	СхемаGetReg = Новый Структура("type", "object");
	СвойстваGetReg = Новый Структура;
	СвойстваGetReg.Вставить("registerType", Новый Структура("type,description", "string", "Тип регистра: InformationRegisters или AccumulationRegisters"));
	СвойстваGetReg.Вставить("registerName", Новый Структура("type,description", "string", "Имя регистра (например КурсыВалют)"));
	СвойстваGetReg.Вставить("filter", Новый Структура("type,description", "object", "Фильтр: {ИмяИзмерения: Значение}. Все условия через И."));
	СвойстваGetReg.Вставить("maxRows", Новый Структура("type,description", "number", "Максимум записей (по умолчанию 100)"));
	СхемаGetReg.Вставить("properties", СвойстваGetReg);
	СхемаGetReg.Вставить("required", AI_Utils.ПолучитьМассив("registerType", "registerName"));
	ИнстрGetReg.Вставить("inputSchema", СхемаGetReg);
	Инструменты.Добавить(ИнстрGetReg);

	// write_information_register
	ИнстрWriteReg = Новый Структура;
	ИнстрWriteReg.Вставить("name", "write_information_register");
	ИнстрWriteReg.Вставить("description", "Записывает данные в регистр сведений через МенеджерЗаписи. Измерения обязательны — они идентифицируют запись. Если запись с такими измерениями существует — перезаписывается.");
	СхемаWriteReg = Новый Структура("type", "object");
	СвойстваWriteReg = Новый Структура;
	СвойстваWriteReg.Вставить("registerName", Новый Структура("type,description", "string", "Имя регистра сведений"));
	СвойстваWriteReg.Вставить("dimensions", Новый Структура("type,description", "object", "Измерения: {ИмяИзмерения: Значение}. Обязательны."));
	СвойстваWriteReg.Вставить("resources", Новый Структура("type,description", "object", "Ресурсы: {ИмяРесурса: Значение}"));
	СвойстваWriteReg.Вставить("attributes", Новый Структура("type,description", "object", "Реквизиты: {ИмяРеквизита: Значение}"));
	СхемаWriteReg.Вставить("properties", СвойстваWriteReg);
	СхемаWriteReg.Вставить("required", AI_Utils.ПолучитьМассив("registerName", "dimensions"));
	ИнстрWriteReg.Вставить("inputSchema", СхемаWriteReg);
	Инструменты.Добавить(ИнстрWriteReg);

	// delete_register_record
	ИнстрDelReg = Новый Структура;
	ИнстрDelReg.Вставить("name", "delete_register_record");
	ИнстрDelReg.Вставить("description", "Удаляет записи из регистра. Для регистра сведений — удаление по измерениям через МенеджерЗаписи. Для регистра накопления — очистка набора записей по отбору.");
	СхемаDelReg = Новый Структура("type", "object");
	СвойстваDelReg = Новый Структура;
	СвойстваDelReg.Вставить("registerType", Новый Структура("type,description", "string", "Тип регистра: InformationRegisters или AccumulationRegisters"));
	СвойстваDelReg.Вставить("registerName", Новый Структура("type,description", "string", "Имя регистра"));
	СвойстваDelReg.Вставить("dimensions", Новый Структура("type,description", "object", "Измерения для идентификации записи: {ИмяИзмерения: Значение}"));
	СхемаDelReg.Вставить("properties", СвойстваDelReg);
	МассивОбязательных = Новый Массив;
	МассивОбязательных.Добавить("registerType");
	МассивОбязательных.Добавить("registerName");
	МассивОбязательных.Добавить("dimensions");
	СхемаDelReg.Вставить("required", МассивОбязательных);
	ИнстрDelReg.Вставить("inputSchema", СхемаDelReg);
	Инструменты.Добавить(ИнстрDelReg);

	Возврат Инструменты;

КонецФункции

Функция ВыполнитьИнструмент(ИмяИнструмента, Параметры) Экспорт

	Если ИмяИнструмента = "get_register_records" Тогда
		Возврат ПолучитьЗаписиРегистра(Параметры);
	ИначеЕсли ИмяИнструмента = "write_information_register" Тогда
		Возврат ЗаписатьРегистрСведений(Параметры);
	ИначеЕсли ИмяИнструмента = "delete_register_record" Тогда
		Возврат УдалитьЗаписьРегистра(Параметры);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", "Не реализован инструмент: " + ИмяИнструмента);
	Возврат Ответ;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьЗаписиРегистра(Параметры)

	ТипРегистра = Параметры.registerType;
	ИмяРегистра = Параметры.registerName;
	МаксСтрок = 100;
	Если Параметры.Свойство("maxRows") И ЗначениеЗаполнено(Параметры.maxRows) Тогда
		МаксСтрок = Параметры.maxRows;
	КонецЕсли;

	Попытка
		ИмяТипа = AI_Utils.ПолучитьИмяТипаРегистраДляЗапроса(ТипРегистра);
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(МаксСтрок, "ЧГ=") + " * ИЗ " + ИмяТипа + "." + ИмяРегистра;

		Если Параметры.Свойство("filter") И ТипЗнч(Параметры.filter) = Тип("Структура") Тогда
			УсловияМассив = Новый Массив;
			Для Каждого КЗФильтр Из Параметры.filter Цикл
				УсловияМассив.Добавить(КЗФильтр.Ключ + " = &" + КЗФильтр.Ключ);
			КонецЦикла;
			Если УсловияМассив.Количество() > 0 Тогда
				ТекстЗапроса = ТекстЗапроса + " ГДЕ " + СтрСоединить(УсловияМассив, " И ");
			КонецЕсли;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;

		Если Параметры.Свойство("filter") И ТипЗнч(Параметры.filter) = Тип("Структура") Тогда
			Для Каждого КЗФильтр Из Параметры.filter Цикл
				Запрос.УстановитьПараметр(КЗФильтр.Ключ, КЗФильтр.Значение);
			КонецЦикла;
		КонецЕсли;

		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();

		Строки = Новый Массив;
		Если НЕ Результат.Колонки.Количество() = 0 Тогда
			КолонкиМассив = Новый Массив;
			Для Каждого Колонка Из Результат.Колонки Цикл
				КолонкиМассив.Добавить(Колонка.Имя);
			КонецЦикла;
			Строки.Добавить(СтрСоединить(КолонкиМассив, " | "));
		КонецЕсли;

		Пока Выборка.Следующий() Цикл
			ЗначенияСтроки = Новый Массив;
			Для Каждого Колонка Из Результат.Колонки Цикл
				ЗначенияСтроки.Добавить(Строка(Выборка[Колонка.Имя]));
			КонецЦикла;
			Строки.Добавить(СтрСоединить(ЗначенияСтроки, " | "));
		КонецЦикла;

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка получения записей регистра: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция ЗаписатьРегистрСведений(Параметры)

	ИмяРегистра = Параметры.registerName;

	Попытка
		МетаРегистр = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
		Если МетаРегистр = Неопределено Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Регистр сведений не найден: " + ИмяРегистра);
			Возврат Ответ;
		КонецЕсли;

		МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();

		// Заполнить измерения
		Для Каждого КЗ Из Параметры.dimensions Цикл
			МетаИзм = МетаРегистр.Измерения.Найти(КЗ.Ключ);
			Если МетаИзм <> Неопределено Тогда
				МенеджерЗаписи[КЗ.Ключ] = AI_Utils.КонвертироватьЗначение(МетаИзм.Тип, КЗ.Значение);
			Иначе
				МенеджерЗаписи[КЗ.Ключ] = КЗ.Значение;
			КонецЕсли;
		КонецЦикла;

		// Заполнить ресурсы
		Если Параметры.Свойство("resources") И ТипЗнч(Параметры.resources) = Тип("Структура") Тогда
			Для Каждого КЗ Из Параметры.resources Цикл
				МетаРес = МетаРегистр.Ресурсы.Найти(КЗ.Ключ);
				Если МетаРес <> Неопределено Тогда
					МенеджерЗаписи[КЗ.Ключ] = AI_Utils.КонвертироватьЗначение(МетаРес.Тип, КЗ.Значение);
				Иначе
					МенеджерЗаписи[КЗ.Ключ] = КЗ.Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// Заполнить реквизиты
		Если Параметры.Свойство("attributes") И ТипЗнч(Параметры.attributes) = Тип("Структура") Тогда
			Для Каждого КЗ Из Параметры.attributes Цикл
				МетаРекв = МетаРегистр.Реквизиты.Найти(КЗ.Ключ);
				Если МетаРекв <> Неопределено Тогда
					МенеджерЗаписи[КЗ.Ключ] = AI_Utils.КонвертироватьЗначение(МетаРекв.Тип, КЗ.Значение);
				Иначе
					МенеджерЗаписи[КЗ.Ключ] = КЗ.Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		МенеджерЗаписи.Записать();

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("message", "Запись в регистр сведений " + ИмяРегистра + " создана");
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка записи в регистр сведений: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция УдалитьЗаписьРегистра(Параметры)

	ТипРегистра = Параметры.registerType;
	ИмяРегистра = Параметры.registerName;

	Попытка
		Если ТипРегистра = "InformationRegisters" Тогда
			МетаРегистр = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
			Если МетаРегистр = Неопределено Тогда
				Ответ = Новый Структура;
				Ответ.Вставить("success", Ложь);
				Ответ.Вставить("error", "Регистр сведений не найден: " + ИмяРегистра);
				Возврат Ответ;
			КонецЕсли;
			МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
			Для Каждого КЗ Из Параметры.dimensions Цикл
				МетаИзм = МетаРегистр.Измерения.Найти(КЗ.Ключ);
				Если МетаИзм <> Неопределено Тогда
					МенеджерЗаписи[КЗ.Ключ] = AI_Utils.КонвертироватьЗначение(МетаИзм.Тип, КЗ.Значение);
				Иначе
					МенеджерЗаписи[КЗ.Ключ] = КЗ.Значение;
				КонецЕсли;
			КонецЦикла;
			МенеджерЗаписи.Удалить();
		ИначеЕсли ТипРегистра = "AccumulationRegisters" Тогда
			МетаРегистр = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
			Если МетаРегистр = Неопределено Тогда
				Ответ = Новый Структура;
				Ответ.Вставить("success", Ложь);
				Ответ.Вставить("error", "Регистр накопления не найден: " + ИмяРегистра);
				Возврат Ответ;
			КонецЕсли;
			НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
			Для Каждого КЗ Из Параметры.dimensions Цикл
				НаборЗаписей.Отбор[КЗ.Ключ].Установить(КЗ.Значение);
			КонецЦикла;
			НаборЗаписей.Записать(Истина);
		Иначе
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Неподдерживаемый тип регистра: " + ТипРегистра + ". Используй InformationRegisters или AccumulationRegisters");
			Возврат Ответ;
		КонецЕсли;

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("message", "Записи регистра " + ИмяРегистра + " удалены");
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка удаления записи регистра: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

#КонецОбласти
