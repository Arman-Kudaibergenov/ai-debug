////////////////////////////////////////////////////////////////////////////////
// Модуль AI_PrintForms: Работа с печатными формами (табличные документы MXL)
//
// Обеспечивает:
// - Конвертацию файлов (XLSX/XLS/ODS) в формат табличного документа 1С
//

#Область ПрограммныйИнтерфейс

// Возвращает описание инструментов модуля
//
// Возвращаемое значение:
//   Массив из Структура - описания инструментов
//
Функция ОписаниеИнструментов() Экспорт

	Инструменты = Новый Массив;

	// convert_file — конвертация XLSX/XLS/ODS → MXL/Template.xml
	ИнструментConvert = Новый Структура;
	ИнструментConvert.Вставить("name", "convert_file");
	ОписаниеConvert = "Конвертирует файл электронной таблицы (XLSX, XLS, ODS) в формат табличного документа 1С. "
		+ "Принимает файл как base64, возвращает результат как base64. "
		+ "Поддерживаемое подмножество: текст, числа, даты, простое форматирование. "
		+ "Не поддерживается: диаграммы, макросы, сводные таблицы, условное форматирование, изображения.";
	ИнструментConvert.Вставить("description", ОписаниеConvert);

	СхемаConvert = Новый Структура;
	СхемаConvert.Вставить("type", "object");

	СвойстваConvert = Новый Структура;
	СвойстваConvert.Вставить("data",
		Новый Структура("type,description", "string", "Base64-encoded source file"));
	СвойстваConvert.Вставить("sourceFormat",
		Новый Структура("type,description", "string", "Source format: xlsx (default), xls, ods"));
	СвойстваConvert.Вставить("targetFormat",
		Новый Структура("type,description", "string", "Target format: xml (Template.xml, default) or mxl (binary)"));

	СхемаConvert.Вставить("properties", СвойстваConvert);
	СхемаConvert.Вставить("required", AI_Utils.ПолучитьМассив("data"));

	ИнструментConvert.Вставить("inputSchema", СхемаConvert);
	Инструменты.Добавить(ИнструментConvert);

	Возврат Инструменты;

КонецФункции

// Выполняет инструмент по имени
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Параметры) Экспорт

	Если ИмяИнструмента = "convert_file" Тогда
		Возврат КонвертироватьФайл(Параметры);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("success", Ложь);
	Результат.Вставить("error", "Неизвестный инструмент: " + ИмяИнструмента);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонвертироватьФайл(Параметры)

	// Определяем формат источника
	ФорматИсточника = "xlsx";
	Если Параметры.Свойство("sourceFormat") И ЗначениеЗаполнено(Параметры.sourceFormat) Тогда
		ФорматИсточника = НРег(Параметры.sourceFormat);
	КонецЕсли;

	// Определяем формат цели
	ФорматЦели = "xml";
	Если Параметры.Свойство("targetFormat") И ЗначениеЗаполнено(Параметры.targetFormat) Тогда
		ФорматЦели = НРег(Параметры.targetFormat);
	КонецЕсли;

	// Декодируем base64 во временный файл
	ДвоичныеДанные = Base64Значение(Параметры.data);

	РасширениеФайла = ПолучитьРасширениеФайла(ФорматИсточника);
	ИмяВходногоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);

	Попытка
		ДвоичныеДанные.Записать(ИмяВходногоФайла);
	Исключение
		Возврат ОшибкаКонвертации("Не удалось записать временный файл: " + ОписаниеОшибки());
	КонецПопытки;

	// Читаем файл как табличный документ
	ТабДок = Новый ТабличныйДокумент;

	Попытка
		// Платформа определяет формат автоматически по расширению файла
		ТабДок.Прочитать(ИмяВходногоФайла);
	Исключение
		УдалитьФайлы(ИмяВходногоФайла);
		Возврат ОшибкаКонвертации("Не удалось прочитать файл: " + ОписаниеОшибки());
	КонецПопытки;

	// Записываем в MXL (бинарный формат — единственный надёжный на 8.3.24)
	Попытка
		ИмяВыходногоФайла = ПолучитьИмяВременногоФайла(".mxl");
		ТабДок.Записать(ИмяВыходногоФайла, ТипФайлаТабличногоДокумента.MXL);
		ДвоичныеДанныеРезультата = Новый ДвоичныеДанные(ИмяВыходногоФайла);
	Исключение
		УдалитьФайлы(ИмяВходногоФайла);
		Возврат ОшибкаКонвертации("Не удалось записать результат: " + ОписаниеОшибки());
	КонецПопытки;

	// Кодируем результат в base64
	РезультатBase64 = Base64Строка(ДвоичныеДанныеРезультата);

	// Очистка временных файлов
	Попытка
		УдалитьФайлы(ИмяВходногоФайла);
		УдалитьФайлы(ИмяВыходногоФайла);
	Исключение
		// Не критично — файлы во временном каталоге
	КонецПопытки;

	// Формируем ответ
	Результат = Новый Структура;
	Результат.Вставить("success", Истина);
	Результат.Вставить("data", РезультатBase64);
	Результат.Вставить("format", ФорматЦели);
	Результат.Вставить("message", СтрШаблон(
		"Конвертация %1 → %2 выполнена (%3 строк, %4 колонок)",
		ВРег(ФорматИсточника), ФорматЦели,
		Формат(ТабДок.ВысотаТаблицы, "ЧГ=0"),
		Формат(ТабДок.ШиринаТаблицы, "ЧГ=0")));

	Возврат Результат;

КонецФункции

Функция ПолучитьРасширениеФайла(ФорматИсточника)

	Если ФорматИсточника = "xls" Тогда
		Возврат ".xls";
	ИначеЕсли ФорматИсточника = "ods" Тогда
		Возврат ".ods";
	Иначе
		Возврат ".xlsx";
	КонецЕсли;

КонецФункции

Функция ПолучитьТипФайлаЧтения(ФорматИсточника)

	Если ФорматИсточника = "xls" Тогда
		Возврат ТипФайлаТабличногоДокумента.XLS;
	ИначеЕсли ФорматИсточника = "ods" Тогда
		Возврат ТипФайлаТабличногоДокумента.ODS;
	Иначе
		Возврат ТипФайлаТабличногоДокумента.XLSX;
	КонецЕсли;

КонецФункции

Функция ОшибкаКонвертации(Сообщение)

	Результат = Новый Структура;
	Результат.Вставить("success", Ложь);
	Результат.Вставить("error", Сообщение);
	Возврат Результат;

КонецФункции

#КонецОбласти
