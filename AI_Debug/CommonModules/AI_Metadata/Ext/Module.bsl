// AI_Metadata — tools for metadata inspection and system info

Функция ОписаниеИнструментов() Экспорт

	Инструменты = Новый Массив;

	// list_metadata_objects
	ИнструментMetadata = Новый Структура;
	ИнструментMetadata.Вставить("name", "list_metadata_objects");
	ИнструментMetadata.Вставить("description", "Возвращает список объектов метаданных конфигурации (справочники, документы, регистры). Можно фильтровать по типу.");
	СхемаMetadata = Новый Структура;
	СхемаMetadata.Вставить("type", "object");
	СвойстваMetadata = Новый Структура;
	СвойстваMetadata.Вставить("object_type", Новый Структура("type,description", "string", "Тип объектов: Catalogs, Documents, InformationRegisters, AccumulationRegisters. Пусто = все."));
	СхемаMetadata.Вставить("properties", СвойстваMetadata);
	СхемаMetadata.Вставить("required", Новый Массив);
	ИнструментMetadata.Вставить("inputSchema", СхемаMetadata);
	Инструменты.Добавить(ИнструментMetadata);

	// get_metadata_structure
	ИнструментMetaStruct = Новый Структура;
	ИнструментMetaStruct.Вставить("name", "get_metadata_structure");
	ИнструментMetaStruct.Вставить("description", "Возвращает структуру объекта метаданных: реквизиты, табличные части, измерения, ресурсы. Путь: Catalogs.Номенклатура или Documents.ПоступлениеТоваровУслуг.");
	СхемаMetaStruct = Новый Структура;
	СхемаMetaStruct.Вставить("type", "object");
	СвойстваMetaStruct = Новый Структура;
	СвойстваMetaStruct.Вставить("metadataPath", Новый Структура("type,description", "string", "Путь к объекту: ТипОбъектов.ИмяОбъекта (Catalogs, Documents, InformationRegisters, AccumulationRegisters)"));
	СхемаMetaStruct.Вставить("properties", СвойстваMetaStruct);
	СхемаMetaStruct.Вставить("required", AI_Utils.ПолучитьМассив("metadataPath"));
	ИнструментMetaStruct.Вставить("inputSchema", СхемаMetaStruct);
	Инструменты.Добавить(ИнструментMetaStruct);

	// get_event_log
	ИнструментEventLog = Новый Структура;
	ИнструментEventLog.Вставить("name", "get_event_log");
	ИнструментEventLog.Вставить("description", "Читает журнал регистрации 1С. Возвращает последние события указанного уровня. Уровни: Error, Warning, Information, Note.");
	СхемаEventLog = Новый Структура;
	СхемаEventLog.Вставить("type", "object");
	СвойстваEventLog = Новый Структура;
	СвойстваEventLog.Вставить("level", Новый Структура("type,description", "string", "Уровень: Error, Warning, Information, Note (по умолчанию Error)"));
	СвойстваEventLog.Вставить("limit", Новый Структура("type,description", "number", "Максимум записей (по умолчанию 50)"));
	СвойстваEventLog.Вставить("startDate", Новый Структура("type,description", "string", "Начальная дата в формате YYYYMMDDHHMMSS (опционально)"));
	СвойстваEventLog.Вставить("endDate", Новый Структура("type,description", "string", "Конечная дата в формате YYYYMMDDHHMMSS (опционально)"));
	СхемаEventLog.Вставить("properties", СвойстваEventLog);
	СхемаEventLog.Вставить("required", Новый Массив);
	ИнструментEventLog.Вставить("inputSchema", СхемаEventLog);
	Инструменты.Добавить(ИнструментEventLog);

	// find_references_to_object
	ИнструментFindRefs = Новый Структура;
	ИнструментFindRefs.Вставить("name", "find_references_to_object");
	ИнструментFindRefs.Вставить("description", "Находит все ссылки на объект в базе. Возвращает список объектов, которые ссылаются на указанный объект. GUID получается из execute_query или find_catalog_items.");
	СхемаFindRefs = Новый Структура;
	СхемаFindRefs.Вставить("type", "object");
	СвойстваFindRefs = Новый Структура;
	СвойстваFindRefs.Вставить("objectRef", Новый Структура("type,description", "string", "GUID объекта для поиска ссылок"));
	СвойстваFindRefs.Вставить("objectType", Новый Структура("type,description", "string", "Тип объекта: Catalogs.ИмяСправочника или Documents.ИмяДокумента"));
	СвойстваFindRefs.Вставить("searchIn", Новый Структура("type,description", "string", "Ограничить поиск по типам объектов через запятую: Documents.ПоступлениеТоваровУслуг,Catalogs.Клиенты. Без параметра — поиск по всей базе, может быть медленным на больших конфигурациях."));
	СхемаFindRefs.Вставить("properties", СвойстваFindRefs);
	СхемаFindRefs.Вставить("required", AI_Utils.ПолучитьМассив("objectRef", "objectType"));
	ИнструментFindRefs.Вставить("inputSchema", СхемаFindRefs);
	Инструменты.Добавить(ИнструментFindRefs);

	// get_object_versions — список версий объекта (история изменений, подсистема "Версионирование объектов")
	ИнструментVersions = Новый Структура;
	ИнструментVersions.Вставить("name", "get_object_versions");
	ИнструментVersions.Вставить("description", "Возвращает историю версий объекта (подсистема ""Версионирование объектов""): номер версии, дата, автор, комментарий, тип. GUID получается из execute_query или find_catalog_items.");
	СхемаVersions = Новый Структура;
	СхемаVersions.Вставить("type", "object");
	СвойстваVersions = Новый Структура;
	СвойстваVersions.Вставить("objectType", Новый Структура("type,description", "string", "Тип объекта: Documents.ИмяДокумента, Catalogs.ИмяСправочника, ChartsOfCharacteristicTypes.Имя, BusinessProcesses.Имя, Tasks.Имя"));
	СвойстваVersions.Вставить("objectRef", Новый Структура("type,description", "string", "GUID объекта"));
	СвойстваVersions.Вставить("limit", Новый Структура("type,description", "number", "Сколько последних версий вернуть (по умолчанию 50). Список отсортирован от новых к старым."));
	СхемаVersions.Вставить("properties", СвойстваVersions);
	СхемаVersions.Вставить("required", AI_Utils.ПолучитьМассив("objectType", "objectRef"));
	ИнструментVersions.Вставить("inputSchema", СхемаVersions);
	Инструменты.Добавить(ИнструментVersions);

	// get_object_version — содержимое конкретной версии объекта
	ИнструментVersion = Новый Структура;
	ИнструментVersion.Вставить("name", "get_object_version");
	ИнструментVersion.Вставить("description", "Возвращает содержимое конкретной версии объекта: значения реквизитов и строки табличных частей на момент этой версии. Номер версии берётся из get_object_versions.");
	СхемаVersion = Новый Структура;
	СхемаVersion.Вставить("type", "object");
	СвойстваVersion = Новый Структура;
	СвойстваVersion.Вставить("objectType", Новый Структура("type,description", "string", "Тип объекта: Documents.ИмяДокумента, Catalogs.ИмяСправочника и т.п."));
	СвойстваVersion.Вставить("objectRef", Новый Структура("type,description", "string", "GUID объекта"));
	СвойстваVersion.Вставить("versionNumber", Новый Структура("type,description", "number", "Номер версии (из get_object_versions)"));
	СхемаVersion.Вставить("properties", СвойстваVersion);
	СхемаVersion.Вставить("required", AI_Utils.ПолучитьМассив("objectType", "objectRef", "versionNumber"));
	ИнструментVersion.Вставить("inputSchema", СхемаVersion);
	Инструменты.Добавить(ИнструментVersion);

	// diff_object_versions — сравнение двух версий (что изменилось)
	ИнструментDiff = Новый Структура;
	ИнструментDiff.Вставить("name", "diff_object_versions");
	ИнструментDiff.Вставить("description", "Сравнивает две версии объекта и показывает, что изменилось: изменённые реквизиты (было→стало) и изменения в табличных частях. versionTo опционально — по умолчанию сравнивается versionFrom с предыдущей версией.");
	СхемаDiff = Новый Структура;
	СхемаDiff.Вставить("type", "object");
	СвойстваDiff = Новый Структура;
	СвойстваDiff.Вставить("objectType", Новый Структура("type,description", "string", "Тип объекта: Documents.ИмяДокумента, Catalogs.ИмяСправочника и т.п."));
	СвойстваDiff.Вставить("objectRef", Новый Структура("type,description", "string", "GUID объекта"));
	СвойстваDiff.Вставить("versionFrom", Новый Структура("type,description", "number", "Номер версии-источника (более новая, если versionTo не задан)"));
	СвойстваDiff.Вставить("versionTo", Новый Структура("type,description", "number", "Номер версии для сравнения (опционально; по умолчанию versionFrom-1)"));
	СхемаDiff.Вставить("properties", СвойстваDiff);
	СхемаDiff.Вставить("required", AI_Utils.ПолучитьМассив("objectType", "objectRef", "versionFrom"));
	ИнструментDiff.Вставить("inputSchema", СхемаDiff);
	Инструменты.Добавить(ИнструментDiff);

	// get_access_rights
	ИнстрПрава = Новый Структура;
	ИнстрПрава.Вставить("name", "get_access_rights");
	ИнстрПрава.Вставить("description",
		"Права на объект метаданных: чтение/добавление/изменение/удаление (для документов ещё проведение/отмена). Без userName — права учётки HTTP-сервиса. Вызывай ДО попытки записи, чтобы не получать отказ посреди операции.");
	СхемаПрава = Новый Структура("type", "object");
	СвойстваПрава = Новый Структура;
	СвойстваПрава.Вставить("objectKind", Новый Структура("type,description", "string", "Вид: Справочники, Документы, РегистрыСведений, РегистрыНакопления, Отчеты, Обработки"));
	СвойстваПрава.Вставить("objectName", Новый Структура("type,description", "string", "Имя объекта (например Номенклатура)"));
	СвойстваПрава.Вставить("userName", Новый Структура("type,description", "string", "Имя пользователя ИБ (необязательно — без него текущая учётка сервиса)"));
	СхемаПрава.Вставить("properties", СвойстваПрава);
	СхемаПрава.Вставить("required", AI_Utils.ПолучитьМассив("objectKind", "objectName"));
	ИнстрПрава.Вставить("inputSchema", СхемаПрава);
	Инструменты.Добавить(ИнстрПрава);

	Возврат Инструменты;

КонецФункции

Функция ВыполнитьИнструмент(ИмяИнструмента, Параметры) Экспорт

	Если ИмяИнструмента = "list_metadata_objects" Тогда
		Возврат ПолучитьСписокОбъектовМетаданных(Параметры);
	ИначеЕсли ИмяИнструмента = "get_metadata_structure" Тогда
		Возврат ПолучитьСтруктуруМетаданных(Параметры);
	ИначеЕсли ИмяИнструмента = "get_event_log" Тогда
		Возврат ПолучитьЖурналРегистрации(Параметры);
	ИначеЕсли ИмяИнструмента = "find_references_to_object" Тогда
		Возврат НайтиСсылкиНаОбъект(Параметры);
	ИначеЕсли ИмяИнструмента = "get_object_versions" Тогда
		Возврат ПолучитьВерсииОбъекта(Параметры);
	ИначеЕсли ИмяИнструмента = "get_object_version" Тогда
		Возврат ПолучитьВерсиюОбъекта(Параметры);
	ИначеЕсли ИмяИнструмента = "diff_object_versions" Тогда
		Возврат СравнитьВерсииОбъекта(Параметры);
	ИначеЕсли ИмяИнструмента = "get_access_rights" Тогда
		Возврат ПолучитьПраваДоступа(Параметры);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", "Не реализован инструмент: " + ИмяИнструмента);
	Возврат Ответ;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСписокОбъектовМетаданных(Параметры)

	ТипОбъекта = "";
	Если Параметры.Свойство("object_type") Тогда
		ТипОбъекта = Параметры.object_type;
	КонецЕсли;

	Строки = Новый Массив;

	Если ТипОбъекта = "" ИЛИ ТипОбъекта = "Catalogs" Тогда
		Строки.Добавить("=== Справочники (" + Метаданные.Справочники.Количество() + ") ===");
		Для Каждого Объект Из Метаданные.Справочники Цикл
			Строки.Добавить("  " + Объект.Имя + " (" + Объект.Синоним + ")");
		КонецЦикла;
		Строки.Добавить("");
	КонецЕсли;

	Если ТипОбъекта = "" ИЛИ ТипОбъекта = "Documents" Тогда
		Строки.Добавить("=== Документы (" + Метаданные.Документы.Количество() + ") ===");
		Для Каждого Объект Из Метаданные.Документы Цикл
			Строки.Добавить("  " + Объект.Имя + " (" + Объект.Синоним + ")");
		КонецЦикла;
		Строки.Добавить("");
	КонецЕсли;

	Если ТипОбъекта = "" ИЛИ ТипОбъекта = "InformationRegisters" Тогда
		Строки.Добавить("=== Регистры сведений (" + Метаданные.РегистрыСведений.Количество() + ") ===");
		Для Каждого Объект Из Метаданные.РегистрыСведений Цикл
			Строки.Добавить("  " + Объект.Имя + " (" + Объект.Синоним + ")");
		КонецЦикла;
		Строки.Добавить("");
	КонецЕсли;

	Если ТипОбъекта = "" ИЛИ ТипОбъекта = "AccumulationRegisters" Тогда
		Строки.Добавить("=== Регистры накопления (" + Метаданные.РегистрыНакопления.Количество() + ") ===");
		Для Каждого Объект Из Метаданные.РегистрыНакопления Цикл
			Строки.Добавить("  " + Объект.Имя + " (" + Объект.Синоним + ")");
		КонецЦикла;
		Строки.Добавить("");
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
	Возврат Ответ;

КонецФункции

Функция ПолучитьСтруктуруМетаданных(Параметры)

	ПутьМетаданных = Параметры.metadataPath;

	ЧастиПути = СтрРазделить(ПутьМетаданных, ".", Ложь);
	Если ЧастиПути.Количество() < 2 Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Неверный формат пути. Ожидается ТипОбъектов.ИмяОбъекта, например: Catalogs.Номенклатура");
		Возврат Ответ;
	КонецЕсли;

	ТипОбъектов = ЧастиПути[0];
	ИмяОбъекта = ЧастиПути[1];

	МетаОбъект = Неопределено;
	Если ТипОбъектов = "Catalogs" ИЛИ ТипОбъектов = "Справочники" Тогда
		МетаОбъект = Метаданные.Справочники.Найти(ИмяОбъекта);
	ИначеЕсли ТипОбъектов = "Documents" ИЛИ ТипОбъектов = "Документы" Тогда
		МетаОбъект = Метаданные.Документы.Найти(ИмяОбъекта);
	ИначеЕсли ТипОбъектов = "InformationRegisters" ИЛИ ТипОбъектов = "РегистрыСведений" Тогда
		МетаОбъект = Метаданные.РегистрыСведений.Найти(ИмяОбъекта);
	ИначеЕсли ТипОбъектов = "AccumulationRegisters" ИЛИ ТипОбъектов = "РегистрыНакопления" Тогда
		МетаОбъект = Метаданные.РегистрыНакопления.Найти(ИмяОбъекта);
	ИначеЕсли ТипОбъектов = "ChartsOfCharacteristicTypes" ИЛИ ТипОбъектов = "ПланыВидовХарактеристик" Тогда
		МетаОбъект = Метаданные.ПланыВидовХарактеристик.Найти(ИмяОбъекта);
	КонецЕсли;

	Если МетаОбъект = Неопределено Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Объект метаданных не найден: " + ПутьМетаданных);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		Строки = Новый Массив;
		Строки.Добавить("Объект: " + ТипОбъектов + "." + ИмяОбъекта);
		Строки.Добавить("Синоним: " + МетаОбъект.Синоним);
		Строки.Добавить("");

		Строки.Добавить("=== Стандартные реквизиты ===");
		Для Каждого СтандРеквизит Из МетаОбъект.СтандартныеРеквизиты Цикл
			Строки.Добавить("  " + СтандРеквизит.Имя + " (" + СтандРеквизит.Синоним + "): " + Строка(СтандРеквизит.Тип));
		КонецЦикла;

		Если МетаОбъект.Реквизиты.Количество() > 0 Тогда
			Строки.Добавить("");
			Строки.Добавить("=== Реквизиты (" + МетаОбъект.Реквизиты.Количество() + ") ===");
			Для Каждого Реквизит Из МетаОбъект.Реквизиты Цикл
				Строки.Добавить("  " + Реквизит.Имя + " (" + Реквизит.Синоним + "): " + Строка(Реквизит.Тип));
			КонецЦикла;
		КонецЕсли;

		Если МетаОбъект.ТабличныеЧасти.Количество() > 0 Тогда
			Строки.Добавить("");
			Строки.Добавить("=== Табличные части (" + МетаОбъект.ТабличныеЧасти.Количество() + ") ===");
			Для Каждого ТабЧасть Из МетаОбъект.ТабличныеЧасти Цикл
				Строки.Добавить("  [" + ТабЧасть.Имя + "] " + ТабЧасть.Синоним + ":");
				Для Каждого Реквизит Из ТабЧасть.Реквизиты Цикл
					Строки.Добавить("    " + Реквизит.Имя + " (" + Реквизит.Синоним + "): " + Строка(Реквизит.Тип));
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;

		// Измерения и ресурсы для регистров
		Если ТипОбъектов = "InformationRegisters" ИЛИ ТипОбъектов = "РегистрыСведений"
			ИЛИ ТипОбъектов = "AccumulationRegisters" ИЛИ ТипОбъектов = "РегистрыНакопления" Тогда

			Если МетаОбъект.Измерения.Количество() > 0 Тогда
				Строки.Добавить("");
				Строки.Добавить("=== Измерения (" + МетаОбъект.Измерения.Количество() + ") ===");
				Для Каждого Измерение Из МетаОбъект.Измерения Цикл
					Строки.Добавить("  " + Измерение.Имя + " (" + Измерение.Синоним + "): " + Строка(Измерение.Тип));
				КонецЦикла;
			КонецЕсли;

			Если МетаОбъект.Ресурсы.Количество() > 0 Тогда
				Строки.Добавить("");
				Строки.Добавить("=== Ресурсы (" + МетаОбъект.Ресурсы.Количество() + ") ===");
				Для Каждого Ресурс Из МетаОбъект.Ресурсы Цикл
					Строки.Добавить("  " + Ресурс.Имя + " (" + Ресурс.Синоним + "): " + Строка(Ресурс.Тип));
				КонецЦикла;
			КонецЕсли;

		КонецЕсли;

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
		Возврат Ответ;

	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка получения структуры метаданных: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция ПолучитьЖурналРегистрации(Параметры)

	Уровень = "Error";
	Если Параметры.Свойство("level") И ЗначениеЗаполнено(Параметры.level) Тогда
		Уровень = Параметры.level;
	КонецЕсли;

	Лимит = 50;
	Если Параметры.Свойство("limit") И ЗначениеЗаполнено(Параметры.limit) Тогда
		Лимит = Параметры.limit;
	КонецЕсли;

	МассивУровней = Новый Массив;
	Если Уровень = "Error" Тогда
		МассивУровней.Добавить(УровеньЖурналаРегистрации.Ошибка);
	ИначеЕсли Уровень = "Warning" Тогда
		МассивУровней.Добавить(УровеньЖурналаРегистрации.Предупреждение);
	ИначеЕсли Уровень = "Information" Тогда
		МассивУровней.Добавить(УровеньЖурналаРегистрации.Информация);
	ИначеЕсли Уровень = "Note" Тогда
		МассивУровней.Добавить(УровеньЖурналаРегистрации.Примечание);
	Иначе
		МассивУровней.Добавить(УровеньЖурналаРегистрации.Ошибка);
	КонецЕсли;

	ОтборЖурнала = Новый Структура;
	ОтборЖурнала.Вставить("Уровень", МассивУровней);

	Если Параметры.Свойство("startDate") И ЗначениеЗаполнено(Параметры.startDate) Тогда
		ОтборЖурнала.Вставить("ДатаНачала", Дата(Параметры.startDate));
	КонецЕсли;

	Если Параметры.Свойство("endDate") И ЗначениеЗаполнено(Параметры.endDate) Тогда
		ОтборЖурнала.Вставить("ДатаОкончания", Дата(Параметры.endDate));
	КонецЕсли;

	Попытка
		ТаблицаЖурнала = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, ОтборЖурнала, Лимит);

		// Получаем имена колонок для диагностики и поиска колонки даты
		НазванияКолонок = Новый Массив;
		Для Каждого Колонка Из ТаблицаЖурнала.Колонки Цикл
			НазванияКолонок.Добавить(Колонка.Имя);
		КонецЦикла;

		КолонкаДаты = "";
		Для Каждого ИмяКол Из НазванияКолонок Цикл
			Если ИмяКол = "Дата" ИЛИ ИмяКол = "ДатаВремя" Тогда
				КолонкаДаты = ИмяКол;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Строки = Новый Массив;
		Строки.Добавить("Журнал регистрации [" + Уровень + "], записей: " + ТаблицаЖурнала.Количество());
		Строки.Добавить("Колонки: " + СтрСоединить(НазванияКолонок, ", "));
		Строки.Добавить("");

		Для Каждого Запись Из ТаблицаЖурнала Цикл
			ДатаЗначение = ?(КолонкаДаты <> "", Запись[КолонкаДаты], Неопределено);
			Строки.Добавить(
				?(ДатаЗначение <> Неопределено, Формат(ДатаЗначение, "ДФ=dd.MM.yyyy HH:mm:ss"), "[?]") +
				" | " + Строка(Запись.Уровень) +
				" | " + Запись.Пользователь +
				" | " + Запись.Событие +
				?(ЗначениеЗаполнено(Запись.Метаданные), " | " + Строка(Запись.Метаданные), "") +
				?(ЗначениеЗаполнено(Запись.Комментарий), Символы.ПС + "  Комментарий: " + Запись.Комментарий, "")
			);
		КонецЦикла;

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
		Возврат Ответ;

	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка чтения журнала: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция НайтиСсылкиНаОбъект(Параметры)

	СтрокаСсылки = Параметры.objectRef;
	ТипОбъекта = Параметры.objectType;

	ЧастиПути = СтрРазделить(ТипОбъекта, ".", Ложь);
	Если ЧастиПути.Количество() < 2 Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Неверный формат objectType. Ожидается: Catalogs.ИмяОбъекта или Documents.ИмяОбъекта");
		Возврат Ответ;
	КонецЕсли;

	ТипКоллекции = ЧастиПути[0];
	ИмяОбъекта = ЧастиПути[1];

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаСсылки);
		Ссылка = Неопределено;

		Если ТипКоллекции = "Catalogs" ИЛИ ТипКоллекции = "Справочники" Тогда
			Ссылка = Справочники[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "Documents" ИЛИ ТипКоллекции = "Документы" Тогда
			Ссылка = Документы[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "InformationRegisters" ИЛИ ТипКоллекции = "РегистрыСведений" Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Поиск ссылок для регистров не поддерживается");
			Возврат Ответ;
		Иначе
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Неподдерживаемый тип объекта: " + ТипКоллекции);
			Возврат Ответ;
		КонецЕсли;

		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Ссылка);

		// Маппинг: английский тип (searchIn) → префикс ПолноеИмя() на русском (нижний регистр)
		МапингТипов = Новый Соответствие;
		МапингТипов.Вставить("documents",             "документ");
		МапингТипов.Вставить("catalogs",              "справочник");
		МапингТипов.Вставить("informationregisters",  "регистрсведений");
		МапингТипов.Вставить("accumulationregisters", "регистрнакопления");

		// Строим набор prefixов полного имени метаданных в нижнем регистре для фильтрации
		МножествоФильтра = Новый Соответствие;
		Если Параметры.Свойство("searchIn") И ЗначениеЗаполнено(Параметры.searchIn) Тогда
			Для Каждого ПутьМета Из СтрРазделить(Параметры.searchIn, ",", Ложь) Цикл
				ЧастиМета = СтрРазделить(СокрЛП(ПутьМета), ".", Ложь);
				Если ЧастиМета.Количество() < 2 Тогда
					Продолжить;
				КонецЕсли;
				ТипЭнг = НРег(СокрЛП(ЧастиМета[0]));
				ИмяМета = НРег(СокрЛП(ЧастиМета[1]));
				ТипРус = МапингТипов.Получить(ТипЭнг);
				Если ТипРус = Неопределено Тогда
					ТипРус = ТипЭнг;
				КонецЕсли;
				МножествоФильтра.Вставить(ТипРус + "." + ИмяМета, Истина);
			КонецЦикла;
		КонецЕсли;

		Если МножествоФильтра.Количество() = 0 Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Укажите параметр searchIn для ограничения области поиска. Пример: ""Documents.ПоступлениеТоваровУслуг,Catalogs.Клиенты""");
			Возврат Ответ;
		КонецЕсли;

		// Примечание: НайтиПоСсылкам вызывается без 2-го параметра (массива метаданных).
		// Передача Массива объектов метаданных из extension-контекста вызывает
		// "Недопустимое значение параметра (параметр номер '2')" в 8.3.24.
		// Фильтрация по searchIn выполняется вручную по ПолноеИмя() результата.
		ВсеСсылки = НайтиПоСсылкам(МассивОбъектов);

		// Определяем имена колонок динамически (зависят от версии платформы)
		// Реальные колонки в 8.3.24: Ссылка, Данные, Метаданные, РазделениеДанных
		ИмяКолонкиМета = "";
		ИмяКолонкиСсылка = "";
		Для Каждого Колонка Из ВсеСсылки.Колонки Цикл
			КолНижний = НРег(Колонка.Имя);
			Если КолНижний = "метаданныеобъекта" Или КолНижний = "метаданные" Тогда
				ИмяКолонкиМета = Колонка.Имя;
			ИначеЕсли КолНижний = "ссылка" Или КолНижний = "object" Тогда
				ИмяКолонкиСсылка = Колонка.Имя;
			КонецЕсли;
		КонецЦикла;
		Если ИмяКолонкиМета = "" Тогда
			// Диагностика: вернём список колонок
			КолонкиСписок = Новый Массив;
			Для Каждого Колонка Из ВсеСсылки.Колонки Цикл
				КолонкиСписок.Добавить(Колонка.Имя);
			КонецЦикла;
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Неизвестная структура таблицы НайтиПоСсылкам. Колонки: " + СтрСоединить(КолонкиСписок, ", "));
			Возврат Ответ;
		КонецЕсли;
		Если ИмяКолонкиСсылка = "" И ВсеСсылки.Колонки.Количество() >= 2 Тогда
			ИмяКолонкиСсылка = ВсеСсылки.Колонки[1].Имя;
		КонецЕсли;

		Строки = Новый Массив;
		Строки.Добавить("Ссылки на объект: " + ТипОбъекта + " / " + СтрокаСсылки);
		НайденоОтфильтровано = 0;

		Для Каждого СтрокаПоиска Из ВсеСсылки Цикл
			МетаОбъект = СтрокаПоиска[ИмяКолонкиМета];
			Если ТипЗнч(МетаОбъект) = Тип("Строка") Тогда
				ПолноеИмяМета = НРег(МетаОбъект);
			Иначе
				ПолноеИмяМета = НРег(МетаОбъект.ПолноеИмя());
			КонецЕсли;
			ПодходитФильтру = Ложь;
			Для Каждого КлючФильтра Из МножествоФильтра Цикл
				Если СтрНачинаетсяС(ПолноеИмяМета, КлючФильтра.Ключ) Тогда
					ПодходитФильтру = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ПодходитФильтру Тогда
				НайденоОтфильтровано = НайденоОтфильтровано + 1;
				Строки.Добавить(
					Строка(МетаОбъект) +
					" | " + Строка(СтрокаПоиска[ИмяКолонкиСсылка])
				);
			КонецЕсли;
		КонецЦикла;

		Строки.Вставить(1, "Найдено ссылок: " + НайденоОтфильтровано);
		Строки.Вставить(2, "");

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
		Возврат Ответ;

	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка поиска ссылок: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция ПолучитьПраваДоступа(Параметры)

	Ответ = Новый Структура;
	Попытка
		ВидОбъекта = Параметры.objectKind;
		ИмяОбъекта = Параметры.objectName;

		МетаКоллекция = Неопределено;
		Если ВидОбъекта = "Справочники" ИЛИ ВидОбъекта = "Catalogs" Тогда
			МетаКоллекция = Метаданные.Справочники;
		ИначеЕсли ВидОбъекта = "Документы" ИЛИ ВидОбъекта = "Documents" Тогда
			МетаКоллекция = Метаданные.Документы;
		ИначеЕсли ВидОбъекта = "РегистрыСведений" ИЛИ ВидОбъекта = "InformationRegisters" Тогда
			МетаКоллекция = Метаданные.РегистрыСведений;
		ИначеЕсли ВидОбъекта = "РегистрыНакопления" ИЛИ ВидОбъекта = "AccumulationRegisters" Тогда
			МетаКоллекция = Метаданные.РегистрыНакопления;
		ИначеЕсли ВидОбъекта = "Отчеты" ИЛИ ВидОбъекта = "Reports" Тогда
			МетаКоллекция = Метаданные.Отчеты;
		ИначеЕсли ВидОбъекта = "Обработки" ИЛИ ВидОбъекта = "DataProcessors" Тогда
			МетаКоллекция = Метаданные.Обработки;
		Иначе
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Неподдерживаемый вид: " + ВидОбъекта
				+ ". Допустимо: Справочники, Документы, РегистрыСведений, РегистрыНакопления, Отчеты, Обработки");
			Возврат Ответ;
		КонецЕсли;

		МетаОбъект = МетаКоллекция.Найти(ИмяОбъекта);
		Если МетаОбъект = Неопределено Тогда
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Объект не найден: " + ВидОбъекта + "." + ИмяОбъекта);
			Возврат Ответ;
		КонецЕсли;

		ПользовательИБ = Неопределено;
		ИмяПользователя = "<текущая учётка сервиса>";
		Если Параметры.Свойство("userName") И НЕ ПустаяСтрока(Параметры.userName) Тогда
			ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Параметры.userName);
			Если ПользовательИБ = Неопределено Тогда
				Ответ.Вставить("success", Ложь);
				Ответ.Вставить("error", "Пользователь не найден: " + Параметры.userName);
				Возврат Ответ;
			КонецЕсли;
			ИмяПользователя = ПользовательИБ.Имя;
		КонецЕсли;

		ИменаПрав = Новый Массив;
		ИменаПрав.Добавить("Чтение");
		ИменаПрав.Добавить("Добавление");
		ИменаПрав.Добавить("Изменение");
		ИменаПрав.Добавить("Удаление");
		Если МетаКоллекция = Метаданные.Документы Тогда
			ИменаПрав.Добавить("Проведение");
			ИменаПрав.Добавить("ОтменаПроведения");
		КонецЕсли;

		Права = Новый Структура;
		Для Каждого ИмяПрава Из ИменаПрав Цикл
			Если ПользовательИБ = Неопределено Тогда
				Права.Вставить(ИмяПрава, ПравоДоступа(ИмяПрава, МетаОбъект));
			Иначе
				Права.Вставить(ИмяПрава, ПравоДоступа(ИмяПрава, МетаОбъект, ПользовательИБ));
			КонецЕсли;
		КонецЦикла;

		Данные = Новый Структура;
		Данные.Вставить("object", ВидОбъекта + "." + ИмяОбъекта);
		Данные.Вставить("user", ИмяПользователя);
		Данные.Вставить("rights", Права);
		Данные.Вставить("readOnlyMode", AI_Security.РежимТолькоЧтение());

		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", Данные);

	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка получения прав: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Ответ;

КонецФункции

// Возвращает ссылку на объект по типу (Documents.Имя / Catalogs.Имя / ...) и GUID.
// Ошибка (Строка) заполняется при некорректных параметрах; при успехе пустая.
Функция ПолучитьСсылкуОбъектаПоТипу(ТипОбъекта, СтрокаСсылки, Ошибка)

	Ошибка = "";
	ЧастиПути = СтрРазделить(ТипОбъекта, ".", Ложь);
	Если ЧастиПути.Количество() < 2 Тогда
		Ошибка = "Неверный формат objectType. Ожидается: Documents.ИмяОбъекта, Catalogs.ИмяОбъекта и т.п.";
		Возврат Неопределено;
	КонецЕсли;

	ТипКоллекции = ЧастиПути[0];
	ИмяОбъекта = ЧастиПути[1];

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаСсылки);
	Исключение
		Ошибка = "Некорректный GUID объекта: " + СтрокаСсылки;
		Возврат Неопределено;
	КонецПопытки;

	Попытка
		Если ТипКоллекции = "Catalogs" ИЛИ ТипКоллекции = "Справочники" Тогда
			Возврат Справочники[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "Documents" ИЛИ ТипКоллекции = "Документы" Тогда
			Возврат Документы[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "ChartsOfCharacteristicTypes" ИЛИ ТипКоллекции = "ПланыВидовХарактеристик" Тогда
			Возврат ПланыВидовХарактеристик[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "BusinessProcesses" ИЛИ ТипКоллекции = "БизнесПроцессы" Тогда
			Возврат БизнесПроцессы[ИмяОбъекта].ПолучитьСсылку(УИД);
		ИначеЕсли ТипКоллекции = "Tasks" ИЛИ ТипКоллекции = "Задачи" Тогда
			Возврат Задачи[ИмяОбъекта].ПолучитьСсылку(УИД);
		Иначе
			Ошибка = "Неподдерживаемый тип объекта для версионирования: " + ТипКоллекции;
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Ошибка = "Не удалось получить ссылку (" + ТипОбъекта + "): " + ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Возвращает общий модуль "ВерсионированиеОбъектов" через позднее связывание
// (Вычислить), либо Неопределено с заполнением Ошибки, если подсистемы версионирования
// в конфигурации нет. Так модуль AI_Metadata компилируется в любой конфигурации,
// а инструменты версий корректно отключаются там, где БСП-версионирования нет.
Функция МодульВерсионирования(Ошибка)

	Ошибка = "";
	Если Метаданные.РегистрыСведений.Найти("ВерсииОбъектов") = Неопределено
		ИЛИ Метаданные.ОбщиеМодули.Найти("ВерсионированиеОбъектов") = Неопределено Тогда
		Ошибка = "В этой конфигурации нет подсистемы версионирования объектов (БСП) — инструменты истории версий недоступны.";
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Вычислить("ВерсионированиеОбъектов");
	Исключение
		Ошибка = "Не удалось получить модуль версионирования: " + ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Возвращает историю версий объекта из РС.ВерсииОбъектов.
Функция ПолучитьВерсииОбъекта(Параметры)

	Ошибка = "";
	Ссылка = ПолучитьСсылкуОбъектаПоТипу(Параметры.objectType, Параметры.objectRef, Ошибка);
	Если Ссылка = Неопределено Тогда
		Возврат ОтветОшибки(Ошибка);
	КонецЕсли;

	Если МодульВерсионирования(Ошибка) = Неопределено Тогда
		Возврат ОтветОшибки(Ошибка);
	КонецЕсли;

	Лимит = 50;
	Если Параметры.Свойство("limit") И ЗначениеЗаполнено(Параметры.limit) Тогда
		Лимит = Число(Параметры.limit);
	КонецЕсли;

	Попытка
		УстановитьПривилегированныйРежим(Истина);

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
		|	ВерсииОбъектов.НомерВерсии КАК НомерВерсии,
		|	ВерсииОбъектов.ДатаВерсии КАК ДатаВерсии,
		|	ВерсииОбъектов.АвторВерсии КАК АвторВерсии,
		|	ВерсииОбъектов.Комментарий КАК Комментарий,
		|	ВерсииОбъектов.ТипВерсииОбъекта КАК ТипВерсииОбъекта
		|ИЗ
		|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
		|ГДЕ
		|	ВерсииОбъектов.Объект = &Объект
		|УПОРЯДОЧИТЬ ПО
		|	НомерВерсии УБЫВ";
		Запрос.УстановитьПараметр("Объект", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();

		Строки = Новый Массив;
		Строки.Добавить("Версии объекта: " + Строка(Ссылка) + " (" + Параметры.objectType + ")");
		Строки.Добавить("(показаны последние " + Формат(Лимит, "ЧГ=0") + ", от новых к старым)");
		Количество = 0;
		Пока Выборка.Следующий() Цикл
			Количество = Количество + 1;
			Строки.Добавить(
				"v" + Формат(Выборка.НомерВерсии, "ЧГ=0")
				+ " | " + Формат(Выборка.ДатаВерсии, "ДФ=dd.MM.yyyy HH:mm:ss")
				+ " | " + СокрЛП(Строка(Выборка.АвторВерсии))
				+ " | " + Строка(Выборка.ТипВерсииОбъекта)
				+ ?(ЗначениеЗаполнено(Выборка.Комментарий), " | " + Выборка.Комментарий, "")
			);
		КонецЦикла;

		Если Количество = 0 Тогда
			Строки.Добавить("Версии не найдены (объект не версионируется, версий ещё нет или неверный GUID/тип).");
		Иначе
			Строки.Вставить(1, "Найдено версий: " + Количество);
		КонецЕсли;

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
		Возврат Ответ;

	Исключение
		Возврат ОтветОшибки("Ошибка получения версий: " + ОписаниеОшибки());
	КонецПопытки;

КонецФункции

// Возвращает содержимое конкретной версии объекта (реквизиты + табличные части).
Функция ПолучитьВерсиюОбъекта(Параметры)

	Ошибка = "";
	Ссылка = ПолучитьСсылкуОбъектаПоТипу(Параметры.objectType, Параметры.objectRef, Ошибка);
	Если Ссылка = Неопределено Тогда
		Возврат ОтветОшибки(Ошибка);
	КонецЕсли;

	МодульВерс = МодульВерсионирования(Ошибка);
	Если МодульВерс = Неопределено Тогда
		Возврат ОтветОшибки(Ошибка);
	КонецЕсли;

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		НомерВерсии = Число(Параметры.versionNumber);
		Разбор = МодульВерс.РазборВерсии(Ссылка, НомерВерсии);

		Строки = Новый Массив;
		Строки.Добавить("Объект: " + Разбор.ИмяОбъекта + " (" + Параметры.objectType + ")");
		Строки.Добавить("Версия: v" + Формат(НомерВерсии, "ЧГ=0")
			+ " | " + РазборНовая_Дата(Разбор)
			+ " | " + Разбор.АвторИзменения);
		Если ЗначениеЗаполнено(Разбор.Комментарий) Тогда
			Строки.Добавить("Комментарий: " + Разбор.Комментарий);
		КонецЕсли;

		Строки.Добавить("");
		Строки.Добавить("=== Реквизиты ===");
		Для Каждого СтрокаРекв Из РазбСортированныеРеквизиты(Разбор.Реквизиты) Цикл
			Строки.Добавить("  " + СтрокаРекв.НаименованиеРеквизита + " = " + ЗначениеВСтроку(СтрокаРекв.ЗначениеРеквизита));
		КонецЦикла;

		Для Каждого ЭлементТЧ Из Разбор.ТабличныеЧасти Цикл
			ИмяТЧ = ЭлементТЧ.Ключ;
			Таблица = ЭлементТЧ.Значение;
			Строки.Добавить("");
			Строки.Добавить("=== ТЧ [" + ИмяТЧ + "], строк: " + Таблица.Количество() + " ===");
			ИменаКолонок = Новый Массив;
			Для Каждого Колонка Из Таблица.Колонки Цикл
				ИменаКолонок.Добавить(Колонка.Имя);
			КонецЦикла;
			Строки.Добавить("  колонки: " + СтрСоединить(ИменаКолонок, ", "));
			НомерСтроки = 0;
			Для Каждого СтрокаТаблицы Из Таблица Цикл
				НомерСтроки = НомерСтроки + 1;
				ЗначенияСтроки = Новый Массив;
				Для Каждого ИмяКол Из ИменаКолонок Цикл
					ЗначенияСтроки.Добавить(ИмяКол + "=" + ЗначениеВСтроку(СтрокаТаблицы[ИмяКол]));
				КонецЦикла;
				Строки.Добавить("  [" + НомерСтроки + "] " + СтрСоединить(ЗначенияСтроки, "; "));
			КонецЦикла;
		КонецЦикла;

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
		Возврат Ответ;

	Исключение
		Возврат ОтветОшибки("Ошибка получения версии: " + ОписаниеОшибки());
	КонецПопытки;

КонецФункции

// Сравнивает две версии объекта и возвращает список изменений (реквизиты + ТЧ).
Функция СравнитьВерсииОбъекта(Параметры)

	Ошибка = "";
	Ссылка = ПолучитьСсылкуОбъектаПоТипу(Параметры.objectType, Параметры.objectRef, Ошибка);
	Если Ссылка = Неопределено Тогда
		Возврат ОтветОшибки(Ошибка);
	КонецЕсли;

	МодульВерс = МодульВерсионирования(Ошибка);
	Если МодульВерс = Неопределено Тогда
		Возврат ОтветОшибки(Ошибка);
	КонецЕсли;

	Попытка
		УстановитьПривилегированныйРежим(Истина);

		ВерсияОт = Число(Параметры.versionFrom);
		Если Параметры.Свойство("versionTo") И ЗначениеЗаполнено(Параметры.versionTo) Тогда
			ВерсияДо = Число(Параметры.versionTo);
		Иначе
			ВерсияДо = ВерсияОт - 1;
		КонецЕсли;

		Если ВерсияДо < 1 Тогда
			Возврат ОтветОшибки("Нет предыдущей версии для сравнения (versionTo < 1). Укажите versionTo явно.");
		КонецЕсли;

		// Приводим к порядку "старая → новая" для читаемого вывода (было → стало).
		НомерСтарая = Мин(ВерсияОт, ВерсияДо);
		НомерНовая = Макс(ВерсияОт, ВерсияДо);

		РазборСтарая = МодульВерс.РазборВерсии(Ссылка, НомерСтарая);
		РазборНовая = МодульВерс.РазборВерсии(Ссылка, НомерНовая);

		Строки = Новый Массив;
		Строки.Добавить("Сравнение версий объекта: " + Строка(Ссылка) + " (" + Параметры.objectType + ")");
		Строки.Добавить("v" + Формат(НомерСтарая, "ЧГ=0") + " (" + РазборНовая_Дата(РазборСтарая) + ")"
			+ "  →  v" + Формат(НомерНовая, "ЧГ=0") + " (" + РазборНовая_Дата(РазборНовая) + ")");
		Строки.Добавить("");

		// --- Реквизиты ---
		РеквСтарая = РеквизитыВСоответствие(РазборСтарая.Реквизиты);
		РеквНовая = РеквизитыВСоответствие(РазборНовая.Реквизиты);
		ВсеИмена = ОбъединитьКлючи(РеквСтарая, РеквНовая);

		ИзмененияРекв = Новый Массив;
		Для Каждого Имя Из ВсеИмена Цикл
			СтароеЗ = ?(РеквСтарая.Получить(Имя) = Неопределено, "<нет>", РеквСтарая.Получить(Имя));
			НовоеЗ = ?(РеквНовая.Получить(Имя) = Неопределено, "<нет>", РеквНовая.Получить(Имя));
			Если СтароеЗ <> НовоеЗ Тогда
				ИзмененияРекв.Добавить("  " + Имя + ": " + СтароеЗ + "  →  " + НовоеЗ);
			КонецЕсли;
		КонецЦикла;

		Строки.Добавить("=== Изменённые реквизиты (" + ИзмененияРекв.Количество() + ") ===");
		Если ИзмененияРекв.Количество() = 0 Тогда
			Строки.Добавить("  (нет изменений)");
		Иначе
			Для Каждого СтрокаИзм Из ИзмененияРекв Цикл
				Строки.Добавить(СтрокаИзм);
			КонецЦикла;
		КонецЕсли;

		// --- Табличные части ---
		Строки.Добавить("");
		Строки.Добавить("=== Изменения в табличных частях ===");
		ИменаТЧ = ОбъединитьКлючиСоответствий(РазборСтарая.ТабличныеЧасти, РазборНовая.ТабличныеЧасти);
		ЕстьИзмененияТЧ = Ложь;
		Для Каждого ИмяТЧ Из ИменаТЧ Цикл
			ТаблСтарая = РазборСтарая.ТабличныеЧасти.Получить(ИмяТЧ);
			ТаблНовая = РазборНовая.ТабличныеЧасти.Получить(ИмяТЧ);
			КолвоСтарая = ?(ТаблСтарая = Неопределено, 0, ТаблСтарая.Количество());
			КолвоНовая = ?(ТаблНовая = Неопределено, 0, ТаблНовая.Количество());

			ОписаниеИзмТЧ = СравнитьТабличнуюЧасть(ТаблСтарая, ТаблНовая);
			Если КолвоСтарая <> КолвоНовая ИЛИ ОписаниеИзмТЧ.Количество() > 0 Тогда
				ЕстьИзмененияТЧ = Истина;
				Строки.Добавить("  [" + ИмяТЧ + "] строк: " + КолвоСтарая + " → " + КолвоНовая);
				Для Каждого СтрокаИзм Из ОписаниеИзмТЧ Цикл
					Строки.Добавить("      " + СтрокаИзм);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЕстьИзмененияТЧ Тогда
			Строки.Добавить("  (нет изменений)");
		КонецЕсли;

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("data", СтрСоединить(Строки, Символы.ПС));
		Возврат Ответ;

	Исключение
		Возврат ОтветОшибки("Ошибка сравнения версий: " + ОписаниеОшибки());
	КонецПопытки;

КонецФункции

// Построчное сравнение двух версий одной табличной части (по индексу строки).
Функция СравнитьТабличнуюЧасть(ТаблСтарая, ТаблНовая)

	Результат = Новый Массив;
	КолвоСтарая = ?(ТаблСтарая = Неопределено, 0, ТаблСтарая.Количество());
	КолвоНовая = ?(ТаблНовая = Неопределено, 0, ТаблНовая.Количество());
	МаксСтрок = Макс(КолвоСтарая, КолвоНовая);

	Для Индекс = 0 По МаксСтрок - 1 Цикл
		Если Индекс >= КолвоСтарая Тогда
			Результат.Добавить("+ строка [" + (Индекс + 1) + "]: " + СтрокаТЧВСтроку(ТаблНовая, Индекс));
		ИначеЕсли Индекс >= КолвоНовая Тогда
			Результат.Добавить("- строка [" + (Индекс + 1) + "]: " + СтрокаТЧВСтроку(ТаблСтарая, Индекс));
		Иначе
			РазличияЯчеек = РазличияСтрокТЧ(ТаблСтарая[Индекс], ТаблНовая[Индекс], ТаблСтарая, ТаблНовая);
			Если РазличияЯчеек <> "" Тогда
				Результат.Добавить("~ строка [" + (Индекс + 1) + "]: " + РазличияЯчеек);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает строку различий ячеек двух строк ТЧ (по объединению колонок).
Функция РазличияСтрокТЧ(СтрокаСтарая, СтрокаНовая, ТаблСтарая, ТаблНовая)

	Колонки = Новый Массив;
	Для Каждого Колонка Из ТаблСтарая.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	Для Каждого Колонка Из ТаблНовая.Колонки Цикл
		Если Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			Колонки.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;

	Различия = Новый Массив;
	Для Каждого ИмяКол Из Колонки Цикл
		СтароеЗ = ЗначениеЯчейкиТЧ(СтрокаСтарая, ТаблСтарая, ИмяКол);
		НовоеЗ = ЗначениеЯчейкиТЧ(СтрокаНовая, ТаблНовая, ИмяКол);
		Если СтароеЗ <> НовоеЗ Тогда
			Различия.Добавить(ИмяКол + ": " + СтароеЗ + " → " + НовоеЗ);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Различия, "; ");

КонецФункции

// Безопасно читает значение ячейки ТЧ по имени колонки (колонки может не быть в этой версии).
Функция ЗначениеЯчейкиТЧ(СтрокаТаблицы, Таблица, ИмяКолонки)
	Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Возврат "<нет>";
	КонецЕсли;
	Возврат ЗначениеВСтроку(СтрокаТаблицы[ИмяКолонки]);
КонецФункции

// Представление строки ТЧ целиком (для добавленных/удалённых строк).
Функция СтрокаТЧВСтроку(Таблица, Индекс)
	СтрокаТаблицы = Таблица[Индекс];
	Значения = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Значения.Добавить(Колонка.Имя + "=" + ЗначениеВСтроку(СтрокаТаблицы[Колонка.Имя]));
	КонецЦикла;
	Возврат СтрСоединить(Значения, "; ");
КонецФункции

// Преобразует ТЗ реквизитов версии в Соответствие ИмяРеквизита → представление значения.
Функция РеквизитыВСоответствие(ТаблицаРеквизитов)
	Результат = Новый Соответствие;
	Для Каждого СтрокаРекв Из ТаблицаРеквизитов Цикл
		Результат.Вставить(СтрокаРекв.НаименованиеРеквизита, ЗначениеВСтроку(СтрокаРекв.ЗначениеРеквизита));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает отсортированный по имени массив строк ТЗ реквизитов.
Функция РазбСортированныеРеквизиты(ТаблицаРеквизитов)
	Копия = ТаблицаРеквизитов.Скопировать();
	Копия.Сортировать("НаименованиеРеквизита");
	Возврат Копия;
КонецФункции

// Объединение ключей двух Соответствий в массив (уникальные).
Функция ОбъединитьКлючи(Соответствие1, Соответствие2)
	Результат = Новый Массив;
	Для Каждого КлючЗначение Из Соответствие1 Цикл
		Результат.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Для Каждого КлючЗначение Из Соответствие2 Цикл
		Если Результат.Найти(КлючЗначение.Ключ) = Неопределено Тогда
			Результат.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Объединение ключей двух Соответствий табличных частей.
Функция ОбъединитьКлючиСоответствий(Соответствие1, Соответствие2)
	Возврат ОбъединитьКлючи(Соответствие1, Соответствие2);
КонецФункции

// Дата версии из результата РазборВерсии в виде строки.
Функция РазборНовая_Дата(Разбор)
	Возврат Формат(Разбор.ДатаИзменения, "ДФ=dd.MM.yyyy HH:mm:ss");
КонецФункции

// Универсальное представление значения реквизита/ячейки в строку.
Функция ЗначениеВСтроку(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

// Формирует ответ об ошибке инструмента.
Функция ОтветОшибки(ТекстОшибки)
	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", ТекстОшибки);
	Возврат Ответ;
КонецФункции

#КонецОбласти
