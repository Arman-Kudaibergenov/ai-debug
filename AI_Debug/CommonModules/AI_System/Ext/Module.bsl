// AI_System — tools for object deletion and unit test execution

Функция ОписаниеИнструментов() Экспорт

	Инструменты = Новый Массив;

	// delete_object
	ИнстрDelete = Новый Структура;
	ИнстрDelete.Вставить("name", "delete_object");
	ИнстрDelete.Вставить("description", "Помечает объект на удаление (cleanup после теста). Работает со справочниками и документами. GUID получается из create_catalog_item, create_document или execute_query.");
	СхемаDelete = Новый Структура("type", "object");
	СвойстваDelete = Новый Структура;
	СвойстваDelete.Вставить("objectType", Новый Структура("type,description", "string", "Тип объекта: Catalogs или Documents"));
	СвойстваDelete.Вставить("objectName", Новый Структура("type,description", "string", "Имя объекта (например Номенклатура или ПоступлениеТоваровУслуг)"));
	СвойстваDelete.Вставить("objectRef", Новый Структура("type,description", "string", "GUID объекта"));
	СхемаDelete.Вставить("properties", СвойстваDelete);
	СхемаDelete.Вставить("required", AI_Utils.ПолучитьМассив("objectType", "objectName", "objectRef"));
	ИнстрDelete.Вставить("inputSchema", СхемаDelete);
	Инструменты.Добавить(ИнстрDelete);

	// run_unit_tests
	ИнстрTests = Новый Структура;
	ИнстрTests.Вставить("name", "run_unit_tests");
	ИнстрTests.Вставить("description", "Запускает YAXUnit-совместимые тесты из модулей с суффиксом _Test. Без параметров — запускает все тест-модули. Возвращает результат: passed/failed по каждому тесту.");
	СхемаTests = Новый Структура("type", "object");
	СвойстваTests = Новый Структура;
	СвойстваTests.Вставить("moduleName", Новый Структура("type,description", "string", "Имя конкретного тест-модуля (например МойТест_Test). Без параметра — все *_Test модули."));
	СхемаTests.Вставить("properties", СвойстваTests);
	СхемаTests.Вставить("required", Новый Массив);
	ИнстрTests.Вставить("inputSchema", СхемаTests);
	Инструменты.Добавить(ИнстрTests);

	Возврат Инструменты;

КонецФункции

Функция ВыполнитьИнструмент(ИмяИнструмента, Параметры) Экспорт

	Если ИмяИнструмента = "delete_object" Тогда
		Возврат УдалитьОбъект(Параметры);
	ИначеЕсли ИмяИнструмента = "run_unit_tests" Тогда
		Возврат ЗапуститьТесты(Параметры);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", "Не реализован инструмент: " + ИмяИнструмента);
	Возврат Ответ;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция УдалитьОбъект(Параметры)

	ТипОбъекта = Параметры.objectType;
	ИмяОбъекта = Параметры.objectName;
	СтрокаСсылки = "";
	Если Параметры.Свойство("objectRef") Тогда
		СтрокаСсылки = Параметры.objectRef;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СтрокаСсылки) Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Не указан objectRef");
		Возврат Ответ;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаСсылки);
		Объект = Неопределено;

		Если ТипОбъекта = "Catalogs" Тогда
			Ссылка = Справочники[ИмяОбъекта].ПолучитьСсылку(УИД);
			Объект = Ссылка.ПолучитьОбъект();
		ИначеЕсли ТипОбъекта = "Documents" Тогда
			Ссылка = Документы[ИмяОбъекта].ПолучитьСсылку(УИД);
			Объект = Ссылка.ПолучитьОбъект();
		Иначе
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Неподдерживаемый тип: " + ТипОбъекта + ". Используй Catalogs или Documents");
			Возврат Ответ;
		КонецЕсли;

		Если Объект = Неопределено Тогда
			Ответ = Новый Структура;
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Объект не найден: " + СтрокаСсылки);
			Возврат Ответ;
		КонецЕсли;

		Объект.УстановитьПометкуУдаления(Истина);

		Ответ = Новый Структура;
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("message", "Объект " + ТипОбъекта + "." + ИмяОбъекта + " помечен на удаление");
		Возврат Ответ;
	Исключение
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Ошибка удаления объекта: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция ЗапуститьТесты(Параметры)

	ФильтрМодуля = "";
	Если Параметры.Свойство("moduleName") Тогда
		ФильтрМодуля = Параметры.moduleName;
	КонецЕсли;

	// Найти тест-модули с суффиксом _Test
	МодулиТестов = Новый Массив;
	Для Каждого ОбщМодуль Из Метаданные.ОбщиеМодули Цикл
		ИмяМодуля = ОбщМодуль.Имя;
		Если СтрЗаканчиваетсяНа(ИмяМодуля, "_Test") Тогда
			Если ФильтрМодуля = "" ИЛИ ИмяМодуля = ФильтрМодуля Тогда
				МодулиТестов.Добавить(ИмяМодуля);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если МодулиТестов.Количество() = 0 Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("success", Ложь);
		Если ФильтрМодуля <> "" Тогда
			Ответ.Вставить("error", "Тест-модуль не найден: " + ФильтрМодуля + ". Имя должно заканчиваться на _Test");
		Иначе
			Ответ.Вставить("error", "Тест-модули не найдены. Создайте CommonModule с именем вида МойТест_Test");
		КонецЕсли;
		Возврат Ответ;
	КонецЕсли;

	ВсегоТестов = 0;
	УспешноТестов = 0;
	Результаты = Новый Массив;

	Для Каждого ИмяМод Из МодулиТестов Цикл

		ТестыМодуля = Неопределено;
		Попытка
			Выполнить("ТестыМодуля = " + ИмяМод + ".ИсполняемыеСценарии()");
		Исключение
			РезМодуля = Новый Структура;
			РезМодуля.Вставить("module", ИмяМод);
			РезМодуля.Вставить("status", "error");
			РезМодуля.Вставить("error", "Ошибка в ИсполняемыеСценарии: " + ОписаниеОшибки());
			Результаты.Добавить(РезМодуля);
			Продолжить;
		КонецПопытки;

		Если ТестыМодуля = Неопределено Тогда
			ТестыМодуля = Новый Массив;
		КонецЕсли;

		Для Каждого ИмяТеста Из ТестыМодуля Цикл
			ВсегоТестов = ВсегоТестов + 1;

			РезТеста = Новый Структура;
			РезТеста.Вставить("module", ИмяМод);
			РезТеста.Вставить("test", ИмяТеста);

			Попытка
				Выполнить(ИмяМод + "." + ИмяТеста + "()");
				РезТеста.Вставить("status", "passed");
				УспешноТестов = УспешноТестов + 1;
			Исключение
				РезТеста.Вставить("status", "failed");
				РезТеста.Вставить("error", ОписаниеОшибки());
			КонецПопытки;

			Результаты.Добавить(РезТеста);
		КонецЦикла;

	КонецЦикла;

	// Формируем читаемый отчёт
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Тестов: %1 | Успешно: %2 | Провалено: %3",
		Формат(ВсегоТестов, "ЧГ="),
		Формат(УспешноТестов, "ЧГ="),
		Формат(ВсегоТестов - УспешноТестов, "ЧГ=")));
	Строки.Добавить("");

	Для Каждого Рез Из Результаты Цикл
		Если Рез.Свойство("error") И НЕ Рез.Свойство("test") Тогда
			// Ошибка на уровне модуля
			Строки.Добавить("[ERROR] " + Рез.module + " → " + Рез.error);
		ИначеЕсли Рез.status = "passed" Тогда
			Строки.Добавить("[OK]   " + Рез.module + "." + Рез.test);
		Иначе
			Строки.Добавить("[FAIL] " + Рез.module + "." + Рез.test);
			Строки.Добавить("       " + Рез.error);
		КонецЕсли;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("total", ВсегоТестов);
	Ответ.Вставить("passed", УспешноТестов);
	Ответ.Вставить("failed", ВсегоТестов - УспешноТестов);
	Ответ.Вставить("summary", СтрСоединить(Строки, Символы.ПС));
	Возврат Ответ;

КонецФункции

#КонецОбласти
